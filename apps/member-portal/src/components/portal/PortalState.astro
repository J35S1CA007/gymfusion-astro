---
type PortalLink = { href: string; label: string };
const { heading, body, links = [] } = Astro.props as { heading: string; body: string; links?: PortalLink[] };
---
<section class="rounded-2xl border border-black/10 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="portal-state-heading">
  <h2 id="portal-state-heading" class="font-heading text-2xl font-bold tracking-tight">{heading}</h2>
  <p class="mt-3 max-w-2xl text-base leading-7 text-black/65">{body}</p>
  {links.length ? <div class="mt-6 flex flex-wrap gap-3">{links.map((link) => <a class="rounded-md border border-black/20 px-4 py-2 font-semibold transition-colors hover:bg-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black" href={link.href}>{link.label}</a>)}</div> : null}
</section>
