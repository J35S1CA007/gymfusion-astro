---
import PortalLayout from "../layouts/PortalLayout.astro";
import PortalShell from "../components/portal/PortalShell";
import { loadPortalPage } from "../lib/portal-page";
import { sectionCopy } from "../lib/portal";
import "../styles/global.css";
const session = await loadPortalPage(Astro.request);
if (session.kind === "redirect") return new Response(null, { status: 303, headers: { Location: "/login", "Cache-Control": "no-store" } });
if (session.kind === "unavailable") Astro.response.status = 503;
const copy = sectionCopy.account;
const verified = Astro.url.searchParams.get("email") === "verified";
---
{session.kind === "authenticated" ? <PortalLayout title={copy.title} description="Manage your login, security and account preferences."><PortalShell client:load active="account" member={{ displayName: session.displayName, initials: session.displayName.slice(0, 1).toUpperCase() }} logoutHref="/api/auth/logout">
  <div class="space-y-5">
    {verified ? <p class="rounded-2xl border border-emerald-700/30 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-950" role="status">Your email address has been updated.</p> : null}
    <section class="rounded-2xl border border-black/10 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="login-details-heading">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">Login details</p>
      <h2 id="login-details-heading" class="mt-2 font-heading text-2xl font-bold tracking-tight">Your sign-in</h2>
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        <div class="rounded-xl border border-black/10 bg-[#fafaf8] p-5"><p class="text-sm text-black/55">Current login email</p><p class="mt-2 break-all font-semibold">{session.email ?? "Unavailable"}</p></div>
        <div class="rounded-xl border border-black/10 bg-[#fafaf8] p-5"><p class="text-sm text-black/55">Password</p><p class="mt-2 font-semibold">Keep your account secure with a strong password.</p><a class="mt-4 inline-flex rounded-md border border-black px-4 py-2 text-sm font-semibold transition-colors hover:bg-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black" href="/login">Change password</a></div>
      </div>
      <details class="mt-6 rounded-xl border border-black/10 p-5">
        <summary class="cursor-pointer font-semibold">Change email</summary>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-black/65">Re-enter your current password, then we will send a verification link to your new email. Your account is unchanged until that link is used.</p>
        <form class="mt-5 max-w-xl space-y-4" action="/api/auth/change-email" method="post" data-change-email-form>
          <label class="block text-sm font-semibold" for="current-password">Current password<input id="current-password" name="currentPassword" type="password" autocomplete="current-password" required class="mt-2 block w-full rounded-md border border-black/20 bg-white px-3 py-3 font-normal outline-none focus:border-black focus:ring-2 focus:ring-black/15" /></label>
          <label class="block text-sm font-semibold" for="new-email">New email address<input id="new-email" name="newEmail" type="email" autocomplete="email" required class="mt-2 block w-full rounded-md border border-black/20 bg-white px-3 py-3 font-normal outline-none focus:border-black focus:ring-2 focus:ring-black/15" /></label>
          <button class="rounded-md bg-black px-5 py-3 font-semibold text-white transition-colors hover:bg-white hover:text-black hover:ring-1 hover:ring-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black" type="submit">Send verification email</button>
          <p class="text-sm text-black/65" data-change-email-status role="status" aria-live="polite"></p>
        </form>
      </details>
    </section>

    <section class="rounded-2xl border border-black/10 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="security-heading">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">Security</p>
      <h2 id="security-heading" class="mt-2 font-heading text-2xl font-bold tracking-tight">Signed in securely</h2>
      <p class="mt-3 max-w-2xl text-base leading-7 text-black/65">Your session and credentials are managed by Members Login. The Portal does not create a second account or credential system.</p>
      <a class="mt-5 inline-flex rounded-md border border-black px-5 py-3 font-semibold transition-colors hover:bg-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black" href="/api/auth/logout">Log out</a>
    </section>

    <section class="rounded-2xl border border-black/10 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="privacy-heading">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">Privacy &amp; support</p>
      <h2 id="privacy-heading" class="mt-2 font-heading text-2xl font-bold tracking-tight">Need help?</h2>
      <div class="mt-5 flex flex-wrap gap-3"><a class="rounded-md border border-black/20 px-4 py-2 font-semibold transition-colors hover:bg-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black" href="https://www.gymfusion.com.au/privacy-policy" target="_blank" rel="noreferrer">Privacy policy</a><a class="rounded-md border border-black/20 px-4 py-2 font-semibold transition-colors hover:bg-black hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black" href="/help">Help &amp; Support</a></div>
    </section>
  </div>
</PortalShell></PortalLayout> : <main>Members Portal is temporarily unavailable.</main>}

<script>
  const form = document.querySelector<HTMLFormElement>("[data-change-email-form]");
  const status = document.querySelector<HTMLElement>("[data-change-email-status]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!button || !status) return;
    button.disabled = true;
    status.textContent = "Sending verification email…";
    try {
      const response = await fetch(form.action, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      const payload = await response.json() as { ok?: boolean; code?: string };
      if (!response.ok || payload.ok !== true) throw new Error(payload.code || "request_failed");
      form.reset();
      status.textContent = "Verification email sent. Your email will change only after you use the link in that message.";
    } catch {
      status.textContent = "We could not start the email change. Check your current password and try again.";
      button.disabled = false;
    }
  });
</script>
