---
import PortalLayout from "../layouts/PortalLayout.astro";
import PortalShell from "../components/portal/PortalShell";
import PortalState from "../components/portal/PortalState.astro";
import { EoiProgress } from "../components/portal/DashboardView";
import EoiOverviewCards from "../components/portal/EoiOverviewCards";
import { loadPortalPage } from "../lib/portal-page";
import { readMemberPortalView } from "../lib/member-portal-read";
import { deriveEoiProgression, type EoiOnboardingRead } from "../lib/eoi-progression";
import { env } from "cloudflare:workers";
import { sectionCopy } from "../lib/portal";
import "../styles/global.css";
const session = await loadPortalPage(Astro.request);
if (session.kind === "redirect") return new Response(null, { status: 303, headers: { Location: "/login", "Cache-Control": "no-store" } });
if (session.kind === "unavailable") Astro.response.status = 503;
const copy = sectionCopy.eoi;
const read = session.kind === "authenticated"
  ? await readMemberPortalView(Astro.request, env.MEMBER_LOGIN_SERVICE_URL, "dashboard")
  : { kind: "unavailable" as const };
const onboarding = read.kind === "authenticated" ? read.data.onboarding as EoiOnboardingRead : undefined;
const projection = deriveEoiProgression(onboarding);
---
{session.kind === "authenticated" ? <PortalLayout title={copy.title} description={copy.description}><PortalShell client:load active="eoi" member={{ displayName: session.displayName, initials: session.displayName.slice(0, 1).toUpperCase() }} logoutHref="/api/auth/logout">{projection ? <><EoiOverviewCards progression={projection} /><EoiProgress projection={projection} /></> : <PortalState heading="Expression of Interest" body="Your EOI progress is temporarily unavailable. Please try again shortly." links={[]} />}</PortalShell></PortalLayout> : <main>Members Portal is temporarily unavailable.</main>}
