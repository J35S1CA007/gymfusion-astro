---
import { loadPortalPage } from "../../lib/portal-page";
import HealthInformationNotice from "../../components/HealthInformationNotice.astro";
import structure from "../../../reference/EOI Parts 2-4/EOI Part 4 Fitness Profile/eoi-part-4-form-structure.json";

const isDevelopmentPreview = import.meta.env.DEV;
const showSuccessPreview = isDevelopmentPreview && Astro.url.searchParams.get("preview") === "success";
const session = isDevelopmentPreview
  ? { kind: "authenticated" as const, displayName: "Preview Member" }
  : await loadPortalPage(Astro.request, Astro.locals);
if (session.kind === "redirect") return new Response(null, { status: 303, headers: { Location: "/login", "Cache-Control": "no-store" } });
if (session.kind === "unavailable") return new Response("Members Portal is temporarily unavailable.", { status: 503, headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "no-store" } });
const sessionIntensityQuestionIds = new Set([
  "55cc3276-4d53-4e13-9827-8a0472366f00",
  "ea59c43f-23da-480f-aab6-881211429394",
  "b6cfbb6c-c440-4e05-8c3d-1b4fca59dea4"
]);
const questions = structure.form.questions.filter((question) => question.isAnswerField && question.fieldType !== "hidden" && !sessionIntensityQuestionIds.has(question.id));
const formSections = [
  { key: "activity", title: "Weekly Activity", description: "Tell us how often you move and how much time you spend at each intensity.", questions: questions.filter((question) => question.order >= 6 && question.order <= 14) },
  { key: "measurements", title: "Current Measurements", description: "Share your current height and weight, or provide an estimate if you are unsure.", questions: questions.filter((question) => question.order >= 22 && question.order <= 36) },
  { key: "background", title: "Fitness Background", description: "Tell us about the activities, training, and gymnastics experience you have had.", questions: questions.filter((question) => question.order >= 42 && question.order <= 55) },
  { key: "goals", title: "Goals and Preferences", description: "Share what you would like to achieve and how you prefer to train.", questions: questions.filter((question) => question.order >= 59 && question.order <= 63) }
];
const getStepIndex = (question: (typeof questions)[number]) => formSections.findIndex((section) => section.questions.some((item) => item.id === question.id));
const fitnessBackgroundQuestionId = "95b1e51d-0ada-472c-8b52-a2eedb5d9d03";
const fitnessBackgroundOtherFieldName = "fitnessBackgroundOther";
const goalsQuestionId = "2cdb337f-3283-49eb-adaa-40b36b370403";
const somethingElseOptionValue = "72339ac7-1547-4566-bdaa-7cfc6e75e378";
const overallActivityQuestionId = "2f50a6ce-91f0-4b27-9c62-d1f200c49450";
const heightChoiceQuestionId = "cb3f237d-53a1-4664-8c27-aa6567bc4300";
const heightInputQuestionIds = new Set(["bd07595c-a567-4fab-a2f0-1ccb4eb28315", "b7628041-c31e-4cfa-bd2d-8036a896ae9f"]);
const weightChoiceQuestionId = "fb588ef1-f6bb-4326-ae1d-28814d4d8d6b";
const weightInputQuestionIds = new Set(["629ae559-1911-40bd-8c3d-a20899170ca7", "e2e36670-90a8-42cd-a4f9-f68bcb867e46"]);
const goalsDetailsQuestionId = "98cba7c0-3215-4508-8d4f-eab41dbeef00";
const goalsDisplayLabels = new Map([
  ["d92c270c-490a-4db4-8dad-c3b5c2122ebf", "Improve lower body strength & control"],
  ["4a61a38c-3e32-40b8-ab56-acd5c3de20bf", "Develop injury resilience/body durability"]
]);
const gymnasticsFollowUpLabels = new Map([
  ["3d10e2f2-d2e4-4b65-941b-f19bcda23cb4", "What kind of gymnastics do you participate in? (Optional)"],
  ["d931a68f-fa69-4063-9d9c-244d6aa220e3", "What kind of gymnastics experience have you had in the past? (Optional)"],
  ["c7291f4d-fcd3-4f04-9f89-07c561a3110c", "What kind of gymnastics experience do you have? (Optional)"]
]);
const measurementConditionByQuestionId = new Map([
  ["bd07595c-a567-4fab-a2f0-1ccb4eb28315", "height-known"],
  ["b7628041-c31e-4cfa-bd2d-8036a896ae9f", "height-estimate"],
  ["629ae559-1911-40bd-8c3d-a20899170ca7", "weight-known"],
  ["e2e36670-90a8-42cd-a4f9-f68bcb867e46", "weight-estimate"],
  ["de1f389b-103e-42b2-b861-83a14dcd629d", "weight-estimate-followup"],
  [goalsDetailsQuestionId, "goals-something-else"]
]);
const minuteIntensityQuestionIds = new Set([
  "05a45715-434c-4851-a042-855c59e6a220",
  "aaf40be5-18ef-416e-b9d6-6e5b0fb3405c",
  "f9f0265d-17d9-402f-b13d-44dc92e11db0"
]);
const intensityLabels = new Map([
  ["05a45715-434c-4851-a042-855c59e6a220", "Light (RPE 1–2)"],
  ["aaf40be5-18ef-416e-b9d6-6e5b0fb3405c", "Moderate (RPE 3–4)"],
  ["f9f0265d-17d9-402f-b13d-44dc92e11db0", "Vigorous (RPE 5–10)"]
]);
const intensityInputUnits = new Map([
  ["05a45715-434c-4851-a042-855c59e6a220", "minutes"],
  ["aaf40be5-18ef-416e-b9d6-6e5b0fb3405c", "minutes"],
  ["f9f0265d-17d9-402f-b13d-44dc92e11db0", "minutes"]
]);
const intensityQuestionIds = new Set([...minuteIntensityQuestionIds]);
const unitQuestionIds = new Set([
  "cb3f237d-53a1-4664-8c27-aa6567bc4300",
  "fb588ef1-f6bb-4326-ae1d-28814d4d8d6b",
  "bd07595c-a567-4fab-a2f0-1ccb4eb28315",
  "b7628041-c31e-4cfa-bd2d-8036a896ae9f",
  "629ae559-1911-40bd-8c3d-a20899170ca7",
  "e2e36670-90a8-42cd-a4f9-f68bcb867e46"
]);
const fitnessBackgroundPrompt = structure.form.questions.find((question) => question.id === "7fbb7399-cdca-487f-90c3-870ff6af3040");
const otherOptionValue = "ac6154ae-d805-4160-a1e2-770117b6ef04";
const basicMovementsOptionValue = "2794ca4b-8e33-4a6e-b20e-f20a0098123d";
const generalGymStrengthTrainingOptionValue = "f6e8c12e-44a7-4c0b-9f07-16d7ea8d7f8e";
const removedGymnasticsMistakeOptionValue = "3f5e0b6f-612c-4823-9d77-ee7ba478dd35";
const fitnessBackgroundDisplayLabels = new Map([
  ["325ed625-b32a-425b-8cde-442409d10e94", "Acrobatics (Circus-style)"],
  ["28a680da-0068-43be-8770-773d658b801c", "Aerial arts (Silks, lyra, aerial rope)"]
]);
const additionalFitnessOptions = new Map([
  [generalGymStrengthTrainingOptionValue, { label: "General gym strength training — Traditional weightlifting, resistance machines, or free weights focused on strength and muscle building.", value: generalGymStrengthTrainingOptionValue, order: 0 }]
]);
const fitnessBackgroundCategories = [
  { title: "Foundation & Mobility", values: ["2794ca4b-8e33-4a6e-b20e-f20a0098123d", "821a5033-e2ea-44d0-a6b9-b68e66301387", "42aa6969-04ee-4f7d-981c-d465daf39496", "8895a33f-6cfe-44f4-afc0-1af67ea21c91"] },
  { title: "Strength & Functional Training", values: [generalGymStrengthTrainingOptionValue, "4e767d6f-93ea-4492-8f36-8040cde37b39", "ff565015-cd40-4912-a97f-bf2de243ef21", "33929d14-b203-4a27-9e37-43355261a025", "d42b1ba1-d22d-4648-b7f2-e6cf13c5c681", "b3dd7d8f-bf00-4792-8789-18e4d00dd8d0"] },
  { title: "Sports, Dance & Performance", values: ["eac26e31-3dfd-4de7-b893-5ff4f738b5cc", "72131517-7d61-4cfc-9601-25b40d9d672d", "b16a5123-6702-4c31-9585-7920dd4fb8c3"] },
  { title: "Gymnastics & Bodyweight Arts", values: ["690c0946-7f24-44a0-8ae2-9dcf43555397", "41242412-5118-421a-9ad2-36ed6431d4fd", "71a3b5f4-bdfd-41d9-ba66-14e6635e7c35", "325ed625-b32a-425b-8cde-442409d10e94", "28a680da-0068-43be-8770-773d658b801c", "ddb57723-0146-4ea1-9554-1a6755a6a3c9", "cf54f0aa-06b2-46b0-ab70-ab61e5844168"] },
  { title: "Combat & Martial Arts", values: ["4590c8f7-9d1a-4018-9fd4-ac20246faf64", "5864393c-e7d5-48f9-9382-bc6423e2ccae", "c6ca99e5-cc69-4daa-83bd-6b15bac765b9"] },
  { title: "Tactical & Service Conditioning", values: ["3e4810d8-3cb5-4d19-a698-a0f50cd409b4", "3792d8b7-c2ca-470e-8a0f-c193e04c57a5", "2f7b1085-3427-4e08-94bb-2e04b36d6e95", "933db423-a03e-4a00-bad3-12be31e61de0", "e409a7aa-ebc9-4c03-8639-ad94fa782872"] },
  { title: "Other Experience", values: [otherOptionValue] }
];
const fitnessCategoryByFirstOptionValue = new Map(fitnessBackgroundCategories.map((category) => [category.values[0], category.title]));
const gymnasticsFollowUpQuestionIds = new Set([
  "be17b43c-5265-488d-ae5b-73580a589b7c",
  "3d10e2f2-d2e4-4b65-941b-f19bcda23cb4",
  "d931a68f-fa69-4063-9d9c-244d6aa220e3",
  "c7291f4d-fcd3-4f04-9f89-07c561a3110c"
]);
const questionGroupDefinitions = [
  { key: "activity-total", step: 0, questionIds: [overallActivityQuestionId] },
  { key: "activity-minutes", step: 0, questionIds: [...minuteIntensityQuestionIds] },
  { key: "height", step: 1, questionIds: ["cb3f237d-53a1-4664-8c27-aa6567bc4300", "bd07595c-a567-4fab-a2f0-1ccb4eb28315", "b7628041-c31e-4cfa-bd2d-8036a896ae9f"] },
  { key: "weight", step: 1, questionIds: ["fb588ef1-f6bb-4326-ae1d-28814d4d8d6b", "629ae559-1911-40bd-8c3d-a20899170ca7", "e2e36670-90a8-42cd-a4f9-f68bcb867e46", "de1f389b-103e-42b2-b861-83a14dcd629d"] },
  { key: "fitness-background", step: 2, questionIds: [fitnessBackgroundQuestionId] },
  { key: "gymnastics-status", step: 2, questionIds: ["be17b43c-5265-488d-ae5b-73580a589b7c"] },
  { key: "gymnastics-details", step: 2, questionIds: [...gymnasticsFollowUpQuestionIds].filter((id) => id !== "be17b43c-5265-488d-ae5b-73580a589b7c") },
  { key: "goals", step: 3, questionIds: [goalsQuestionId, goalsDetailsQuestionId] },
  { key: "mindset", step: 3, questionIds: ["2f3cc5fa-0e36-4107-9cee-4eb76ac8c46e"] },
  { key: "training-approach", step: 3, questionIds: ["9614b085-3eda-4807-b415-a9fe6c66ea38"] }
];
const questionGroupIndexByQuestionId = new Map(questionGroupDefinitions.flatMap((group, index) => group.questionIds.map((questionId) => [questionId, index + 1])));
const renderQuestions = questions.flatMap((question) => {
  if (question.id === goalsQuestionId) return [question, ...questions.filter((item) => item.id === goalsDetailsQuestionId)];
  if (question.id === goalsDetailsQuestionId) return [];
  return [question];
});
const shuffle = <T,>(items: T[]) => {
  const shuffled = [...items];
  for (let index = shuffled.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
  }
  return shuffled;
};
const getQuestionGroupIndex = (question: (typeof questions)[number]) => questionGroupIndexByQuestionId.get(question.id) ?? -1;
const getQuestionGroupIndexByKey = (key: string) => {
  const index = questionGroupDefinitions.findIndex((group) => group.key === key);
  return index < 0 ? index : index + 1;
};
const getOptions = (question: (typeof questions)[number]) => {
  if (question.id === "be17b43c-5265-488d-ae5b-73580a589b7c") return question.options.filter((option) => option.value !== removedGymnasticsMistakeOptionValue);
  if (question.id === goalsQuestionId) {
    const somethingElseOption = question.options.find((option) => option.value === somethingElseOptionValue);
    return [...shuffle(question.options.filter((option) => option.value !== somethingElseOptionValue)), ...(somethingElseOption ? [somethingElseOption] : [])];
  }
  if (question.id !== fitnessBackgroundQuestionId) return question.options;
  const optionsByValue = new Map(question.options.map((option) => [option.value, option]));
  return fitnessBackgroundCategories.flatMap((category) => category.values.flatMap((value) => {
    const option = optionsByValue.get(value) || additionalFitnessOptions.get(value);
    return option ? [{ ...option, label: fitnessBackgroundDisplayLabels.get(value) || option.label }] : [];
  }));
};
const clean = (value: unknown) => String(value || "").replace(/,tag,[^,]*/g, "").replace(/,tag/g, "").replace(/\s+/g, " ").trim();
const heightSupportDescription = clean(questions.find((question) => heightInputQuestionIds.has(question.id))?.description);
const weightSupportDescription = clean(questions.find((question) => weightInputQuestionIds.has(question.id))?.description);
const fitnessBackgroundSubtitle = {
  prefix: "There are no right or wrong answers here! Check ",
  emphasis: "all",
  middle: " the options below that fit your ",
  secondEmphasis: "current or past",
  suffix: " experience, or select 'Other' if you'd like to share more details."
};
const getQuestionLabel = (question: (typeof questions)[number]) => question.id === goalsDetailsQuestionId ? "We’d love to hear the specifics—what are you aiming for?" : gymnasticsFollowUpLabels.get(question.id) || (question.id === fitnessBackgroundQuestionId ? clean(fitnessBackgroundPrompt?.questionText) : question.id === overallActivityQuestionId ? "On average, how many physical activity sessions do you complete each week?" : heightInputQuestionIds.has(question.id) ? "Height" : weightInputQuestionIds.has(question.id) ? "Weight" : intensityLabels.get(question.id) || clean(question.questionText));
const getQuestionLabelParts = (question: (typeof questions)[number]) => {
  const label = getQuestionLabel(question);
  const match = unitQuestionIds.has(question.id) ? label.match(/^(.*?)(\s*\([^)]*\))(.*)$/) : null;
  return match ? { prefix: match[1], detail: match[2], suffix: match[3] } : { prefix: label, detail: "", suffix: "" };
};
const getQuestionHelp = (question: (typeof questions)[number]) => question.id === fitnessBackgroundQuestionId ? "" : question.id === overallActivityQuestionId ? "Think about a standard week over the last few months." : question.id === heightChoiceQuestionId ? heightSupportDescription : question.id === weightChoiceQuestionId ? weightSupportDescription : heightInputQuestionIds.has(question.id) || weightInputQuestionIds.has(question.id) ? "" : clean(question.description || question.subtext);
const getQuestionHelpParts = (question: (typeof questions)[number]) => {
  const help = getQuestionHelp(question);
  if (!gymnasticsFollowUpQuestionIds.has(question.id)) return { intro: help, bullets: [] };
  const parts = help.split("•").map((part) => part.trim()).filter(Boolean);
  return { intro: parts[0] || "", bullets: parts.slice(1) };
};
const getQuestionPlaceholder = (question: (typeof questions)[number]) => question.id === overallActivityQuestionId || intensityQuestionIds.has(question.id) ? "0" : heightInputQuestionIds.has(question.id) ? question.placeholder.replace(/\s*cm\s*$/i, "") : weightInputQuestionIds.has(question.id) ? question.placeholder.replace(/\s*kg\s*$/i, "") : question.placeholder;
const sessionDefinition = "A session is a dedicated period set aside for physical activity or exercise. Count a workout, class, sport, walk, run, or similar activity as one session, even if it includes different intensities.";
const getOptionLabelParts = (label: string) => {
  const parentheticalMatch = label.match(/^(.*?)(\s*\([^)]*\))(.*)$/);
  if (parentheticalMatch) return { prefix: parentheticalMatch[1], detail: parentheticalMatch[2], suffix: parentheticalMatch[3] };
  const andOrMatch = label.match(/^(.*?)(\s+and\/or\s+)(.*)$/);
  if (andOrMatch) return { prefix: andOrMatch[1], detail: andOrMatch[2], suffix: andOrMatch[3] };
  const dashMatch = label.match(/^(.*?)(\s[–—].*)$/);
  return dashMatch ? { prefix: dashMatch[1], detail: dashMatch[2], suffix: "" } : { prefix: label, detail: "", suffix: "" };
};
const getOptionLabel = (option: (typeof questions)[number]["options"][number]) => goalsDisplayLabels.get(option.value) || fitnessBackgroundDisplayLabels.get(option.value) || option.label;
const shouldStyleOptionParts = (question: (typeof questions)[number], option: (typeof questions)[number]["options"][number]) => question.id === fitnessBackgroundQuestionId || (question.id === goalsQuestionId && option.value === somethingElseOptionValue);
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GYMFUSION Member Portal | Fitness Profile</title>
</head>
<body>
<main class="eoi-part4" aria-labelledby="part4-title" data-success-preview={showSuccessPreview ? "true" : undefined}>
  <div class="gf-wrap">
    <div class="gf-shell">
      <header class="gf-header">
        <span class="gf-kicker">EOI PART 4</span>
        <h1 id="part4-title">{structure.form.publicTitle}</h1>
        <p class="gf-intro">Tell us a bit about your fitness journey—your goals, favorite workouts, and what you’re into! The more we know, the better GYMFUSION can tailor your coaching experience just for you. Take a sec to answer these questions as honestly as you can. It all helps us figure out where you're starting from and where you want to go!</p>
      </header>
      <div class="gf-progress" aria-live="polite">
        <div class="gf-progress-track" aria-hidden="true"><span id="part4-progress-bar"></span></div>
        <p id="part4-progress-label">Question 1 of 10: Weekly Activity</p>
      </div>
      <form id="part4-form" novalidate>
        <section class="gf-page is-active">
          <div id="part4-question-list" class="gf-question-list is-stepped">
            <div class="gf-health-notice-step" data-step-heading data-step-index="-1" data-field-id="healthInformationNotice" data-field-type="notice" data-question-group="0" aria-labelledby="health-information-notice-heading">
              <HealthInformationNotice />
            </div>
            {renderQuestions.map((question) => <Fragment>
              {question.id === "2f50a6ce-91f0-4b27-9c62-d1f200c49450" ? <div class="gf-step-heading" data-step-heading data-step-index="0" aria-labelledby="step-activity-heading">
                <span class="gf-step-kicker">SECTION 01 OF 04</span>
                <h2 id="step-activity-heading" tabindex="-1">Weekly Activity</h2>
                <p data-step-description="0">Let's begin with a typical week</p>
                <p data-step-description="1" hidden>Now let's break that total down by intensity.</p>
                <p data-step-description="2" hidden>Now, let's look at how much time you dedicate to your workouts.</p>
              </div> : null}
              {question.id === "cb3f237d-53a1-4664-8c27-aa6567bc4300" ? <div class="gf-step-heading" data-step-heading data-step-index="1" aria-labelledby="step-measurements-heading">
                <span class="gf-step-kicker">SECTION 02 OF 04</span>
                <h2 id="step-measurements-heading" tabindex="-1">Current Measurements</h2>
                <p>Share your current height and weight, or provide an estimate if you are unsure.</p>
              </div> : null}
              {question.id === "95b1e51d-0ada-472c-8b52-a2eedb5d9d03" ? <div class="gf-step-heading" data-step-heading data-step-index="2" aria-labelledby="step-background-heading">
                <span class="gf-step-kicker">SECTION 03 OF 04</span>
                <h2 id="step-background-heading" tabindex="-1">Fitness Background</h2>
                <p>Share a brief overview of your training history.</p>
              </div> : null}
              {question.id === goalsQuestionId ? <div class="gf-step-heading" data-step-heading data-step-index="3" aria-labelledby="step-goals-heading">
                <span class="gf-step-kicker">SECTION 04 OF 04</span>
                <h2 id="step-goals-heading" tabindex="-1">Goals and Preferences</h2>
                <p>Share what you would like to achieve and how you prefer to train.</p>
              </div> : null}
              {question.id === "05a45715-434c-4851-a042-855c59e6a220" ? <div class="intensity-panel-heading" data-question-group={getQuestionGroupIndexByKey("activity-minutes")} role="group" aria-labelledby="minutes-per-week-heading">
                <div class="intensity-heading-row">
                  <h3 id="minutes-per-week-heading">Minutes Per Week</h3>
                  <details class="gf-info">
                    <summary aria-label="How to estimate your minutes">
                      <svg class="gf-info-icon gf-info-icon--outline" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.75" /><path d="M12 10.75v5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75" /><circle cx="12" cy="7.5" r=".9" fill="currentColor" /></svg>
                      <svg class="gf-info-icon gf-info-icon--solid" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5Zm0 5.1a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0 2.1Zm-1.05 4.2a1.05 1.05 0 0 1 2.1 0v5.1a1.05 1.05 0 0 1-2.1 0v-5.1Z" clip-rule="evenodd" /></svg>
                    </summary>
                    <div class="gf-info-popover"><strong>How to estimate your minutes</strong> Think about how long your typical sessions last. Only count actual active exercise time (e.g., exclude long rests between sets or downtime), and estimate the total minutes you spend at each intensity level across the week.</div>
                  </details>
                </div>
                <p>Take a moment to think about how hard you&apos;re working during your physical activities each week. For each intensity level listed below, just give us a rough guess of how many minutes you spend in that zone.</p>
              </div> : null}
              {question.id === "05a45715-434c-4851-a042-855c59e6a220" ? <div class="intensity-help-box" data-question-group={getQuestionGroupIndexByKey("activity-minutes")}>
                <svg class="intensity-helper-icon" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M3 15a1 1 0 1 1-2 0a1 1 0 0 1 2 0m4-1.5c0 .827-.673 1.5-1.5 1.5S4 14.327 4 13.5S4.673 12 5.5 12s1.5.673 1.5 1.5m-1 0a.5.5 0 1 0-1 0a.5.5 0 0 0 1 0m10-7.25c0 1.792-1.57 3.25-3.5 3.25h-.095c-.368 1.437-1.771 2.501-3.405 2.501c-1.5 0-2.821-.903-3.304-2.18c-.382.118-.787.18-1.196.18c-1.93 0-3.5-1.346-3.5-3c0-1.538 1.357-2.81 3.1-2.98q-.099-.378-.1-.77C4 1.459 5.57.001 7.5.001c1.017 0 1.979.411 2.64 1.115q.418-.115.86-.115c1.487 0 2.723.984 2.959 2.295C15.192 3.821 16 4.972 16 6.25m-1 0c0-.946-.666-1.798-1.656-2.118a.5.5 0 0 1-.346-.453C12.955 2.738 12.077 2 11 2q-.436 0-.837.161a.5.5 0 0 1-.587-.164C9.109 1.373 8.333 1 7.5 1C6.121 1 5 2.01 5 3.25c0 .358.092.701.271 1.019a.5.5 0 0 1-.479.746a3 3 0 0 0-.293-.014c-1.379 0-2.5.897-2.5 2s1.121 2 2.5 2c.463 0 .916-.104 1.311-.299a.5.5 0 0 1 .451.004a.5.5 0 0 1 .265.366c.174 1.1 1.237 1.929 2.474 1.929c1.301 0 2.396-.914 2.492-2.081a.497.497 0 0 1 .573-.454q.212.033.435.034c1.379 0 2.5-1.01 2.5-2.25" /></svg>
                <p class="intensity-helper-copy"><em>Not sure how to tell the different levels apart?</em><br />No worries—<strong>check out the RPE Intensity Guide<span class="mobile-guide-break"><br /></span> for a little help!</strong></p>
                <details class="intensity-reference">
                <summary aria-controls="rpe-guide-content"><span class="rpe-guide-open-label">Open the RPE Intensity Guide</span><span class="rpe-guide-close-label">Close the RPE Intensity Guide</span></summary>
                </details>
                <div id="rpe-guide-content" class="rpe-guide-content" aria-hidden="true">
                <div class="rpe-guide-switcher" role="group" aria-label="RPE Intensity Guide version">
                  <button type="button" data-rpe-guide-choice="image" aria-pressed="true">Image Version</button>
                  <button type="button" data-rpe-guide-choice="text" aria-pressed="false">Plain Text Guide</button>
                </div>
                <figure class="gf-intensity-scale" data-rpe-guide-panel="image">
                  <button type="button" class="rpe-image-trigger" data-rpe-image-open aria-label="Expand the RPE Intensity Guide image">
                    <img src="/assets/images/Intensity-Scale-Guide-GYMFUSION.png" width="1672" height="941" alt="WAM Mapping Note: RPE 5–10 all enter as Vigorous Minutes. Max effort (9–10) has no separate bucket." decoding="async" />
                    <span class="rpe-image-expand-hint" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M6 2H2v4M10 2h4v4M14 10v4h-4M6 14H2v-4" /></svg></span>
                  </button>
                </figure>
                <div class="rpe-text-alternative" data-rpe-guide-panel="text" hidden>
                  <div class="rpe-table-wrap">
                    <table>
                      <caption>RPE Training Zones<span class="rpe-table-intro">Rating of percieved exerction (RPE) uses a 1–10 scale to help guage your exercise effort based on breathing, rate rate and muscle fatigue.</span></caption>
                      <thead><tr><th scope="col">Intensity</th><th scope="col">RPE (1–10)</th><th scope="col">% Max HR</th><th scope="col">Typical Duration</th><th scope="col">Description</th><th scope="col">WAM Bucket</th></tr></thead>
                      <tbody>
                        <tr><th scope="row">Light</th><td>1–2</td><td>40–55%</td><td>60+ minutes</td><td>Breathing is easy. Can sing. Recovery day activity.</td><td>Light</td></tr>
                        <tr><th scope="row">Moderate</th><td>3–4</td><td>55–70%</td><td>30–60 minutes</td><td>Slight increase in breathing. Can hold a full conversation.</td><td>Moderate</td></tr>
                        <tr><th scope="row">Vigorous</th><td>5–6</td><td>70–80%</td><td>20–40 minutes</td><td>Breathing is noticeable. Can speak only in short phrases.</td><td>Vigorous</td></tr>
                        <tr><th scope="row">Hard</th><td>7–8</td><td>80–90%</td><td>10–20 minutes</td><td>Breathing is heavy. Can say only a few words. Muscle burn begins.</td><td>Vigorous</td></tr>
                        <tr><th scope="row">Max / Near Max</th><td>9–10</td><td>&gt;90%</td><td>Not sustainable (bursts: 5s–2min)</td><td>Labored breathing. Cannot speak. All-out effort.</td><td>Vigorous <span role="img" aria-label="Warning">⚠️</span></td></tr>
                      </tbody>
                    </table>
                  </div>
                </div>
                </div>
                <dialog class="rpe-image-dialog" data-rpe-image-dialog aria-labelledby="rpe-image-dialog-title">
                  <div class="rpe-image-dialog-shell">
                    <div class="rpe-image-dialog-header">
                      <h2 id="rpe-image-dialog-title">RPE Intensity Guide</h2>
                      <button type="button" class="rpe-image-dialog-close" data-rpe-image-close aria-label="Close expanded RPE Intensity Guide">Close</button>
                      <div class="rpe-image-dialog-tools" aria-label="Image controls">
                        <button type="button" data-rpe-image-zoom-out aria-label="Zoom out">−</button>
                        <output data-rpe-image-zoom-value aria-live="polite">100%</output>
                        <button type="button" data-rpe-image-zoom-in aria-label="Zoom in">+</button>
                      </div>
                    </div>
                    <div class="rpe-image-dialog-viewport">
                      <div class="rpe-image-pan-surface">
                        <img src="/assets/images/Intensity-Scale-Guide-GYMFUSION.png" width="1672" height="941" alt="RPE Intensity Guide: RPE 5–10 all enter as Vigorous Minutes. Max effort (9–10) has no separate bucket." decoding="async" />
                      </div>
                    </div>
                  </div>
                </dialog>
              </div> : null}
              <div class={`gf-card question ${intensityQuestionIds.has(question.id) ? "intensity-row" : ""} ${question.id === goalsDetailsQuestionId ? "goals-details-question" : ""}`} data-field-id={question.id} data-field-type={question.fieldType} data-step-index={getStepIndex(question)} data-question-group={getQuestionGroupIndex(question)} data-required={question.required ? "true" : undefined} data-intensity-band={intensityLabels.get(question.id)?.split(" ")[0].toLowerCase()} data-intensity-unit={intensityInputUnits.get(question.id)} data-conditional-key={measurementConditionByQuestionId.get(question.id)} data-gymnastics-follow-up={gymnasticsFollowUpQuestionIds.has(question.id) ? "true" : undefined}>
              {intensityQuestionIds.has(question.id) ? <span class="intensity-signal" aria-hidden="true">
                {intensityLabels.get(question.id)?.startsWith("Light") ? <img src="/assets/images/Light-emoji.png" alt="" aria-hidden="true" /> : intensityLabels.get(question.id)?.startsWith("Moderate") ? <img src="/assets/images/Moderate-emoji.png" alt="" aria-hidden="true" /> : <img src="/assets/images/Vigorous-emoji.png" alt="" aria-hidden="true" />}
              </span> : null}
              <div class="gf-label-row">
                {question.fieldType === "checkbox" || question.fieldType === "multiselect" || question.fieldType === "radio" ? <p class="gf-field-label" id={`label-${question.id}`}><span>{getQuestionLabelParts(question).prefix}</span><span class="question-detail">{getQuestionLabelParts(question).detail}</span><span>{getQuestionLabelParts(question).suffix}</span>{question.required ? <span class="gf-required-indicator" aria-hidden="true">*</span> : null}</p> : <label class="gf-field-label" for={`field-${question.id}`}><span>{getQuestionLabelParts(question).prefix}</span><span class="question-detail">{getQuestionLabelParts(question).detail}</span><span>{getQuestionLabelParts(question).suffix}</span>{question.required ? <span class="gf-required-indicator" aria-hidden="true">*</span> : null}</label>}
                {question.id === overallActivityQuestionId ? <details class="gf-info">
                  <summary aria-label="What counts as a session?">
                    <svg class="gf-info-icon gf-info-icon--outline" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.75" /><path d="M12 10.75v5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75" /><circle cx="12" cy="7.5" r=".9" fill="currentColor" /></svg>
                    <svg class="gf-info-icon gf-info-icon--solid" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5Zm0 5.1a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Zm-1.05 4.2a1.05 1.05 0 0 1 2.1 0v5.1a1.05 1.05 0 0 1-2.1 0v-5.1Z" clip-rule="evenodd" /></svg>
                  </summary>
                  <div class="gf-info-popover"><strong>What counts as a session?</strong> {sessionDefinition}</div>
                </details> : null}
              </div>
              {question.id === fitnessBackgroundQuestionId ? <p class="gf-question-subtitle">{fitnessBackgroundSubtitle.prefix}<strong>{fitnessBackgroundSubtitle.emphasis}</strong>{fitnessBackgroundSubtitle.middle}<strong>{fitnessBackgroundSubtitle.secondEmphasis}</strong>{fitnessBackgroundSubtitle.suffix}</p> : null}
              {getQuestionHelp(question) ? gymnasticsFollowUpQuestionIds.has(question.id) ? <div class="gf-question-help gf-question-help--list">{getQuestionHelpParts(question).intro ? <p>{getQuestionHelpParts(question).intro}</p> : null}{getQuestionHelpParts(question).bullets.length ? <ul>{getQuestionHelpParts(question).bullets.map((bullet) => <li>{bullet}</li>)}</ul> : null}</div> : <p class="gf-question-help">{getQuestionHelp(question)}</p> : null}
              {question.id === goalsQuestionId ? <p class="gf-question-help">Select <strong>all</strong> that apply</p> : null}
              {question.fieldType === "checkbox" || question.fieldType === "multiselect" ? <div class={question.id === fitnessBackgroundQuestionId ? "options fitness-options" : "options"} aria-labelledby={`label-${question.id}`}>{getOptions(question).map((option) => <Fragment>{question.id === fitnessBackgroundQuestionId && fitnessCategoryByFirstOptionValue.has(option.value) ? <h3 class="fitness-category-heading">{fitnessCategoryByFirstOptionValue.get(option.value)}</h3> : null}{question.id === fitnessBackgroundQuestionId && option.value === basicMovementsOptionValue ? <div class="fitness-option-with-info"><label><input type="checkbox" name={question.id} value={option.value} /> <span>{shouldStyleOptionParts(question, option) ? <><span class="option-primary">{getOptionLabelParts(getOptionLabel(option)).prefix}</span><span class="option-detail">{getOptionLabelParts(getOptionLabel(option)).detail}</span>{getOptionLabelParts(getOptionLabel(option)).suffix}</> : getOptionLabel(option)}</span></label><details class="gf-info fitness-option-info"><summary aria-label="What is structured training?"><svg class="gf-info-icon gf-info-icon--outline" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.75" /><path d="M12 10.75v5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75" /><circle cx="12" cy="7.5" r=".9" fill="currentColor" /></svg><svg class="gf-info-icon gf-info-icon--solid" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M12 2.25a9.75 9.75 0 1 0 0 19.5 9.75 9.75 0 0 0 0-19.5Zm0 5.1a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Zm-1.05 4.2a1.05 1.05 0 0 1 2.1 0v5.1a1.05 1.05 0 0 1-2.1 0v-5.1Z" clip-rule="evenodd" /></svg></summary><div class="gf-info-popover"><strong>What is &quot;structured training&quot;?</strong> Following a planned, goal-focused routine (like a regular weight training program or fitness plan) rather than just moving through daily activities or casual workouts.</div></details></div> : <label><input type="checkbox" name={question.id} value={option.value} /> <span>{shouldStyleOptionParts(question, option) ? <><span class="option-primary">{getOptionLabelParts(getOptionLabel(option)).prefix}</span><span class={question.id === goalsQuestionId ? "option-detail option-detail--specify" : "option-detail"}>{getOptionLabelParts(getOptionLabel(option)).detail}</span>{getOptionLabelParts(getOptionLabel(option)).suffix}</> : getOptionLabel(option)}</span></label>}</Fragment>)}</div> : question.fieldType === "radio" ? <div class="options" aria-labelledby={`label-${question.id}`}>{getOptions(question).map((option) => <label><input type="radio" name={question.id} value={option.value} required={question.required} /> <span>{getOptionLabel(option)}</span></label>)}</div> : question.fieldType === "textarea" ? <textarea id={`field-${question.id}`} name={question.id} required={question.required} placeholder={getQuestionPlaceholder(question)}></textarea> : intensityQuestionIds.has(question.id) ? <div class="intensity-input"><input id={`field-${question.id}`} name={question.id} type="number" required={question.required} min="0" value="0" placeholder={getQuestionPlaceholder(question)} /><span>{intensityInputUnits.get(question.id)}</span></div> : question.id === overallActivityQuestionId ? <div class="intensity-input overall-activity-input"><input id={`field-${question.id}`} name={question.id} type="number" required={question.required} min="0" value="0" placeholder={getQuestionPlaceholder(question)} /><span>sessions</span></div> : heightInputQuestionIds.has(question.id) ? <div class="intensity-input measurement-input"><input id={`field-${question.id}`} name={question.id} type="number" required={question.required} min="0" placeholder={getQuestionPlaceholder(question)} /><span>cm</span></div> : weightInputQuestionIds.has(question.id) ? <div class="intensity-input measurement-input"><input id={`field-${question.id}`} name={question.id} type="number" required={question.required} min="0" placeholder={getQuestionPlaceholder(question)} /><span>kilograms</span></div> : <input id={`field-${question.id}`} name={question.id} type="number" required={question.required} min="0" placeholder={getQuestionPlaceholder(question)} />}
              {question.id === fitnessBackgroundQuestionId ? <div class="gf-other-details" data-conditional-key="fitness-background-other" aria-hidden="true"><label for={`field-${fitnessBackgroundOtherFieldName}`}>Please tell us a little more</label><input id={`field-${fitnessBackgroundOtherFieldName}`} name={fitnessBackgroundOtherFieldName} type="text" maxlength="500" placeholder="Tell us about your other experience" disabled /></div> : null}
              </div>
            </Fragment>)}
          </div>
          <section id="part4-review" class="gf-review" aria-labelledby="part4-review-heading" hidden>
            <div class="gf-step-heading gf-final-review-heading">
              <span class="gf-step-kicker">FINAL REVIEW</span>
              <h2 id="part4-review-heading" tabindex="-1">Check your answers</h2>
              <p>Double-check your responses before submitting your Fitness Profile. If anything appears incorrect, click the 'back' button to make the necessary adjustments.</p>
            </div>
            <div id="part4-review-content" class="gf-review-content"></div>
            <label class="gf-review-confirmation" for="part4-review-confirmation">
              <input id="part4-review-confirmation" type="checkbox" required />
              <span>I confirm that I have reviewed my answers and they are ready to submit.</span>
            </label>
          </section>
          <p id="part4-warning" class="gf-warning" role="status" hidden></p>
          <p id="part4-error" class="gf-error" role="alert" hidden></p>
          <section id="part4-success" class="gf-success-panel" role="status" aria-labelledby="part4-success-title" hidden>
            <div class="gf-success-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
            </div>
            <span class="gf-success-kicker">SUBMISSION COMPLETE</span>
            <h2 id="part4-success-title">Your Fitness Profile was submitted successfully.</h2>
          </section>
        </section>
        <nav class="gf-nav" aria-label="Part 4 form actions">
          <button type="button" id="part4-back" class="gf-nav-button gf-nav-button--back" hidden>Back</button>
          <div class="gf-nav-actions">
            <button type="button" id="part4-next" class="gf-nav-button gf-nav-button--next">Next</button>
            <button type="submit" id="part4-submit" class="gf-nav-button gf-nav-button--continue" hidden disabled>Submit Part 4</button>
            <a id="part4-return-portal" class="gf-nav-button gf-nav-button--dashboard" href="/eoi" hidden>Return to Portal</a>
          </div>
        </nav>
      </form>
    </div>
  </div>
</main>
</body>
