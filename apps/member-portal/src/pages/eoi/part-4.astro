  const goalsInputs = [...document.querySelectorAll<HTMLInputElement>(`input[name='${goalsQuestionId}']`)];
  const goalsDetailsCard = document.querySelector<HTMLElement>(`[data-field-id='${goalsDetailsQuestionId}']`);
  let goalsDetailsWasRequired = false;
  const syncGoalsDetails = () => {
    const detailsRequired = goalsInputs.some((input) => input.checked && input.value === somethingElseOptionValue);
    goalsDetailsCard?.classList.toggle("is-visible", detailsRequired);
    goalsDetailsCard?.setAttribute("aria-hidden", String(!detailsRequired));
    for (const input of goalsDetailsCard?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea") ?? []) {
      input.disabled = !detailsRequired;
      input.required = detailsRequired;
      if (!detailsRequired) input.value = "";
    }
    if (detailsRequired && !goalsDetailsWasRequired) requestAnimationFrame(() => goalsDetailsCard?.scrollIntoView({ behavior: "smooth", block: "center" }));
    goalsDetailsWasRequired = detailsRequired;
  };
  for (const input of goalsInputs) input.addEventListener("change", syncGoalsDetails);
  syncGoalsDetails();
  const measurementCards = [...document.querySelectorAll<HTMLElement>("[data-conditional-key]")];
  const getSelectedValue = (questionId: string) => document.querySelector<HTMLInputElement>(`input[name='${questionId}']:checked`)?.value;
  const setMeasurementVisibility = (key: string, visible: boolean) => {
    for (const card of measurementCards.filter((item) => item.dataset.conditionalKey === key)) {
      card.classList.toggle("is-visible", visible);
      card.setAttribute("aria-hidden", String(!visible));
      for (const input of card.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea")) {
        input.disabled = !visible;
        if (!visible) {
          if (input instanceof HTMLInputElement && (input.type === "checkbox" || input.type === "radio")) input.checked = false;
          else input.value = "";
        }
      }
    }
  };
  const syncMeasurementQuestions = () => {
    const heightChoice = getSelectedValue(heightChoiceQuestionId);
    const weightChoice = getSelectedValue(weightChoiceQuestionId);
    const weightEstimateInput = document.querySelector<HTMLInputElement>(`input[name='${weightEstimateInputQuestionId}']`);
    setMeasurementVisibility("height-known", heightChoice === heightKnownOptionValue);
    setMeasurementVisibility("height-estimate", heightChoice === heightEstimateOptionValue);
    setMeasurementVisibility("weight-known", weightChoice === weightKnownOptionValue);
    setMeasurementVisibility("weight-estimate", weightChoice === weightEstimateOptionValue);
    setMeasurementVisibility("weight-estimate-followup", weightChoice === weightEstimateOptionValue && Boolean(weightEstimateInput?.value.trim()));
  };
  for (const input of document.querySelectorAll<HTMLInputElement>(`input[name='${heightChoiceQuestionId}'], input[name='${weightChoiceQuestionId}']`)) input.addEventListener("change", syncMeasurementQuestions);
  document.querySelector<HTMLInputElement>(`input[name='${weightEstimateInputQuestionId}']`)?.addEventListener("input", syncMeasurementQuestions);
  document.querySelector<HTMLInputElement>(`input[name='${weightEstimateInputQuestionId}']`)?.addEventListener("change", syncMeasurementQuestions);
  syncMeasurementQuestions();
  const questionList = document.querySelector<HTMLElement>("#part4-question-list");
  const stepHeadings = [...document.querySelectorAll<HTMLElement>("[data-step-heading]")];
  const stepQuestions = [...document.querySelectorAll<HTMLElement>("[data-field-id][data-question-group]")];
  const questionGroupElements = [...document.querySelectorAll<HTMLElement>("[data-question-group]")];
  const activityTotalReference = document.querySelector<HTMLElement>("#activity-total-reference");
  const activityMinutesGroupIndex = 2;
  const highSessionWarningThreshold = 10;
  const heightInputFieldIds = new Set(["bd07595c-a567-4fab-a2f0-1ccb4eb28315", "b7628041-c31e-4cfa-bd2d-8036a896ae9f"]);
  const weightInputFieldIds = new Set(["629ae559-1911-40bd-8c3d-a20899170ca7", "e2e36670-90a8-42cd-a4f9-f68bcb867e46"]);
  const getTotalActivitySessions = () => Math.max(0, Number(overallActivityInput?.value || 0) || 0);
  const syncActivityWarning = () => {
    const totalSessions = getTotalActivitySessions();
    if (!warning) return;
    warning.textContent = totalSessions > highSessionWarningThreshold
      ? `You entered ${totalSessions} physical activity sessions per week. Please check that this total is correct.`
      : "";
    warning.hidden = totalSessions <= highSessionWarningThreshold;
  };
  const syncActivityBreakdown = () => {
    const totalSessions = getTotalActivitySessions();
    const isZeroActivity = totalSessions === 0;
    for (const input of document.querySelectorAll<HTMLInputElement>("[data-intensity-unit='sessions'] input[type='number']")) {
      input.max = String(totalSessions);
    }
    if (activityTotalReference) {
      const unit = totalSessions === 1 ? "session" : "sessions";
      activityTotalReference.textContent = `You said you complete ${totalSessions} ${unit} per week.`;
    }
    for (const card of stepQuestions.filter((item) => item.dataset.intensityUnit === "sessions" || item.dataset.intensityUnit === "minutes")) {
      if (!isZeroActivity) continue;
      const input = card.querySelector<HTMLInputElement>("input[type='number']");
      if (input) input.value = "0";
    }
    return isZeroActivity;
  };
  const validateWamInputs = () => {
    const inputs = [...document.querySelectorAll<HTMLInputElement>("input[type='number'][name='05a45715-434c-4851-a042-855c59e6a220'], input[type='number'][name='aaf40be5-18ef-416e-b9d6-6e5b0fb3405c'], input[type='number'][name='f9f0265d-17d9-402f-b13d-44dc92e11db0']")];
    const values = inputs.map((input) => Number(input.value));
    const invalid = values.some((value) => !Number.isFinite(value) || value < 0 || value > 10080 || Math.abs(value * 10 - Math.round(value * 10)) > 1e-9);
    const total = values.reduce((sum, value) => sum + value, 0);
    const reportedSessions = getTotalActivitySessions();
    if (!invalid && total === 0 && reportedSessions > 0) {
      if (error) {
        error.textContent = "Enter minutes for at least one intensity because your weekly activity total is greater than zero.";
        error.hidden = false;
      }
      return false;
    }
    if (invalid || total > 10080) {
      if (error) {
        error.textContent = invalid ? "Enter each weekly minute value as a non-negative number with no more than one decimal place." : "The combined weekly minutes cannot exceed 10,080.";
        error.hidden = false;
      }
      return false;
    }
    return true;
  };
  const stepDescriptions = [...document.querySelectorAll<HTMLElement>("[data-step-description]")];
  const reviewPanel = document.querySelector<HTMLElement>("#part4-review");
  const reviewContent = document.querySelector<HTMLElement>("#part4-review-content");
  const progressBar = document.querySelector<HTMLElement>("#part4-progress-bar");
  const progressLabel = document.querySelector<HTMLElement>("#part4-progress-label");
  const backButton = document.querySelector<HTMLButtonElement>("#part4-back");
  const nextButton = document.querySelector<HTMLButtonElement>("#part4-next");
  const submitButton = document.querySelector<HTMLButtonElement>("#part4-submit");
  const returnPortalButton = document.querySelector<HTMLAnchorElement>("#part4-return-portal");
  const reviewConfirmation = document.querySelector<HTMLInputElement>("#part4-review-confirmation");
  const submittedState = document.querySelector<HTMLElement>(".eoi-part4");
  const showSubmittedState = () => {
    submittedState?.classList.add("is-submitted");
    questionList?.setAttribute("hidden", "");
    if (reviewPanel) reviewPanel.hidden = true;
    if (warning) warning.hidden = true;
    if (error) error.hidden = true;
    if (success) success.hidden = false;
    if (backButton) backButton.hidden = true;
    if (nextButton) nextButton.hidden = true;
    if (submitButton) submitButton.hidden = true;
    if (returnPortalButton) returnPortalButton.hidden = false;
  };
  const wamFieldIds = new Set(["05a45715-434c-4851-a042-855c59e6a220", "aaf40be5-18ef-416e-b9d6-6e5b0fb3405c", "f9f0265d-17d9-402f-b13d-44dc92e11db0"]);
  let currentGroup = 0;
  let showingReview = false;
  const isQuestionAvailable = (group: HTMLElement) => (!group.dataset.conditionalKey || group.classList.contains("is-visible")) && (!group.dataset.gymnasticsFollowUp || group.classList.contains("is-visible"));
  const getGroupQuestions = (groupIndex: number) => stepQuestions.filter((group) => group.dataset.questionGroup === String(groupIndex) && isQuestionAvailable(group));
  const getSectionQuestions = (stepIndex: number) => stepQuestions.filter((group) => group.dataset.stepIndex === String(stepIndex) && isQuestionAvailable(group));
  const getAvailableGroupIndices = () => {
    const skipActivityBreakdown = syncActivityBreakdown();
    return [...new Set(stepQuestions.map((group) => Number(group.dataset.questionGroup)))].sort((a, b) => a - b).filter((groupIndex) => !(skipActivityBreakdown && groupIndex === activityMinutesGroupIndex) && getGroupQuestions(groupIndex).length > 0);
  };
  const validateGroup = (groupIndex: number) => {
    if (groupIndex === activityMinutesGroupIndex && !validateWamInputs()) return false;
    for (const group of getGroupQuestions(groupIndex)) {
      const checkboxes = [...group.querySelectorAll<HTMLInputElement>("input[type='checkbox']")];
      if (group.dataset.required === "true" && checkboxes.length) {
        const valid = checkboxes.some((input) => input.checked);
        checkboxes[0].setCustomValidity(valid ? "" : "Please select at least one option.");
        if (!valid) { checkboxes[0].reportValidity(); return false; }
      }
      for (const control of [...group.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input:not(:disabled), textarea:not(:disabled)")].filter((control) => !control.closest("[hidden]"))) {
        if (!control.checkValidity()) { control.reportValidity(); return false; }
      }
    }
    if (error) error.hidden = true;
    return true;
  };
  const showGroup = (groupIndex: number, shouldFocus = true, animate = shouldFocus, scrollToSection = false) => {
    const availableGroupIndices = getAvailableGroupIndices();
    const resolvedGroupIndex = availableGroupIndices.includes(groupIndex) ? groupIndex : availableGroupIndices[0];
    if (resolvedGroupIndex === undefined) return;
    if (error) {
      error.hidden = true;
      error.textContent = "";
    }
    const groupPosition = availableGroupIndices.indexOf(resolvedGroupIndex);
    const sectionIndex = stepQuestions.find((group) => group.dataset.questionGroup === String(resolvedGroupIndex))?.dataset.stepIndex || "0";
    showingReview = false;
    currentGroup = resolvedGroupIndex;
    questionList?.removeAttribute("hidden");
    if (reviewPanel) reviewPanel.hidden = true;
    for (const heading of stepHeadings) heading.classList.toggle("is-step-visible", heading.dataset.stepIndex === sectionIndex);
    for (const group of questionGroupElements) group.classList.toggle("is-question-visible", group.dataset.questionGroup === String(resolvedGroupIndex));
    if (animate && questionList) {
      questionList.classList.remove("is-changing");
      requestAnimationFrame(() => questionList.classList.add("is-changing"));
    }
    for (const description of stepDescriptions) description.hidden = description.dataset.stepDescription !== String(resolvedGroupIndex);
    const sectionTitle = stepHeadings.find((heading) => heading.dataset.stepIndex === sectionIndex)?.querySelector("h2")?.textContent?.trim() || "Form";
    const progressText = `Question ${groupPosition + 1} of ${availableGroupIndices.length}`;
    if (progressBar) progressBar.style.width = `${((groupPosition + 1) / availableGroupIndices.length) * 100}%`;
    if (progressLabel) {
      progressLabel.textContent = progressText;
      progressLabel.setAttribute("aria-label", `${progressText}, ${sectionTitle}`);
    }
    if (backButton) backButton.hidden = groupPosition === 0;
    if (nextButton) nextButton.hidden = false;
    if (submitButton) submitButton.hidden = true;
    if (reviewConfirmation) reviewConfirmation.checked = false;
    if (submitButton) submitButton.disabled = true;
    if (returnPortalButton) returnPortalButton.hidden = true;
    if (shouldFocus) requestAnimationFrame(() => {
      const firstGroup = getGroupQuestions(resolvedGroupIndex)[0];
      const firstControl = firstGroup?.querySelector<HTMLInputElement | HTMLTextAreaElement>("input:not(:disabled), textarea:not(:disabled)");
      const sectionHeading = stepHeadings.find((heading) => heading.dataset.stepIndex === sectionIndex);
      const sectionKicker = sectionHeading?.querySelector<HTMLElement>(".gf-step-kicker");
      const focusTarget = firstControl || sectionHeading?.querySelector<HTMLElement>("h2");
      focusTarget?.focus({ preventScroll: true });
      (scrollToSection ? sectionKicker : firstGroup || focusTarget)?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  };
  const buildReview = () => {
    if (!reviewContent) return;
    reviewContent.replaceChildren();
    const availableGroupIndices = getAvailableGroupIndices();
    const reviewGroupIndices = availableGroupIndices.filter((groupIndex) => groupIndex !== 0);
    const questionNumberByGroup = new Map(reviewGroupIndices.map((groupIndex, index) => [groupIndex, index + 1]));
    const getReviewQuestionGroup = (list: HTMLElement, questionNumber: number | undefined) => {
      if (!questionNumber) return list;
      return list.querySelector<HTMLElement>(`[data-review-question-number='${questionNumber}']`) || (() => {
        const group = document.createElement("div");
        group.className = "gf-review-question-group";
        group.dataset.reviewQuestionNumber = String(questionNumber);
        group.setAttribute("aria-label", `Question ${questionNumber}`);
        list.append(group);
        return group;
      })();
    };
    const addReviewGroupHeading = (list: HTMLElement, questionNumber: number | undefined, label: string) => {
      const questionGroup = getReviewQuestionGroup(list, questionNumber);
      if (questionGroup.querySelector(".gf-review-question-heading")) return;
      const heading = document.createElement("div");
      heading.className = "gf-review-question-heading";
      const headingLabel = document.createElement("h4");
      headingLabel.textContent = label;
      heading.append(headingLabel);
      questionGroup.prepend(heading);
    };
    const addReviewItem = (list: HTMLElement, questionNumber: number | undefined, label: string, value: string | string[]) => {
      const questionGroup = getReviewQuestionGroup(list, questionNumber);
      const item = document.createElement("div");
      item.className = "gf-review-question-item";
      const term = document.createElement("dt");
      term.textContent = label;
      const description = document.createElement("dd");
      if (Array.isArray(value)) {
        const bullets = document.createElement("ul");
        bullets.className = "gf-review-bullets";
        for (const entry of value) {
          const bullet = document.createElement("li");
          bullet.textContent = entry;
          bullets.append(bullet);
        }
        description.append(bullets);
      } else {
        description.textContent = value || "Not provided";
      }
      if (label) item.append(term);
      else item.classList.add("gf-review-question-item--full");
      item.append(description);
      questionGroup.append(item);
    };
    const addFitnessReviewItem = (list: HTMLElement, questionNumber: number | undefined, entries: { label: string; detail?: string }[]) => {
      const questionGroup = getReviewQuestionGroup(list, questionNumber);
      const item = document.createElement("div");
      item.className = "gf-review-question-item gf-review-question-item--full";
      const description = document.createElement("dd");
      const bullets = document.createElement("ul");
      bullets.className = "gf-review-bullets";
      for (const entry of entries) {
        const bullet = document.createElement("li");
        bullet.textContent = entry.label;
        if (entry.detail) {
          const details = document.createElement("ul");
          details.className = "gf-review-bullet-details";
          const detail = document.createElement("li");
          detail.textContent = entry.detail;
          details.append(detail);
          bullet.append(details);
        }
        bullets.append(bullet);
      }
      description.append(bullets);
      item.append(description);
      questionGroup.append(item);
    };
    for (const heading of stepHeadings) {
      const stepIndex = heading.dataset.stepIndex || "0";
      if (stepIndex === "-1") continue;
      const reviewGroup = document.createElement("section");
      reviewGroup.className = "gf-review-group";
      reviewGroup.dataset.reviewStep = stepIndex;
      const title = document.createElement("h3");
      title.textContent = heading.querySelector("h2")?.textContent?.trim() || "Section";
      reviewGroup.append(title);
      const list = document.createElement("dl");
      list.className = "gf-review-list";
      let sessionsHeadingAdded = false;
      for (const group of getSectionQuestions(Number(stepIndex)).filter((item) => availableGroupIndices.includes(Number(item.dataset.questionGroup)))) {
        const groupIndex = Number(group.dataset.questionGroup);
        if (heightChoiceQuestionId === group.dataset.fieldId || weightChoiceQuestionId === group.dataset.fieldId || group.dataset.intensityUnit === "minutes") continue;
        const label = group.dataset.fieldId === gymnasticsStatusQuestionId
          ? "Gymnastics Experience"
          : group.dataset.fieldId === "de1f389b-103e-42b2-b861-83a14dcd629d"
            ? "Last weigh in"
            : group.dataset.fieldId === overallActivityFieldId
              ? "Sessions per week"
            : group.dataset.fieldId === fitnessBackgroundQuestionId
              ? ""
              : group.querySelector<HTMLElement>(".gf-field-label")?.textContent?.replace(/\s*\*$/, "").trim();
        if (!label && group.dataset.fieldId !== fitnessBackgroundQuestionId && group.dataset.fieldId !== pastGymnasticsDetailsQuestionId) continue;
        const inputs = [...group.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input:not(:disabled), textarea:not(:disabled)")];
        if (group.dataset.fieldId === fitnessBackgroundQuestionId) {
          const entries = inputs
            .filter((input) => input instanceof HTMLInputElement && input.type === "checkbox" && input.checked)
            .map((input) => {
              const optionValue = input.value;
              if (optionValue === otherOptionValue) return { label: fitnessBackgroundOtherInput?.value.trim() || "Not provided" };
              return {
                label: fitnessBackgroundReviewLabels.get(optionValue) || input.closest("label")?.textContent?.replace(/\s+/g, " ").trim() || optionValue,
                detail: fitnessBackgroundReviewDetails.get(optionValue)
              };
            });
          if (entries.length) addFitnessReviewItem(list, questionNumberByGroup.get(groupIndex), entries);
          continue;
        }
        let values = inputs[0]?.type === "checkbox" || inputs[0]?.type === "radio"
          ? inputs.filter((input) => (input as HTMLInputElement).checked).map((input) => input.closest("label")?.textContent?.replace(/\s+/g, " ").trim() || input.value).map((value) => group.dataset.fieldId === fitnessBackgroundQuestionId && value === "Gymnastics (Any style)" ? "Gymnastics" : value)
          : [inputs[0]?.value?.trim() || (group.dataset.fieldId === overallActivityFieldId ? "0" : "Not provided")];
        if (group.dataset.fieldId === fitnessBackgroundQuestionId && fitnessBackgroundInputs.some((input) => input.checked && input.value === otherOptionValue) && fitnessBackgroundOtherInput?.value.trim()) {
          values = values.filter((value) => value !== "Other (Please specify)");
          values.push(fitnessBackgroundOtherInput.value.trim());
        }
        const rawValue = values.filter(Boolean).join(", ");
        if (group.dataset.fieldId === pastGymnasticsDetailsQuestionId) {
          const statusGroupIndex = Number(stepQuestions.find((item) => item.dataset.fieldId === gymnasticsStatusQuestionId)?.dataset.questionGroup ?? groupIndex);
          if (rawValue && rawValue !== "Not provided") addReviewItem(list, questionNumberByGroup.get(statusGroupIndex), "", rawValue);
          continue;
        }
        if (group.dataset.required !== "true" && (!rawValue || rawValue === "Not provided")) continue;
        const unit = group.dataset.intensityUnit === "sessions" || group.dataset.fieldId === overallActivityFieldId
          ? "sessions"
          : heightInputFieldIds.has(group.dataset.fieldId || "")
            ? "cm"
            : weightInputFieldIds.has(group.dataset.fieldId || "")
              ? "kg"
              : "";
        const displayValue = unit && rawValue !== "Not provided" ? `${rawValue} ${unit}` : rawValue;
        if (group.dataset.intensityUnit === "sessions" && !sessionsHeadingAdded) {
          addReviewGroupHeading(list, questionNumberByGroup.get(groupIndex), "Sessions by intensity");
          sessionsHeadingAdded = true;
        }
        addReviewItem(list, questionNumberByGroup.get(groupIndex), label || "", group.dataset.fieldId === fitnessBackgroundQuestionId ? values : displayValue);
      }
      if (stepIndex === "0" && availableGroupIndices.includes(activityMinutesGroupIndex)) {
        addReviewGroupHeading(list, questionNumberByGroup.get(activityMinutesGroupIndex), "Minutes by intensity");
        for (const group of getSectionQuestions(0).filter((item) => item.dataset.intensityUnit === "minutes")) {
          const label = group.querySelector<HTMLElement>(".gf-field-label")?.textContent?.replace(/\s*\*$/, "").trim() || "Intensity";
          const value = group.querySelector<HTMLInputElement>("input[type='number']")?.value?.trim() || "0";
          addReviewItem(list, questionNumberByGroup.get(activityMinutesGroupIndex), label, `${value} minutes`);
        }
      }
      reviewGroup.append(list);
      reviewContent.append(reviewGroup);
    }
  };
  const showReview = () => {
    if (!validateGroup(currentGroup)) return;
    buildReview();
    showingReview = true;
    questionList?.setAttribute("hidden", "");
    if (reviewPanel) reviewPanel.hidden = false;
    if (progressBar) progressBar.style.width = "100%";
    if (progressLabel) progressLabel.textContent = "Final Review: Check your answers!";
    if (backButton) backButton.hidden = false;
    if (nextButton) nextButton.hidden = true;
    if (submitButton) submitButton.hidden = false;
    if (reviewConfirmation) reviewConfirmation.checked = false;
    if (submitButton) submitButton.disabled = true;
    if (returnPortalButton) returnPortalButton.hidden = true;
    requestAnimationFrame(() => document.querySelector<HTMLElement>("#part4-review-heading")?.focus());
  };
  backButton?.addEventListener("click", () => {
    const availableGroupIndices = getAvailableGroupIndices();
    if (showingReview) showGroup(availableGroupIndices[availableGroupIndices.length - 1] ?? 0);
    else {
      const groupPosition = availableGroupIndices.indexOf(currentGroup);
      if (groupPosition > 0) showGroup(availableGroupIndices[groupPosition - 1]);
    }
  });
  nextButton?.addEventListener("click", () => {
    if (!validateGroup(currentGroup)) return;
    const availableGroupIndices = getAvailableGroupIndices();
    const groupPosition = availableGroupIndices.indexOf(currentGroup);
    if (groupPosition === availableGroupIndices.length - 1) showReview();
    else showGroup(availableGroupIndices[groupPosition + 1], true, true, true);
  });
  reviewConfirmation?.addEventListener("change", () => {
    if (submitButton) submitButton.disabled = !reviewConfirmation.checked;
  });
  overallActivityInput?.addEventListener("input", () => {
    syncActivityBreakdown();
    syncActivityWarning();
  });
  overallActivityInput?.addEventListener("change", () => {
    syncActivityBreakdown();
    syncActivityWarning();
  });
  syncActivityBreakdown();
  syncActivityWarning();
  showGroup(getAvailableGroupIndices()[0] ?? 0, false, true);
  if (document.querySelector<HTMLElement>("[data-success-preview='true']")) {
    showSubmittedState();
  }
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const answers: Record<string, unknown> = {};
    const normalizedAnswers = [];
    for (const group of form.querySelectorAll<HTMLElement>("[data-field-id]")) {
      if (group.dataset.conditionalKey && !group.classList.contains("is-visible")) continue;
      const fieldName = group.dataset.fieldId;
      if (!fieldName) continue;
      if (fieldName === "healthInformationNotice") continue;
      const inputs = [...group.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name='${fieldName}']`)];
      const rawValue = inputs[0]?.type === "checkbox" ? inputs.filter((input) => (input as HTMLInputElement).checked).map((input) => input.value) : inputs[0]?.value?.trim() || (fieldName === overallActivityFieldId ? "0" : "");
      const value = wamFieldIds.has(fieldName) ? Number(rawValue) : rawValue;
      answers[fieldName] = value; normalizedAnswers.push({ fieldName, value });
    }
    for (const fieldName of ["healthInformationFirstName", "healthInformationLastName", "healthInformationDate", "healthInformationConsent", "healthInformationSignature", "healthInformationSignatureSvg", "healthInformationSignatureFileName", "healthInformationSignatureSignedAt", "healthInformationSignatureDocumentID"]) {
      const control = form.elements.namedItem(fieldName) as HTMLInputElement | null;
      const value = control instanceof HTMLInputElement && control.type === "checkbox" ? (control.checked ? control.value : "") : (control?.value?.trim() || "");
      answers[fieldName] = value;
      normalizedAnswers.push({ fieldName, value });
    }
    if (fitnessBackgroundOtherInput && !fitnessBackgroundOtherInput.disabled) {
      const value = fitnessBackgroundOtherInput.value.trim();
      answers[fitnessBackgroundOtherFieldName] = value;
      normalizedAnswers.push({ fieldName: fitnessBackgroundOtherFieldName, value });
    }
    const payload = { formPart: "4", formVersion: "1", submissionID: `EOI-P4-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`, submittedAt: new Date().toISOString(), answers, normalizedAnswers, calculatedFields: {}, conditionalFollowups: [] };
    if (submitButton) submitButton.disabled = true;
    let response: Response | undefined;
    let result: { ok?: boolean; submissionID?: unknown } = {};
    try {
      response = await fetch("/api/rfm-part4", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
      result = await response.json() as { ok?: boolean; submissionID?: unknown };
    } catch {
      response = undefined;
    }
    if (!response?.ok || result.ok !== true || typeof result.submissionID !== "string" || !result.submissionID.trim()) {
      if (error) { error.textContent = "We couldn’t confirm submission of Part 4. Please try again. If this continues, please email support@gymfusion.com.au"; error.hidden = false; }
      if (submitButton) submitButton.disabled = false;
      return;
    }
    if (submitButton) submitButton.disabled = true;
    showSubmittedState();
  });
</script>
