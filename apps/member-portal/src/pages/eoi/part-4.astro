<style is:global>
  @font-face { font-family: "Gamuth"; src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Regular.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: "Gamuth"; src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Bold.ttf") format("truetype"); font-weight: 700; font-style: normal; font-display: swap; }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: radial-gradient(circle at top, #fff 0%, #f7f7f7 44%, #eee 100%); color: #000; font-family: "Gamuth", Arial, Helvetica, sans-serif; line-height: 1.55; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  .eoi-part4 { color: #000; }
  .gf-wrap { width: min(940px, 100%); margin: 0 auto; padding: 20px; }
  .gf-shell { overflow: hidden; border: 1px solid rgba(0, 0, 0, 0.16); border-radius: 34px; background: linear-gradient(180deg, #fff 0%, #fcfcfc 100%); box-shadow: 0 24px 70px rgba(0, 0, 0, 0.08); }
  .gf-header { display: flex; flex-direction: column; gap: 12px; padding: 34px 34px 30px; border-bottom: 1px solid rgba(0, 0, 0, 0.16); background: #fff; }
  .gf-kicker { display: inline-flex; align-self: center; align-items: center; justify-content: center; width: fit-content; min-height: 34px; padding: 6px 16px 5px; border: 1px solid rgba(0, 0, 0, 0.16); border-radius: 999px; font-size: 11.5px; letter-spacing: 0.085em; line-height: 1; font-weight: 700; text-align: center; text-transform: uppercase; white-space: nowrap; }
  .gf-header .gf-kicker { margin-bottom: 6px; }
  .gf-header h1 { margin: 0; font-size: clamp(32px, 5.5vw, 60px); line-height: 0.95; letter-spacing: -0.01em; }
  .gf-intro { max-width: 800px; margin: 10px 0 0; color: #4b4b4b; font-size: 16px; line-height: 1.58; font-weight: 500; white-space: normal; overflow-wrap: normal; word-break: normal; text-wrap: pretty; }
  .gf-progress { display: grid; gap: 8px; padding: 14px 34px 16px; border-bottom: 1px solid rgba(0, 0, 0, 0.16); background: #f0f0f0; }
  .gf-progress-track { height: 6px; overflow: hidden; border-radius: 999px; background: #d6d6d6; }
  .gf-progress-track span { display: block; width: 25%; height: 100%; border-radius: inherit; background: #000; transition: width 180ms ease; }
  .gf-progress p { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .gf-intensity-scale { margin: 0; padding: 8px 0 0; }
  .gf-intensity-scale img { display: block; width: 100%; height: auto; border: 1px solid rgba(0, 0, 0, 0.16); border-radius: 20px; }
  .rpe-image-trigger { display: block; position: relative; width: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; text-align: left; }
  .rpe-image-trigger:focus-visible { outline: 3px solid rgba(0, 0, 0, 0.28); outline-offset: 4px; border-radius: 22px; }
  .rpe-image-expand-hint { display: none; }
  .rpe-image-dialog { width: min(96vw, 1100px); max-width: calc(100vw - 24px); height: min(92vh, 900px); max-height: calc(100vh - 24px); padding: 0; border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 18px; background: #fff; color: #111; overflow: hidden; }
  .rpe-image-dialog::backdrop { background: rgba(0, 0, 0, 0.72); }
  .rpe-image-dialog-shell { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100%; }
  .rpe-image-dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 12px 14px; border-bottom: 1px solid rgba(0, 0, 0, 0.12); }
  .rpe-image-dialog-header h2 { margin: 0; font-size: 16px; line-height: 1.2; }
  .rpe-image-dialog-close { padding: 7px 11px; border: 1px solid #000; border-radius: 999px; background: #000; color: #fff; cursor: pointer; font: inherit; font-size: 12px; font-weight: 800; }
  .rpe-image-dialog-close:hover, .rpe-image-dialog-close:focus-visible { background: #fff; color: #000; }
  .rpe-image-dialog-close:focus-visible { outline: 3px solid rgba(0, 0, 0, 0.24); outline-offset: 3px; }
  .rpe-image-dialog-tools { display: none; }
  .rpe-image-dialog-tools button, .rpe-image-dialog-tools output { display: inline-grid; min-width: 34px; min-height: 32px; place-items: center; padding: 5px 9px; border: 1px solid rgba(0, 0, 0, 0.2); border-radius: 999px; background: #fff; color: #000; font: inherit; font-size: 12px; font-weight: 800; }
  .rpe-image-dialog-tools button { cursor: pointer; }
  .rpe-image-dialog-tools button:hover, .rpe-image-dialog-tools button:focus-visible { background: #000; color: #fff; }
  .rpe-image-dialog-tools button:disabled { cursor: not-allowed; opacity: 0.4; }
  .rpe-image-dialog-tools button:focus-visible { outline: 3px solid rgba(0, 0, 0, 0.24); outline-offset: 3px; }
  .rpe-image-dialog-viewport { min-width: 0; min-height: 0; overflow: auto; padding: 12px; overscroll-behavior: contain; touch-action: pan-x pan-y pinch-zoom; -webkit-overflow-scrolling: touch; }
  .rpe-image-pan-surface { width: 100%; min-width: 0; }
  .rpe-image-pan-surface img { display: block; width: 100%; min-width: 0; max-width: none; height: auto; cursor: zoom-in; }
  .rpe-image-dialog-viewport.is-dragging { cursor: grabbing; }
  @media (max-width: 720px) { .rpe-image-expand-hint { display: grid; position: absolute; right: 10px; bottom: 10px; place-items: center; width: 34px; height: 34px; border: 1px solid rgba(0, 0, 0, 0.18); border-radius: 10px; background: rgba(255, 255, 255, 0.92); box-shadow: 0 3px 10px rgba(0, 0, 0, 0.16); color: #000; } .rpe-image-expand-hint svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; } .rpe-image-dialog { width: 100vw; max-width: none; height: 100vh; max-height: none; border: 0; border-radius: 0; } .rpe-image-dialog-header { display: grid; grid-template-columns: minmax(0, 1fr) auto; } .rpe-image-dialog-tools { display: flex; grid-column: 1 / -1; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px; } .rpe-image-dialog-viewport { display: grid; place-items: center; padding: 10px; } .rpe-image-dialog-viewport.is-zoomed { display: flex; align-items: center; justify-content: flex-start; overflow-x: scroll; overflow-y: auto; } .rpe-image-dialog-viewport.is-zoomed .rpe-image-pan-surface { flex: 0 0 auto; margin: 0; } .rpe-image-dialog-viewport img { min-width: 0; max-width: 100%; max-height: 100%; object-fit: contain; } }
  .gf-page { display: flex; flex-direction: column; gap: 26px; padding: 34px 34px 44px; }
  .gf-section-title { margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.08; letter-spacing: -0.03em; }
  .gf-section-note, .gf-question-help { margin: 0; color: #4b4b4b; line-height: 1.62; }
