        nextBtn.hidden = pageIndex === pages.length - 1;
        submitBtn.hidden = pageIndex !== pages.length - 1;
        progress.style.width = (((pageIndex + 1) / pages.length) * 100) + "%";
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
      function showSubmittedState() {
        document.body.classList.add("is-submitted");
        pages.forEach((page) => page.classList.remove("is-active"));
        if (successPanel) successPanel.hidden = false;
        prevBtn.hidden = true;
        nextBtn.hidden = true;
        submitBtn.hidden = true;
        submitBtn.disabled = true;
        returnEoiBtn.hidden = false;
        statusEl.textContent = "";
      }
      function validateCurrentPage() {
        clearValidationWarnings(pages[pageIndex]);
        let firstInvalidControl = null;
        const controls = Array.from(pages[pageIndex].querySelectorAll("input, select, textarea"))
          .filter((control) => !control.closest(".gf-conditional:not(.is-visible), [data-show-if]:not(.is-visible), [data-show-if-any]:not(.is-visible), [data-show-unless]:not(.is-visible), [data-show-when-answered]:not(.is-visible), [data-show-when-any-answered]:not(.is-visible), [data-show-when-all-answered]:not(.is-visible), [data-show-when-breathing-followup]:not(.is-visible), [hidden]"));
        for (const control of controls) {
          if (!control.checkValidity()) {
            showValidationWarning(control);
            if (!firstInvalidControl) firstInvalidControl = control;
          }
        }
        const currentSignatureMode = signatureNotice?.dataset.signatureCurrentMode || "";
        const hasCurrentSignature = signatureNotice?.dataset.signatureValid === "true"
          && (currentSignatureMode === "draw" || currentSignatureMode === "typed")
          && signatureInput.value.startsWith("data:image/png;base64,");
        if (pageIndex === 0 && healthInformationConsentInput?.checked && !hasCurrentSignature) {
          showValidationWarning(signatureInput);
          if (!firstInvalidControl) firstInvalidControl = signatureInput;
        }
        if (firstInvalidControl) {
          const target = firstInvalidControl === signatureInput ? signatureValidationTarget() : firstInvalidControl;
          target?.focus({ preventScroll: true });
          target?.scrollIntoView({ block: "center", behavior: "smooth" });
          return false;
        }
        return true;
      }
      function calculateScores(answers) {
        const apssRiskScore = [
          answers.heartConditionStroke === "Yes",
          answers.chestPainDiscomfort === "Yes",
          answers.urgentBreathingCare12m === "Yes",
          answers.asthmaAttackMedicalAttention12m === "Yes",
          answers.unexpectedBreathingEmergency12m === "Yes",
          answers.anyConditionBreathingEmergency12m === "Yes",
          Array.isArray(answers.diabetesGlucoseControl3m) ? answers.diabetesGlucoseControl3m.some((v) => String(v).includes("Difficulty")) : false,
          Array.isArray(answers.bloodSugarControl3m) ? answers.bloodSugarControl3m.some((v) => String(v).includes("Difficulty")) : String(answers.bloodSugarControl3m || "").includes("Difficulty")
        ].filter(Boolean).length;
        const borderlineApssRiskScore = answers.dizzyBalanceEpisodes && answers.dizzyBalanceEpisodes !== "No" ? 1 : 0;
        const injuryPainDetailsRequired = Array.isArray(answers.injuryPainStatus)
          && answers.injuryPainStatus.some((value) => value !== "No issues");
        return {
          apssRiskScore,
          borderlineApssRiskScore,
          dizzyDetailsRequired: answers.dizzyShareMore === "Yes",
          dizzyDetailsProvided: Boolean(answers.dizzyEpisodeDetails),
          dizzyMoreInformationRequired: answers.dizzyShareFurther === "Yes",
          dizzyMoreInformationProvided: Boolean(answers.dizzyMoreInformation),
          dizzyAdditionalInformationRequired: answers.dizzyShareAnythingElse === "Yes",
          dizzyAdditionalInformationProvided: Boolean(answers.dizzyAdditionalInformation),
          breathingTriggerDetailsRequired: answers.breathingTriggersKnown === "Yes",
          breathingTriggerDetailsProvided: Boolean(answers.breathingTriggerDetails),
          injuryPainDetailsRequired,
          injuryPainDetailsProvided: Boolean(answers.injuryPainDetails)
        };
      }
      function getAllAnswers() {
        const answers = {};
        Object.keys(CRM_FIELD_MAP).forEach((name) => {
          if (![
            "apssRiskScore",
            "borderlineApssRiskScore",
            "dizzyDetailsRequired",
            "dizzyDetailsProvided",
            "dizzyMoreInformationRequired",
            "dizzyMoreInformationProvided",
            "dizzyAdditionalInformationRequired",
            "dizzyAdditionalInformationProvided",
            "breathingTriggerDetailsRequired",
            "breathingTriggerDetailsProvided",
            "injuryPainDetailsRequired",
            "injuryPainDetailsProvided"
          ].includes(name)) answers[name] = getValue(name);
        });
        const calculatedFields = calculateScores(answers);
        return Object.assign(answers, calculatedFields);
      }
      function buildConditionalFollowups(answers) {
        return [
          {
            sourceField: "dizzyShareMore",
            sourceQuestion: "Would you like to share any additional information about these episodes?",
            triggerAnswer: "Yes",
            triggered: answers.dizzyShareMore === "Yes",
            requiredField: "dizzyEpisodeDetails",
            requiredQuestion: "Add more information",
            answered: Boolean(answers.dizzyEpisodeDetails),
            value: answers.dizzyEpisodeDetails || ""
          },
          {
            sourceField: "dizzyShareFurther",
            sourceQuestion: "Would you like to let us know anything further about these episodes?",
            triggerAnswer: "Yes",
            triggered: answers.dizzyShareFurther === "Yes",
            requiredField: "dizzyMoreInformation",
            requiredQuestion: "Further information",
            answered: Boolean(answers.dizzyMoreInformation),
            value: answers.dizzyMoreInformation || ""
          },
          {
            sourceField: "dizzyShareAnythingElse",
            sourceQuestion: "Is there anything else you'd like to tell us about these episodes?",
            triggerAnswer: "Yes",
            triggered: answers.dizzyShareAnythingElse === "Yes",
            requiredField: "dizzyAdditionalInformation",
            requiredQuestion: "More information",
            answered: Boolean(answers.dizzyAdditionalInformation),
            value: answers.dizzyAdditionalInformation || ""
          },
          {
            sourceField: "breathingTriggersKnown",
            sourceQuestion: "Are you aware of any triggers, patterns, or environments that bring symptoms on or make them worse?",
            triggerAnswer: "Yes",
            triggered: answers.breathingTriggersKnown === "Yes",
            requiredField: "breathingTriggerDetails",
            requiredQuestion: "Please share any specific triggers or factors",
            answered: Boolean(answers.breathingTriggerDetails),
            value: answers.breathingTriggerDetails || ""
          },
          {
            sourceField: "injuryPainStatus",
            sourceQuestion: "Do you have any past injuries, current conditions, occasional or chronic pain, or a body area that just isn’t 100% that may affect how you move during sessions or recover afterward?",
            triggerAnswer: "Any injury, pain, chronic condition, or something else",
            triggered: Boolean(answers.injuryPainDetailsRequired),
            requiredField: "injuryPainDetails",
            requiredQuestion: "Please provide relevant details",
            answered: Boolean(answers.injuryPainDetails),
            value: answers.injuryPainDetails || ""
          }
        ];
      }
      function buildSubmissionPayload() {
        const answers = getAllAnswers();
        const normalizedAnswers = Object.entries(answers).map(([fieldName, value]) => ({ fieldName, crmFieldName: CRM_FIELD_MAP[fieldName] || fieldName, value, sensitivityClass: "health" }));
        const calculatedFields = {
          apssRiskScore: answers.apssRiskScore,
          borderlineApssRiskScore: answers.borderlineApssRiskScore,
          dizzyDetailsRequired: answers.dizzyDetailsRequired,
          dizzyDetailsProvided: answers.dizzyDetailsProvided,
          dizzyMoreInformationRequired: answers.dizzyMoreInformationRequired,
          dizzyMoreInformationProvided: answers.dizzyMoreInformationProvided,
          dizzyAdditionalInformationRequired: answers.dizzyAdditionalInformationRequired,
          dizzyAdditionalInformationProvided: answers.dizzyAdditionalInformationProvided,
          breathingTriggerDetailsRequired: answers.breathingTriggerDetailsRequired,
          breathingTriggerDetailsProvided: answers.breathingTriggerDetailsProvided,
          injuryPainDetailsRequired: answers.injuryPainDetailsRequired,
          injuryPainDetailsProvided: answers.injuryPainDetailsProvided
        };
        const conditionalFollowups = buildConditionalFollowups(answers);
        return {
          formId: CONFIG.formId,
          formPart: CONFIG.formPart,
          formVersion: CONFIG.formVersion,
          submissionID: "HP-" + Date.now() + "-" + Math.random().toString(36).slice(2, 8).toUpperCase(),
          submittedAt: new Date().toISOString(),
          memberEmail: null,
          wixMemberID: null,
          crmContactID: null,
          source: "astro_member_portal_health_profile",
          riskSummary: {
            apssRiskScore: answers.apssRiskScore,
            borderlineApssRiskScore: answers.borderlineApssRiskScore,
            injuryPainFlag: Array.isArray(answers.injuryPainStatus) && !answers.injuryPainStatus.includes("No issues") && answers.injuryPainStatus.length > 0
          },
          calculatedFields,
          conditionalFollowups,
          answers,
          normalizedAnswers
        };
      }
      async function submitPayload() {
        const response = await fetch(CONFIG.submitEndpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify(arguments[0])
        });
        const result = await response.json().catch(() => null);
        const canonicalSubmissionID = typeof result?.submissionID === "string" ? result.submissionID.trim() : "";
        const canonicalSuccess = /^eoi-p2-submission-[0-9a-f]{64}$/.test(canonicalSubmissionID);
        if (!response.ok || result?.ok !== true || !canonicalSuccess) throw new Error("Submission failed.");
        return { ...result, submissionID: canonicalSubmissionID };
      }
      initRequiredState();
      if (healthInformationDateInput && !healthInformationDateInput.value) healthInformationDateInput.value = localISODate();
      showPage(0);
      setConditionalVisibility();
      setSignatureVisibility();
      window.addEventListener("gymfusion:signature-change", (event) => {
        updateSignatureInputs(event.detail?.signature || null);
      });
      signatureModeButtons.forEach((button) => button.addEventListener("click", () => setSignatureMode(button.dataset.signatureMode)));
      signatureFontButtons.forEach((button) => button.addEventListener("click", () => {
        selectedSignatureFont = button.dataset.signatureFont || "Pacifico";
        signatureFontButtons.forEach((fontButton) => fontButton.setAttribute("aria-pressed", String(fontButton === button)));
        if (signatureMode !== "typed") setSignatureMode("typed");
        else void renderTypedSignature();
      }));
      const nameInputs = [firstNameInput, lastNameInput].filter(Boolean);
      nameInputs.forEach((input) => ["input", "change", "blur"].forEach((eventName) => input.addEventListener(eventName, () => {
        sanitizeNameInput(input);
        if (signatureMode === "typed") void renderTypedSignature();
      })));
      nameInputs.forEach(sanitizeNameInput);
      clearSignatureBtn?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("gymfusion:signature-clear"));
        if (signatureMode === "typed") {
          typedSignatureRenderVersion += 1;
          if (typedSignaturePreview) typedSignaturePreview.textContent = "";
          updateSignatureInputs(null);
        }
        clearValidationWarnings(document.querySelector("[data-signature-field]") || form);
      });
      form.addEventListener("change", () => {
        setConditionalVisibility();
        setSignatureVisibility();
      });
      form.addEventListener("input", () => {
        setConditionalVisibility();
        setSignatureVisibility();
      });
      form.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        if (target.tagName === "TEXTAREA" || target.tagName === "BUTTON" || target.isContentEditable) return;
        event.preventDefault();
      });
      prevBtn.addEventListener("click", () => showPage(pageIndex - 1));
      nextBtn.addEventListener("click", () => { setConditionalVisibility(); if (validateCurrentPage()) showPage(pageIndex + 1); });
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        nameInputs.forEach(sanitizeNameInput);
        setConditionalVisibility();
        if (!validateCurrentPage()) return;
        let payload;
        try {
          payload = buildSubmissionPayload();
        } catch (error) {
          statusEl.textContent = error.message;
          return;
        }
        submitBtn.disabled = true;
        statusEl.textContent = "Validating...";
        try {
          const result = await submitPayload(payload);
          if (result.submissionID) showSubmittedState();
        } catch (error) {
          console.error(error);
          statusEl.textContent = "Submission failed. Please check your connection or contact GYMFUSION staff.";
          submitBtn.disabled = false;
        }
      });
    })();
  </script>
