---
import HealthInformationNotice from "../../components/HealthInformationNotice.astro";
import { loadPortalPage } from "../../lib/portal-page";
import { hasCompletedPart2 } from "../../lib/eoi-part-2-completion";
import { readMemberPortalView } from "../../lib/member-portal-read";
import { env } from "cloudflare:workers";

const isDevelopmentPreview = import.meta.env.DEV;
const showSuccessPreview = isDevelopmentPreview && Astro.url.searchParams.get("preview") === "success";
const session = isDevelopmentPreview
  ? { kind: "authenticated" as const, displayName: "Preview Member" }
  : await loadPortalPage(Astro.request, Astro.locals);
if (session.kind === "redirect") return new Response(null, { status: 303, headers: { Location: "/login", "Cache-Control": "no-store" } });
if (session.kind === "unavailable") return new Response("Members Portal is temporarily unavailable.", { status: 503, headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "no-store" } });
const eoiRead = !isDevelopmentPreview && session.kind === "authenticated" && env.MEMBER_LOGIN_SERVICE_URL
  ? await readMemberPortalView(Astro.request, env.MEMBER_LOGIN_SERVICE_URL, "eoi")
  : null;
const part2AlreadyFinal = showSuccessPreview || (eoiRead?.kind === "authenticated" && hasCompletedPart2(eoiRead.data));
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GYMFUSION Member Portal | Health Profile</title>
<style is:global>
    /*
      GYMFUSION HEALTH PROFILE - ASTRO MEMBER PORTAL
      Version: v1.1 target-state frontend
      Purpose: EOI Part 2 - Health Profile
      Backend target: approved server-side boundary to authoritative Wix services

      IMPORTANT:
      1. Complete authenticated server-side submission integration before production.
      2. Keep health data out of Member profile fields; send to the approved EOI Parts 2-4 collections only.
    */

    @font-face {
      font-family: "Gamuth";
      src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Regular.ttf") format("truetype");
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: "Gamuth";
      src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Bold.ttf") format("truetype");
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --gf-bg: #f5f5f5;
      --gf-bg-accent: #ffffff;
      --gf-text: #000000;
      --gf-muted: #4b4b4b;
      --gf-line: rgba(0, 0, 0, 0.16);
      --gf-line-strong: rgba(0, 0, 0, 0.86);
      --gf-soft: #fafafa;
      --gf-focus: #000000;
      --gf-radius: 24px;
      --gf-shadow: 0 24px 70px rgba(0, 0, 0, 0.08);
      --gf-shadow-soft: 0 1px 2px rgba(0, 0, 0, 0.04), 0 10px 24px rgba(0, 0, 0, 0.04);
      --gf-font: "Gamuth", Arial, Helvetica, sans-serif;
      --gf-space-1: 8px;
      --gf-space-2: 12px;
      --gf-space-3: 16px;
      --gf-space-4: 20px;
      --gf-space-5: 24px;
      --gf-space-6: 32px;
      --gf-page-gap: 26px;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      background: radial-gradient(circle at top, #ffffff 0%, #f7f7f7 44%, #eeeeee 100%);
      color: var(--gf-text);
      font-family: var(--gf-font);
      line-height: 1.55;
      overflow-x: hidden;
      overflow-y: auto;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    body { padding: 0; }

    .gf-wrap {
      width: min(940px, 100%);
      margin: 0 auto;
      padding: 20px;
    }

    .gf-shell {
      border: 1px solid var(--gf-line);
      border-radius: 34px;
      background: linear-gradient(180deg, #ffffff 0%, #fcfcfc 100%);
      box-shadow: var(--gf-shadow);
      overflow: hidden;
    }

    .gf-header {
      padding: 34px 34px 30px;
      border-bottom: 1px solid var(--gf-line);
      background: #fff;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .gf-kicker {
      display: inline-flex;
      align-self: center;
      width: fit-content;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--gf-line);
      border-radius: 999px;
      min-height: 34px;
      padding: 6px 16px 5px;
      font-size: 11.5px;
      letter-spacing: 0.085em;
      text-transform: uppercase;
      font-weight: 700;
      line-height: 1;
      text-align: center;
      margin-bottom: 0;
      white-space: nowrap;
    }

    .gf-header .gf-kicker { margin-bottom: 6px; }

    h1, h2, h3, p { margin: 0; }

    h1 {
      font-size: clamp(32px, 5.5vw, 60px);
      line-height: 0.95;
      letter-spacing: -0.01em;
    }

    .gf-intro {
      color: var(--gf-muted);
      max-width: 800px;
      margin: 10px 0 0;
      font-size: 16px;
      line-height: 1.62;
      font-weight: 500;
    }

    .gf-progress {
      height: 6px;
      background: #f0f0f0;
      border-bottom: 1px solid var(--gf-line);
    }

    .gf-progress > span {
      display: block;
      height: 100%;
      width: 0%;
      background: #000;
      transition: width 220ms ease;
    }

    form { margin: 0; }

    .gf-page { display: none; padding: 34px 34px 44px; }
    .gf-page.is-active {
      display: flex;
      flex-direction: column;
      gap: var(--gf-page-gap);
    }

    .gf-page[data-page="2"].is-active {
      gap: 38px;
    }

    .gf-page[data-page="2"] .gf-card {
      margin-bottom: 24px;
    }

    .gf-page[data-page="2"] fieldset > .gf-choice-row {
      margin-top: 20px;
    }

    .gf-page[data-page="2"] .gf-followup-item > .gf-choice-row {
      margin-top: 12px;
      margin-bottom: 8px;
    }

    .gf-page[data-page="2"] .gf-conditional {
      margin-top: 8px;
      padding: 24px;
      gap: 30px;
    }

    .gf-page[data-page="2"] .gf-followup-stack {
      gap: 28px;
    }

    .gf-page[data-page="2"] .gf-followup-item {
      gap: 16px;
      padding-top: 24px;
    }

    .gf-section-title {
      font-size: clamp(26px, 3vw, 38px);
      line-height: 1.08;
      letter-spacing: -0.03em;
    }

    .gf-section-note {
      color: var(--gf-muted);
      max-width: 760px;
      line-height: 1.62;
      font-size: 16px;
    }

    .gf-card {
      border: 1px solid var(--gf-line);
      border-radius: 28px;
      padding: 30px;
      background: #fff;
      display: flex;
      flex-direction: column;
      gap: 24px;
      box-shadow: var(--gf-shadow-soft);
    }

    .gf-card.soft {
      background: linear-gradient(180deg, #fcfcfc 0%, #f7f7f7 100%);
      gap: 16px;
    }

    .gf-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .gf-signature-meta {
      position: relative;
      margin-bottom: 28px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .gf-signature-meta:has(.gf-datetimepicker-trigger[aria-expanded="true"]) {
      z-index: 90;
    }

    .gf-field {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    label, legend, .gf-question {
      display: block;
      font-weight: 800;
      color: #000;
      line-height: 1.4;
    }

    .gf-help {
      color: var(--gf-muted);
      font-size: 13px;
      line-height: 1.62;
    }

    input, select, textarea {
      width: 100%;
      border: 1.25px solid var(--gf-line);
      border-radius: 17px;
      background: #fff;
      color: #000;
      padding: 15px 16px;
      font: inherit;
      outline: none;
      transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }

    textarea { min-height: 120px; resize: vertical; }

    input:focus, select:focus, textarea:focus {
      border-color: var(--gf-line-strong);
      box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.08);
    }

    fieldset {
      border: 0;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    fieldset > .gf-choice-row {
      margin-top: 20px;
    }

    fieldset > .gf-conditional {
      margin-top: 12px;
    }

    fieldset > .gf-other-condition {
      margin-top: 20px;
    }

    .gf-choice-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .gf-choice {
      position: relative;
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 58px;
      border: 1.25px solid var(--gf-line);
      border-radius: 18px;
      padding: 14px 16px;
      cursor: pointer;
      background: #fff;
      color: #111;
      font-size: 13px;
      font-weight: 700;
      margin: 0;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
      transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
    }

    .gf-choice.gf-consent-choice { font-size: 14px; font-weight: 500; }
    .gf-choice.gf-consent-choice span { font-weight: 500; }

    .gf-page[data-page="1"] .gf-choice { font-size: 10px; }

    [data-signature-field][hidden] { display: none; }

    .gf-choice:hover {
      border-color: rgba(0, 0, 0, 0.36);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
      transform: translateY(-1px);
    }

    .gf-choice input {
      width: 18px;
      height: 18px;
      accent-color: #000;
      flex: 0 0 auto;
    }

    .gf-choice:has(input:checked) {
      background: #000;
      color: #fff;
      border-color: #000;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.16);
    }

    .gf-choice:has(input:checked) *,
    .gf-choice:has(input:checked) label,
    .gf-choice:has(input:checked) span {
      color: #fff !important;
    }

    .gf-choice:has(input:checked) input {
      accent-color: #fff;
    }

    .gf-conditional {
      display: none;
      margin-top: 0;
      padding: 22px;
      border: 1px dashed rgba(0, 0, 0, 0.45);
      border-radius: 22px;
      background: linear-gradient(180deg, #ffffff 0%, #fcfcfc 100%);
      flex-direction: column;
      gap: 30px;
    }

    .gf-conditional.is-visible {
      display: flex;
    }

    .gf-followup-heading {
      margin: 0;
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: -0.01em;
      font-weight: 800;
    }

    .gf-followup-note {
      margin: 0;
      color: var(--gf-muted);
      line-height: 1.5;
    }

    .gf-followup-stack {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .gf-followup-item > .gf-choice-row {
      margin-top: 12px;
      margin-bottom: 8px;
    }

    .gf-followup-flow {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .gf-followup-section {
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding-top: 28px;
      border-top: 1px solid rgba(0, 0, 0, 0.12);
    }

    div.gf-followup-section.is-visible {
      display: flex;
    }

    .gf-followup-section:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .gf-followup-section-title {
      margin: 0;
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: -0.01em;
      font-weight: 800;
    }

    .gf-followup-section-note {
      margin: 0;
      color: var(--gf-muted);
      line-height: 1.5;
    }

    .gf-followup-item {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding-top: 24px;
      border-top: 1px solid rgba(0, 0, 0, 0.12);
    }

    .gf-conditional .gf-field {
      gap: 14px;
    }

    .gf-conditional .gf-field > .gf-choice-row {
      margin-top: 10px;
      margin-bottom: 8px;
    }

    .gf-followup-item:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .gf-skip-toggle {
      margin-top: var(--gf-space-2);
    }

    [data-show-if],
    [data-show-if-any],
    [data-show-unless],
    [data-show-when-answered],
    [data-show-when-any-answered],
    [data-show-when-all-answered],
    [data-show-when-breathing-followup] {
      display: none;
    }

    [data-show-if].is-visible,
    [data-show-if-any].is-visible,
    [data-show-unless].is-visible,
    [data-show-when-answered].is-visible,
    [data-show-when-any-answered].is-visible,
    [data-show-when-all-answered].is-visible,
    [data-show-when-breathing-followup].is-visible {
      display: block;
    }

    .gf-conditional.is-visible,
    .gf-field.is-visible {
      display: flex;
    }

    .gf-followup-flow.is-visible,
    .gf-followup-item.is-visible {
      display: flex;
    }

    .gf-alert {
      border: 1px solid #000;
      border-radius: 18px;
      padding: 18px;
      background: #000;
      color: #fff;
      margin: 18px 0;
      display: none;
      flex-direction: column;
      gap: 8px;
    }

    .gf-alert.is-visible { display: block; }

    .gf-alert strong { display: block; margin-bottom: 6px; }

    .gf-error {
      display: none;
      margin-top: 4px;
      color: #b00020;
      font-size: 13px;
      font-weight: 700;
    }

    .gf-error.is-visible { display: block; }

    .gf-required-indicator {
      margin-left: 2px;
      color: #b00020;
    }

    .gf-visually-hidden {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }
    .gf-member-lock {
      display: none;
      margin: 0 28px 24px;
      padding: 14px 16px;
      border: 1px solid rgba(0, 0, 0, 0.14);
      border-radius: 14px;
      background: #fafafa;
      color: #111;
      font-size: 14px;
      font-weight: 700;
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.04);
    }
    .gf-member-lock.is-visible { display: block; }

    .gf-success-panel {
      display: grid;
      justify-items: center;
      gap: 16px;
      width: min(100%, 620px);
      margin: auto;
      padding: clamp(34px, 7vw, 64px) clamp(24px, 6vw, 56px);
      border: 1px solid rgba(0, 0, 0, 0.14);
      border-radius: 30px;
      background: linear-gradient(145deg, #fafafa 0%, #fff 52%, #f1f1f1 100%);
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.08);
      text-align: center;
    }

    .gf-success-panel[hidden] { display: none; }
    .gf-success-mark { display: grid; place-items: center; width: 68px; height: 68px; border: 2px solid #000; border-radius: 50%; background: #000; color: #fff; }
    .gf-success-mark svg { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2.5; }
    .gf-success-kicker { color: #666; font-size: 11px; font-weight: 800; letter-spacing: 0.14em; line-height: 1.2; }
    .gf-success-panel h2 { max-width: 470px; margin: 0; font-size: clamp(26px, 4vw, 42px); line-height: 1.05; letter-spacing: -0.03em; }
    body.is-submitted .gf-header, body.is-submitted .gf-progress { display: none; }
    body.is-submitted .gf-shell { display: flex; flex-direction: column; justify-content: center; min-height: calc(100svh - 40px); border: 0; background: transparent; box-shadow: none; }
    body.is-submitted form { display: flex; flex-direction: column; justify-content: center; min-height: calc(100svh - 40px); }
    body.is-submitted form .gf-page { display: contents; }
    body.is-submitted .gf-success-panel { margin: 0 auto 22px; }
    body.is-submitted .gf-nav { width: 100%; border-top: 0; background: transparent; justify-content: center; }
    body.is-submitted .gf-nav-actions { margin-left: 0; }
    body.is-submitted .gf-nav-button--dashboard { border-color: #000; background: #000; color: #fff; }
    body.is-submitted .gf-nav-button--dashboard:hover, body.is-submitted .gf-nav-button--dashboard:focus-visible { background: #fff; color: #000; }
    @media (max-width: 720px) {
      body.is-submitted .gf-shell { min-height: calc(100svh - 20px); }
      body.is-submitted .gf-nav { margin-top: 0; }
      body.is-submitted .gf-nav-actions { width: auto; }
      body.is-submitted .gf-nav-button--dashboard { width: min(100%, 220px); min-width: 0; min-height: 44px; padding: 11px 24px; }
    }

    .gf-invalid {
      border-color: #b00020 !important;
      box-shadow: 0 0 0 4px rgba(176, 0, 32, 0.12);
    }

    .gf-signature-pad {
      border: 1.25px solid var(--gf-line);
      border-radius: 20px;
      background: #fff;
      min-height: 198px;
      overflow: hidden;
      touch-action: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }

    .gf-signature-field > .gf-question {
      margin: 12px 0;
      font-size: 18px;
      line-height: 1.25;
    }

    .gf-signature-method {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 0 0 16px;
    }

    .gf-signature-method legend,
    .gf-signature-font-label {
      color: var(--gf-muted);
      font-size: 14px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .gf-signature-method legend {
      margin: 0 0 4px;
    }

    .gf-signature-method-options,
    .gf-signature-font-options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .gf-signature-mode,
    .gf-signature-font {
      min-height: 52px;
      padding: 10px 16px;
      border: 1.25px solid var(--gf-line);
      border-radius: 17px;
      background: #fff;
      color: #000;
      font: inherit;
      cursor: pointer;
      transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
    }

    .gf-signature-mode { font-size: 15px; }

    .gf-signature-mode:hover,
    .gf-signature-mode:focus-visible,
    .gf-signature-font:hover,
    .gf-signature-font:focus-visible,
    .gf-signature-mode[aria-pressed="true"],
    .gf-signature-font[aria-pressed="true"] {
      border-color: #000;
      box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.08);
      outline: none;
    }

    .gf-signature-mode[aria-pressed="true"],
    .gf-signature-font[aria-pressed="true"] {
      background: #000;
      color: #fff;
    }

    .gf-signature-font-picker {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 2px;
    }

    .gf-signature-font-picker[hidden] {
      display: none;
    }

    .gf-signature-font-options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .gf-signature-font {
      min-height: 58px;
      font-size: 22px;
      line-height: 1;
    }

    .gf-signature-font[data-signature-font="GF Byron"] { font-size: 28px; }
    .gf-signature-font[data-signature-font="GF Indian Dunes"] { font-size: 28px; }
    .gf-signature-font[data-signature-font="GF Black William"] { font-size: 28px; }
    .gf-signature-font[data-signature-font="GF Black William"] { font-family: "GF Black William", "Pacifico", "Segoe Script", "Bradley Hand", "URW Chancery L", cursive; font-weight: 400; }

    .gf-typed-signature-preview {
      display: grid;
      min-height: 198px;
      place-items: center;
      padding: 24px;
      color: #111;
      font-size: clamp(38px, 6vw, 64px);
      line-height: 1.1;
      text-align: center;
      overflow-wrap: anywhere;
    }

    .gf-typed-signature-preview[hidden] {
      display: none;
    }

    .gf-signature-pad canvas {
      display: block;
      width: 100%;
      height: 198px;
      cursor: -webkit-image-set(
        url("https://cdn.sweezy-cursors.com/cursor_packs/2b1d5bd8-9c8c-4b51-90fb-bb428b14f0f3/fountain-pen-pen-nib-3d--cursor-image.png") 4x
      ) 1 1, crosshair;
      cursor: image-set(
        url("https://cdn.sweezy-cursors.com/cursor_packs/2b1d5bd8-9c8c-4b51-90fb-bb428b14f0f3/fountain-pen-pen-nib-3d--cursor-image.png") 4x
      ) 1 1, crosshair;
      touch-action: none;
      user-select: none;
    }

    .gf-signature-pad canvas[hidden] {
      display: none !important;
    }

    .gf-signature-pad canvas:focus-visible {
      outline: 3px solid var(--gf-green);
      outline-offset: -5px;
    }

    .gf-signature-actions {
      display: flex;
      justify-content: flex-start;
      margin-top: 8px;
    }

    .gf-signature-clear {
      border: 0;
      padding: 0;
      color: var(--gf-muted);
      background: transparent;
      font: inherit;
      font-size: 14px;
      text-decoration: underline;
      cursor: pointer;
    }

    .gf-signature-clear:hover {
      color: var(--gf-text);
    }

    .gf-signature-clear:focus-visible {
      outline: 3px solid var(--gf-green);
      outline-offset: 4px;
    }

    .gf-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      padding: 24px 30px 30px;
      border-top: 1px solid var(--gf-line);
    }

    .gf-nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-left: auto;
    }

    .gf-nav-button {
      min-width: 144px;
      min-height: 50px;
      padding: 14px 24px;
      border: 1.25px solid rgba(0, 0, 0, 0.16);
      border-radius: 999px;
      background: #fff;
      color: #000;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.05);
      transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    }

    .gf-nav-button--back { background: #fff; color: #000; }
    .gf-nav-button--next { background: #000; color: #fff; }

    .gf-nav-button--dashboard {
      border-color: #000;
      background: #000;
      color: #fff;
    }

    .gf-nav-button--dashboard[hidden] { display: none; }

    a.gf-nav-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
    }

    .gf-nav-button:hover,
    .gf-nav-button:active {
      background: #000;
      color: #fff;
      box-shadow: 0 14px 26px rgba(0, 0, 0, 0.14);
    }

    .gf-nav-button--next:hover,
    .gf-nav-button--next:active {
      background: #fff;
      color: #000;
    }

    .gf-nav-button:active { transform: translateY(1px); }

    .gf-status {
      min-height: 24px;
      padding: 0 30px 26px;
      font-size: 14px;
      color: var(--gf-muted);
    }

    .gf-small { font-size: 13px; color: var(--gf-muted); }

    @media (max-width: 720px) {
      .gf-wrap { padding: 10px; }
      .gf-header { padding: 18px; }
      .gf-page { padding: 18px 18px 28px; }
      .gf-grid, .gf-choice-row { grid-template-columns: 1fr; }
      .gf-nav { margin-top: 14px; padding: 18px 18px 22px; }
      .gf-nav-actions { width: 100%; }
      .gf-nav-button { width: 100%; }
    }

    body.gf-embed-mobile .gf-wrap {
      width: 100%;
      padding: 8px;
    }

    body.gf-embed-mobile .gf-shell {
      border-radius: 24px;
    }

    body.gf-embed-mobile .gf-header,
    body.gf-embed-mobile .gf-page {
      padding: 18px;
    }

    body.gf-embed-mobile .gf-page[data-page="2"].is-active {
      gap: 32px;
    }

    body.gf-embed-mobile .gf-page[data-page="2"] .gf-card {
      margin-bottom: 26px;
    }

    body.gf-embed-mobile .gf-page[data-page="2"] fieldset > .gf-choice-row {
      margin-top: 20px;
    }

    body.gf-embed-mobile .gf-page[data-page="2"] .gf-followup-item > .gf-choice-row {
      margin-top: 10px;
      margin-bottom: 6px;
    }

    body.gf-embed-mobile .gf-page[data-page="2"] .gf-conditional {
      margin-top: 10px;
      padding: 22px;
      gap: 26px;
    }

    body.gf-embed-mobile .gf-page[data-page="2"] .gf-followup-stack {
      gap: 24px;
    }

    body.gf-embed-mobile .gf-page[data-page="2"] .gf-followup-item {
      gap: 14px;
      padding-top: 22px;
    }

    body.gf-embed-mobile .gf-grid,
    body.gf-embed-mobile .gf-choice-row {
      grid-template-columns: 1fr;
    }

    body.gf-embed-mobile .gf-nav {
      margin-top: 14px;
      padding: 16px 18px 20px;
    }

    body.gf-embed-mobile .gf-nav-actions {
      width: 100%;
    }

    body.gf-embed-mobile .gf-nav-button {
      width: 100%;
    }

    body.gf-embed-desktop .gf-wrap {
      width: 878px;
      max-width: 100%;
      height: 1039px;
      max-height: 100vh;
      padding: 0;
    }

    body.gf-embed-desktop .gf-shell {
      width: 100%;
      height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      box-shadow: none;
    }

    body.gf-embed-desktop {
      font-size: 17px;
    }

    body.gf-embed-desktop label,
    body.gf-embed-desktop legend {
      font-size: 17px;
      line-height: 1.45;
      font-weight: 800;
    }

    body.gf-embed-desktop p,
    body.gf-embed-desktop .gf-help,
    body.gf-embed-desktop .gf-section-note {
      color: #333;
      line-height: 1.6;
    }

    @media (prefers-reduced-motion: reduce) {
      .gf-choice,
      .gf-nav-button,
      input,
      select,
      textarea,
      .gf-progress > span {
        transition: none;
      }
    }
  </style>
</head>
<body class={part2AlreadyFinal ? "is-submitted" : undefined}>
  <div class="gf-wrap">
    <div class="gf-shell" data-gf-form-shell>
      <header class="gf-header">
        <span class="gf-kicker">EOI PART 2</span>
        <h1>Health Profile</h1>
        <p class="gf-intro">Complete this profile so GYMFUSION can support safe and appropriate coaching. This information is treated as private health information and is intended for staff review only.</p>
      </header>

      <div class="gf-progress" aria-hidden="true"><span data-progress></span></div>
      {part2AlreadyFinal ? (
        <>
          <section class="gf-success-panel" role="status" aria-labelledby="part-2-success-title">
            <div class="gf-success-mark" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></div>
            <span class="gf-success-kicker">SUBMISSION COMPLETE</span>
            <h2 id="part-2-success-title">Your Health Profile was submitted successfully.</h2>
          </section>
          <nav class="gf-nav" aria-label="Part 2 form actions">
            <div class="gf-nav-actions"><a class="gf-nav-button gf-nav-button--dashboard" href="/eoi">Return to Portal</a></div>
          </nav>
        </>
      ) : (
      <form id="gfHealthProfileForm" novalidate>
        <section class="gf-page is-active" data-page="0">
          <HealthInformationNotice controller={false} documentId="EOI-P2-HEALTH-PROFILE" fileNamePrefix="EOI-P2-HEALTH-NOTICE-SIGNATURE" />
        </section>

        <section class="gf-page" data-page="1">
          <h2 class="gf-section-title">EOI Part 2 - Health Profile</h2>
          <p class="gf-section-note">Pre-exercise Screening Questionnaire.</p>

          <div class="gf-card">
            <fieldset>
              <legend>Has your medical practitioner ever told you that you have a heart condition or have you ever suffered a stroke?</legend>
              <div class="gf-choice-row">
                <label class="gf-choice"><input type="radio" name="heartConditionStroke" value="No" required />No</label>
                <label class="gf-choice"><input type="radio" name="heartConditionStroke" value="Yes" />Yes</label>
              </div>
            </fieldset>
          </div>

          <div class="gf-card">
            <fieldset>
              <legend>Do you ever experience unexplained pains or discomfort in your chest at rest or during physical activity/exercise?</legend>
              <div class="gf-choice-row">
                <label class="gf-choice"><input type="radio" name="chestPainDiscomfort" value="No" required />No</label>
                <label class="gf-choice"><input type="radio" name="chestPainDiscomfort" value="Yes" />Yes</label>
              </div>
            </fieldset>
          </div>

          <div class="gf-card">
            <fieldset data-conditional-source="dizzyBalanceEpisodes">
              <legend>Do you ever feel faint, dizzy, or lose your balance during training or when changing posture (for example, standing up quickly or bending)?</legend>
              <div class="gf-choice-row">
                <label class="gf-choice"><input type="radio" name="dizzyBalanceEpisodes" value="No" required />No – I do not experience this</label>
                <label class="gf-choice"><input type="radio" name="dizzyBalanceEpisodes" value="Exercise only" />Yes – During training/exercise only</label>
                <label class="gf-choice"><input type="radio" name="dizzyBalanceEpisodes" value="Exercise and posture" />Yes – Both during exercise and with posture changes</label>
                <label class="gf-choice"><input type="radio" name="dizzyBalanceEpisodes" value="Varies" />Yes – I have experienced this, but the circumstances vary or I don't recall exactly when it happens</label>
              </div>
              <div class="gf-conditional" data-show-unless="dizzyBalanceEpisodes:No">
                <div class="gf-field" data-show-if="dizzyBalanceEpisodes:Exercise only">
                  <p class="gf-question">Would you like to share any additional information about these episodes?</p>
                  <div class="gf-choice-row">
                    <label class="gf-choice"><input type="radio" name="dizzyShareMore" value="Yes" />Yes –– I would like to share more information.</label>
                    <label class="gf-choice"><input type="radio" name="dizzyShareMore" value="No" />No thank-you –– I prefer not to provide further details.</label>
                  </div>
                </div>
                <div class="gf-field" data-show-if="dizzyShareMore:Yes">
                  <label for="dizzyEpisodeDetails">Further Information</label>
                  <p class="gf-help">Feel free to share things like: how long ago you experienced it (ballpark), how often it occurs (or if it’s a new or infrequent occurrence), whether it has ever caused you to faint, what kinds of exercises or fitness activities you were doing when it happened (e.g., heavy weights, upper‑body strength training, running), and whether it occurred in warm weather or across different temperatures.</p>
                  <textarea id="dizzyEpisodeDetails" name="dizzyEpisodeDetails" required></textarea>
                </div>
                <div class="gf-field" data-show-if="dizzyBalanceEpisodes:Varies">
                  <p class="gf-question">Would you like to let us know anything further about these episodes?</p>
                  <div class="gf-choice-row">
                    <label class="gf-choice"><input type="radio" name="dizzyShareFurther" value="Yes" />Yes –– I would like to share more information.</label>
                    <label class="gf-choice"><input type="radio" name="dizzyShareFurther" value="No" />No thank-you –– I prefer not to provide further details.</label>
                  </div>
                </div>
                <div class="gf-field" data-show-if="dizzyShareFurther:Yes">
                  <label for="dizzyMoreInformation">More Information</label>
                  <p class="gf-help">Feel free to share things like: how long ago you experienced it (ballpark), how often it occurs (or if it’s a new or infrequent occurrence), whether it has ever caused you to faint, what kinds of exercises or fitness activities you were doing when it happened (e.g., heavy weights, upper‑body strength training, running), what general activity you were doing at the time (such as standing, walking, stretching, or changing position), and whether it occurred in warm weather or across different temperatures.</p>
                  <textarea id="dizzyMoreInformation" name="dizzyMoreInformation" required></textarea>
                </div>
                <div class="gf-field" data-show-if="dizzyBalanceEpisodes:Exercise and posture">
                  <p class="gf-question">Is there anything else you'd like to tell us about these episodes?</p>
                  <div class="gf-choice-row">
                    <label class="gf-choice"><input type="radio" name="dizzyShareAnythingElse" value="Yes" />Yes –– I would like to share more information.</label>
                    <label class="gf-choice"><input type="radio" name="dizzyShareAnythingElse" value="No" />No thank-you –– I prefer not to provide further details.</label>
                  </div>
                </div>
                <div class="gf-field" data-show-if="dizzyShareAnythingElse:Yes">
                  <label for="dizzyAdditionalInformation">Add More Information</label>
                  <p class="gf-help">Feel free to share things like: how long ago you experienced it (ballpark), how often it occurs (or if it’s a new or infrequent occurrence), whether it has ever caused you to faint, what kinds of exercises or fitness activities you were doing when it happened (e.g., heavy weights, upper‑body strength training, running), and whether it occurred in warm weather or across different temperatures.</p>
                  <textarea id="dizzyAdditionalInformation" name="dizzyAdditionalInformation" required></textarea>
                </div>
              </div>
            </fieldset>
          </div>
        </section>

        <section class="gf-page" data-page="2">
          <h2 class="gf-section-title">Breathing</h2>
          <p class="gf-section-note">Select any breathing or airway conditions relevant to training.</p>

          <div class="gf-card">
            <fieldset data-conditional-source="breathingConditions">
              <legend>Do you have any of the following conditions that might affect breathing comfort or airway stability? (Select all that apply)</legend>
              <div class="gf-choice-row">
                <label class="gf-choice"><input type="checkbox" name="breathingConditions" value="Asthma" />Asthma</label>
                <label class="gf-choice"><input type="checkbox" name="breathingConditions" value="COPD" />Chronic Obstructive Pulmonary Disease</label>
                <label class="gf-choice"><input type="checkbox" name="breathingConditions" value="OSA" />Obstructive Sleep Apnea (OSA)</label>
                <label class="gf-choice"><input type="checkbox" name="breathingConditions" value="Long Covid" />Long Covid</label>
                <label class="gf-choice"><input type="checkbox" name="breathingConditions" value="Chronic Bronchitis" />Chronic Bronchitis</label>
                <label class="gf-choice"><input type="checkbox" name="breathingConditions" value="None" />No known conditions affecting breathing comfort or airway stability</label>
                <label class="gf-choice"><input type="checkbox" name="breathingConditions" value="Other" />Other (Please Specify)</label>
              </div>
              <div class="gf-field gf-conditional gf-other-condition" data-show-if="breathingConditions:Other">
                <label for="breathingConditionOther">Please specify the other condition</label>
                <input id="breathingConditionOther" name="breathingConditionOther" type="text" autocomplete="off" required />
              </div>
              <div class="gf-conditional gf-followup-flow" data-show-if-any="breathingConditions:Asthma|COPD|OSA|Long Covid|Chronic Bronchitis|None|Other" data-show-when-breathing-followup="airway asthma none other multiple">
                <div class="gf-followup-section">
                  <div class="gf-followup-stack">
                    <div class="gf-followup-item" data-show-when-breathing-followup="airway">
                      <p class="gf-question">Over the last 12 months, have you had any sudden breathing difficulties – similar to an asthma attack – that required urgent medical care?</p>
                      <div class="gf-choice-row">
                        <label class="gf-choice"><input type="radio" name="urgentBreathingCare12m" value="No" required />No</label>
                        <label class="gf-choice"><input type="radio" name="urgentBreathingCare12m" value="Yes" />Yes</label>
                      </div>
                    </div>
                    <div class="gf-followup-item" data-show-when-breathing-followup="asthma">
                      <p class="gf-question">Have you had an asthma attack requiring immediate medical attention at any time over the last 12 months?</p>
                      <div class="gf-choice-row">
                        <label class="gf-choice"><input type="radio" name="asthmaAttackMedicalAttention12m" value="No" required />No</label>
                        <label class="gf-choice"><input type="radio" name="asthmaAttackMedicalAttention12m" value="Yes" />Yes</label>
                      </div>
                    </div>
                    <div class="gf-followup-item" data-show-when-breathing-followup="none">
                      <p class="gf-question">Just to confirm, in the last 12 months, have you had any breathing episodes – even unexpected ones – that required urgent or emergency treatment?</p>
                      <div class="gf-choice-row">
                        <label class="gf-choice"><input type="radio" name="unexpectedBreathingEmergency12m" value="No" required />No</label>
                        <label class="gf-choice"><input type="radio" name="unexpectedBreathingEmergency12m" value="Yes" />Yes</label>
                      </div>
                    </div>
                    <div class="gf-followup-item" data-show-when-breathing-followup="other multiple">
                      <p class="gf-question">Over the last 12 months, have you had any breathing episodes – due to asthma or another condition – that required urgent or emergency treatment?</p>
                      <div class="gf-choice-row">
                        <label class="gf-choice"><input type="radio" name="anyConditionBreathingEmergency12m" value="No" required />No</label>
                        <label class="gf-choice"><input type="radio" name="anyConditionBreathingEmergency12m" value="Yes" />Yes</label>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="gf-followup-section" data-show-when-breathing-followup="airway asthma other multiple" data-show-when-any-answered="urgentBreathingCare12m|asthmaAttackMedicalAttention12m|unexpectedBreathingEmergency12m|anyConditionBreathingEmergency12m">
                  <p class="gf-followup-section-title">Triggers</p>
                  <div class="gf-followup-item">
                    <p class="gf-question">Are you aware of any triggers, patterns, or environments that tend to bring your symptoms on or make them worse?</p>
                    <div class="gf-choice-row">
                      <label class="gf-choice"><input type="radio" name="breathingTriggersKnown" value="No" required />No</label>
                      <label class="gf-choice"><input type="radio" name="breathingTriggersKnown" value="Yes" />Yes</label>
                    </div>
                  </div>
                  <div class="gf-followup-item" data-show-if="breathingTriggersKnown:Yes">
                    <label for="breathingTriggerDetails">Please share any specific triggers or factors which you have noticed worsen your symptoms or bring them on. It can help us understand your experience and consider any necessary precautions.</label>
                    <textarea id="breathingTriggerDetails" name="breathingTriggerDetails" required></textarea>
                  </div>
                </div>
                <div class="gf-followup-section" data-show-if-any="breathingConditions:Asthma" data-show-when-answered="breathingTriggersKnown">
                  <p class="gf-followup-section-title">Ventolin</p>
                  <div class="gf-followup-item">
                    <p class="gf-question">Do you use an inhaler?</p>
                    <div class="gf-choice-row">
                      <label class="gf-choice"><input type="radio" name="inhalerUse" value="Ventolin" required />Yes – Ventolin</label>
                      <label class="gf-choice"><input type="radio" name="inhalerUse" value="Ventolin and preventer" />Yes – Ventolin and a preventer</label>
                      <label class="gf-choice"><input type="radio" name="inhalerUse" value="No inhaler" />No – I do not use any inhaler</label>
                    </div>
                  </div>
                </div>
                <div class="gf-followup-section" data-show-if-any="inhalerUse:Ventolin|Ventolin and preventer">
                  <p class="gf-followup-section-title">Inhaler</p>
                  <div class="gf-followup-item">
                    <p class="gf-question">Do you use a spacer with your Ventolin inhaler?</p>
                    <div class="gf-choice-row">
                      <label class="gf-choice"><input type="radio" name="spacerUse" value="Yes" required />Yes –– I use an spacer with my inhaler</label>
                      <label class="gf-choice"><input type="radio" name="spacerUse" value="No" />No –– I do not use a spacer with my inhaler</label>
                    </div>
                  </div>
                </div>
                <div class="gf-followup-section" data-show-if-any="inhalerUse:Ventolin|Ventolin and preventer" data-show-when-answered="spacerUse">
                  <p class="gf-followup-section-title">Bringing Ventolin Inhaler to the Studio</p>
                  <p class="gf-followup-section-note">To support your safety and wellbeing during training, you are required to bring your Ventolin inhaler (and spacer, if applicable) to all sessions.</p>
                  <div class="gf-followup-item">
                    <label class="gf-choice">
                      <input type="checkbox" name="bringInhalerAgreement" value="yes" required />
                      <span><strong>Can you confirm that you will do this?</strong> You acknowledge and confirm that you will bring your Ventolin inhaler (and spacer, if applicable) to all training sessions.</span>
                    </label>
                  </div>
                </div>
              </div>
            </fieldset>
          </div>
        </section>

        <section class="gf-page" data-page="3">
          <h2 class="gf-section-title">Blood Sugar</h2>
          <p class="gf-section-note">These questions follow the source health and safety form.</p>

          <div class="gf-card">
            <fieldset data-conditional-source="bloodSugarCondition">
              <legend>Do you have diabetes or another condition that requires you to monitor your blood sugar levels more closely?</legend>
              <div class="gf-choice-row">
                <label class="gf-choice"><input type="radio" name="bloodSugarCondition" value="Diabetes" required />Yes – diabetes Type 1 or Type 2</label>
                <label class="gf-choice"><input type="radio" name="bloodSugarCondition" value="Other blood sugar condition" />Yes – another blood sugar condition</label>
                <label class="gf-choice"><input type="radio" name="bloodSugarCondition" value="No" />No</label>
              </div>
              <div class="gf-conditional" data-show-unless="bloodSugarCondition:No">
                <p class="gf-question">Have you had difficulty controlling your blood sugar (glucose) in the last 3 months?</p>
                <div class="gf-choice-row">
                  <label class="gf-choice"><input type="checkbox" name="diabetesGlucoseControl3m" value="No difficulty" />No difficulty in the last 3 months</label>
                  <label class="gf-choice"><input type="checkbox" name="diabetesGlucoseControl3m" value="Difficulty" />Yes – difficulty in the last 3 months</label>
                  <label class="gf-choice"><input type="checkbox" name="diabetesGlucoseControl3m" value="Some challenges but managed" />Some challenges, currently well managed</label>
                </div>
                <p class="gf-question">Have you experienced any challenges managing your blood sugar because of this condition in the last 3 months?</p>
                <div class="gf-choice-row">
                  <label class="gf-choice"><input type="radio" name="bloodSugarControl3m" value="No difficulty" required />No difficulty</label>
                  <label class="gf-choice"><input type="radio" name="bloodSugarControl3m" value="Difficulty" />Yes – difficulty</label>
                  <label class="gf-choice"><input type="radio" name="bloodSugarControl3m" value="Some challenges but managed" />Some challenges, currently managed</label>
                  <label class="gf-choice"><input type="radio" name="bloodSugarControl3m" value="Prefer not to say" />Prefer not to say</label>
                </div>
              </div>
            </fieldset>
          </div>
        </section>

        <section class="gf-page" data-page="4">
          <h2 class="gf-section-title">Smoking & Vaping</h2>
          <p class="gf-section-note">This section is optional in the source form.</p>

          <div class="gf-card">
            <fieldset data-conditional-source="smokingVapingSkip">
              <legend>You’re welcome to skip smoking & vaping questions if you prefer.</legend>
              <div class="gf-skip-toggle">
                <label class="gf-choice"><input type="checkbox" name="smokingVapingSkip" value="skip" />I would prefer to skip these questions.</label>
              </div>
            </fieldset>
          </div>

          <div class="gf-card" data-hide-if="smokingVapingSkip:skip">
            <fieldset data-conditional-source="smokingVapingCurrent">
              <legend>Do you currently smoke or vape?</legend>
              <div class="gf-choice-row">
                <label class="gf-choice"><input type="checkbox" name="smokingVapingCurrent" value="Smoke" />I currently smoke</label>
                <label class="gf-choice"><input type="checkbox" name="smokingVapingCurrent" value="Vape" />I currently vape</label>
                <label class="gf-choice"><input type="checkbox" name="smokingVapingCurrent" value="Both" />Both</label>
                <label class="gf-choice"><input type="checkbox" name="smokingVapingCurrent" value="Neither" />Neither</label>
              </div>
              <div class="gf-field">
                <p class="gf-question">Or have you recently quit smoking or vaping?</p>
                <div class="gf-choice-row">
                  <label class="gf-choice"><input type="checkbox" name="recentlyQuit" value="Quit smoking within 6 months" />Quit smoking within 6 months</label>
                  <label class="gf-choice"><input type="checkbox" name="recentlyQuit" value="Quit vaping within 6 months" />Quit vaping within 6 months</label>
                </div>
              </div>
              <div class="gf-conditional" data-show-if-any="smokingVapingCurrent:Smoke|Both">
                <p class="gf-question">How often do you currently smoke?</p>
                <div class="gf-choice-row">
                  <label class="gf-choice"><input type="radio" name="smokingFrequency" value="Daily" />Daily</label>
                  <label class="gf-choice"><input type="radio" name="smokingFrequency" value="Weekly" />Weekly</label>
                  <label class="gf-choice"><input type="radio" name="smokingFrequency" value="Occasionally" />Occasionally</label>
                </div>
                <div class="gf-grid">
                  <div class="gf-field"><label for="smokingDaysPerWeek">Roughly how many days per week do you smoke?</label><input id="smokingDaysPerWeek" name="smokingDaysPerWeek" type="number" min="0" max="7" /></div>
                  <div class="gf-field"><label for="cigarettesPerDay">On days you smoke, how many cigarettes do you have?</label><select id="cigarettesPerDay" name="cigarettesPerDay"><option value="">Select...</option><option>1-10</option><option>11-20</option><option>21-30</option><option>31+</option></select></div>
                </div>
              </div>
              <div class="gf-conditional" data-show-if-any="smokingVapingCurrent:Vape|Both">
                <p class="gf-question">How often do you currently vape?</p>
                <div class="gf-choice-row">
                  <label class="gf-choice"><input type="radio" name="vapingFrequency" value="Daily" />Daily</label>
                  <label class="gf-choice"><input type="radio" name="vapingFrequency" value="Weekly" />Weekly</label>
                  <label class="gf-choice"><input type="radio" name="vapingFrequency" value="Occasionally" />Occasionally</label>
                </div>
