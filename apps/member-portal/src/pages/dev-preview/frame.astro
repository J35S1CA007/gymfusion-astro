    stageTwoProgress: 2,
  },
  "active-incomplete": {
    hasActiveEpisode: true,
    journeyPhase: "EOI_PHASE",
    part1: "INCOMPLETE",
    nextAction: "Complete your Expression of Interest.",
    currentStatus: "Your EOI is in progress.",
    parts: {
      part2: { status: "INCOMPLETE", availability: "LOCKED", href: "/eoi/part-2", actionLabel: "Continue" },
      part3: { status: "INCOMPLETE", availability: "LOCKED", href: "/eoi/part-3", actionLabel: "Continue" },
      part4: { status: "INCOMPLETE", availability: "LOCKED", href: "/eoi/part-4", actionLabel: "Continue" },
