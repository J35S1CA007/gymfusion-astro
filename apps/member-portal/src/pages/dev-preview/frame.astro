---
import PortalLayout from "../../layouts/PortalLayout.astro";
import FramePreview, { type PreviewState } from "../../components/portal/FramePreview";
import type { DashboardProjection } from "../../components/portal/DashboardView";
import "../../styles/global.css";

const isDevelopmentPreview = import.meta.env.DEV;
if (!isDevelopmentPreview) Astro.response.status = 404;
const previewProjections = {
