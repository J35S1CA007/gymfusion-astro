    journeyPhase: "EOI_PHASE",
    part1: "COMPLETE",
    nextAction: "Complete your Fitness Profile.",
    currentStatus: "Your EOI is in progress.",
    parts: {
      part2: { status: "COMPLETE", availability: "SUBMITTED", href: "/eoi/part-2", actionLabel: "Review" },
      part3: { status: "COMPLETE", availability: "SUBMITTED", href: "/eoi/part-3", actionLabel: "Review" },
      part4: { status: "INCOMPLETE", availability: "AVAILABLE", href: "/eoi/part-4", actionLabel: "Continue" },
