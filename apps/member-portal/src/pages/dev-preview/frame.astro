      part4: { status: "INCOMPLETE", availability: "LOCKED", href: "/eoi/part-4", actionLabel: "Continue" },
    },
    task: { title: "Complete your Accessibility & Support Needs", description: "Continue your EOI by completing Part 3.", href: "/eoi/part-3", actionLabel: "Continue Part 3" },
