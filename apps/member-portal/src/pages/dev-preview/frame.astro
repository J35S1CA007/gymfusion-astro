---
{isDevelopmentPreview ? (
  <PortalLayout title="Members Portal Frame Preview" description="Development-only Members Portal frame preview">
    <FramePreview client:load member={{ displayName: "Preview Member", initials: "PM" }} projections={previewProjections} />
  </PortalLayout>
) : <main>Not found</main>}
