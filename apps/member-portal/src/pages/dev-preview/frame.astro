    stageTwoProgress: 3,
  },
  "incomplete-review": {
    hasActiveEpisode: true,
    journeyPhase: "REVIEW_PHASE",
    part1: "COMPLETE",
    nextAction: "Complete your Health Profile.",
    currentStatus: "Your EOI is in progress.",
    parts: {
      part2: { status: "INCOMPLETE", availability: "AVAILABLE", href: "/eoi/part-2", actionLabel: "Continue" },
      part3: { status: "INCOMPLETE", availability: "LOCKED", href: "/eoi/part-3", actionLabel: "Continue" },
