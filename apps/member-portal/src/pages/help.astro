---
import PortalLayout from "../layouts/PortalLayout.astro";
import PortalShell from "../components/portal/PortalShell";
import PortalState from "../components/portal/PortalState.astro";
import { loadPortalPage } from "../lib/portal-page";
import { sectionCopy } from "../lib/portal";
import "../styles/global.css";
const session = await loadPortalPage(Astro.request);
if (session.kind === "redirect") return new Response(null, { status: 303, headers: { Location: "/login", "Cache-Control": "no-store" } });
if (session.kind === "unavailable") Astro.response.status = 503;
const copy = sectionCopy.help;
---
{session.kind === "authenticated" ? <PortalLayout title={copy.title} description={copy.description}><PortalShell client:load active="help" member={{ displayName: session.displayName, initials: session.displayName.slice(0, 1).toUpperCase() }} logoutHref="/api/auth/logout"><PortalState heading="Help & support" body="Portal help content will be connected to the approved support guidance and escalation paths. No unverified contact details are shown." /></PortalShell></PortalLayout> : <main>Members Portal is temporarily unavailable.</main>}
