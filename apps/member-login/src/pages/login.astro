    transform: translateX(-65px);
    display: grid;
    place-items: center;
    z-index: 2;
    overflow: visible;
  }
  .brand-slot {
    position: static;
    grid-column: 2;
    justify-self: center;
    align-self: center;
    display: grid;
    place-items: center;
    z-index: 1;
    pointer-events: none;
  }
  .brand-logo {
    display: block;
    width: clamp(34px, 4.4vw, 46px);
    height: auto;
  }
  .mobile-menu-slot {
    display: none;
  }
  .menu-pill {
    --pill-font-size: clamp(12px, min(5cqw, 23cqh), 16px);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    min-width: 7.9em;
    min-height: 2.65em;
    padding: 0.64em 1.22em;
    border: none;
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    font-family: 'Sora', system-ui, sans-serif;
    font-size: var(--pill-font-size);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f6fbff;
    box-shadow: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
    z-index: 20;
    isolation: isolate;
    transform: translate(0, 0);
    animation: breathe 3.6s ease-in-out infinite;
  }
  .menu-pill::before {
    content: "";
    position: absolute;
    inset: -10px;
    border-radius: inherit;
    background: var(--cta-gradient);
    filter: blur(8px);
    opacity: 0.62;
    z-index: -1;
    transition: opacity 0.16s ease;
  }
  .menu-pill::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 2px;
    border-radius: inherit;
    background: var(--cta-gradient);
    pointer-events: none;
    z-index: -1;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .menu-pill > * {
    position: relative;
    z-index: 2;
  }
  .menu-label {
    font-family: 'Sora', system-ui, sans-serif;
    font-size: 1em;
  }
  .menu-icon {
    width: 1.45em;
    height: 1.45em;
    stroke: currentColor;
    stroke-width: 2.25px;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    flex: none;
    transition: transform 0.25s;
    overflow: visible;
  }
  .menu-icon .line {
    transition: transform 0.25s, opacity 0.2s;
    transform-origin: center;
  }
  .menu-pill:hover,
  .menu-pill:focus-visible,
  .menu-pill.is-open {
    transform: translate(0, -2px) scale(1.05);
    animation: none;
    background: #05020a;
    box-shadow: none;
    outline: none;
  }
  .menu-pill:hover::before,
  .menu-pill:focus-visible::before,
  .menu-pill.is-open::before {
    opacity: 0.72;
  }
  .menu-pill:hover .menu-icon,
  .menu-pill:focus-visible .menu-icon,
  .menu-pill.is-open .menu-icon {
    transform: none;
  }
  .menu-pill.is-open .line-top {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-pill.is-open .line-middle {
    opacity: 0;
  }
  .menu-pill.is-open .line-bottom {
    transform: translateY(-4px) rotate(-45deg);
  }
  .desktop-menu-overlay {
    position: absolute;
    top: calc(100% + 10px);
    left: -8px;
    right: auto;
    z-index: 240;
    pointer-events: auto;
    transform: none;
  }
  .desktop-menu-overlay[hidden],
  .desktop-site-menu[hidden] {
    display: none !important;
  }
  .desktop-site-menu {
    display: grid;
    width: 204px;
    height: 314px;
    grid-template-rows: repeat(6, 37px);
    align-content: start;
    row-gap: 11px;
    padding: 17px 0 0;
    box-sizing: border-box;
    border: 1px solid #ffffff05;
    background: linear-gradient(#030105db, #030105f5);
    box-shadow: 0 24px 60px #0000009e;
  }
  .desktop-site-menu .site-menu-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 37px;
    min-height: 37px;
    max-height: 37px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
    border: 0;
    background: #05020a;
    color: #fff;
    font-family: "Sora", Arial, Helvetica, sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    isolation: isolate;
    overflow: hidden;
  }
  .desktop-site-menu .site-menu-link::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(111deg, #9d0aff80 0%, #de079680 31%, #fd1d1d80 68%, #fc9e1980 100%), #05020a;
    z-index: 0;
  }
  .desktop-site-menu .site-menu-link::after {
    content: "";
    position: absolute;
    inset: 0;
    padding: 2px;
    background: linear-gradient(100deg, #a600ff 0%, #f0008c 38%, #ff174d 66%, #ff8a00 100%);
    pointer-events: none;
    z-index: 1;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .desktop-site-menu .site-menu-link__label {
    position: relative;
    z-index: 2;
  }
  .desktop-site-menu .site-menu-link:hover,
  .desktop-site-menu .site-menu-link:focus-visible {
    background: linear-gradient(111deg, #9d0aff57 0%, #de079657 31%, #fd1d1d57 68%, #fc9e1957 100%), #050107;
    filter: none;
    outline: none;
    outline-offset: 0;
  }
  .desktop-site-menu .site-menu-link:hover::before,
  .desktop-site-menu .site-menu-link:focus-visible::before {
    background: linear-gradient(111deg, #9d0aff70 0%, #de079670 31%, #fd1d1d70 68%, #fc9e1970 100%), #050107;
  }
  .mobile-menu-overlay {
    display: none;
  }
  .login-stage { display: grid; place-items: center; min-height: calc(100svh - 65px); padding: 34px 16px 46px; }
  .login-panel { position: relative; isolation: isolate; width: min(620px, 100%); min-height: min(603px, calc(100svh - 120px)); overflow: hidden; border: 1px solid #fff; border-radius: 0; background: transparent; box-shadow: 0 24px 90px rgba(0,0,0,.52); }
  .login-panel::before { position: absolute; inset: 0; z-index: -2; background: var(--gradient); content: ""; }
  .login-panel::after { position: absolute; inset: 0; z-index: -1; background: linear-gradient(135deg, rgba(0,0,0,.22), rgba(0,0,0,.14)); content: ""; }
  .spiral { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; object-fit: cover; opacity: 1; mix-blend-mode: normal; }
  .artboard {
    width: min(860px, 100%);
    min-height: clamp(560px, 76vh, 620px);
    display: grid;
    gap: clamp(14px, 2.2vw, 22px);
    align-items: start;
    align-content: center;
    justify-items: center;
    position: relative;
    animation: rise 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    overflow: hidden;
  }
  .artboard.is-reset-mode {
    animation: none;
    transform: translateY(clamp(12px, 1vw, 14px));
  }
  .title-wrap {
    width: 100%;
    position: relative;
    display: grid;
    place-items: center;
    margin-top: 25px;
    padding-top: clamp(4px, 1vw, 10px);
    padding-bottom: 0;
  }
  .title {
    margin: 0;
    position: relative;
    z-index: 1;
    font-family: "Separated", "Gamuth Display", sans-serif;
    font-weight: 400;
    font-size: clamp(3.5rem, 10vw, 6.2rem);
    line-height: 0.82;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink);
    transform: translateX(0.02em);
    -webkit-user-select: none;
    user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  :global(.title-line) { display: block; line-height: 0.82; }
  :global(.title-punctuation) { font-family: "Separated", "Gamuth Display", sans-serif; font-weight: inherit; }
  .subtitle-wrap {
    width: 100%;
    display: grid;
    place-items: center;
    min-height: clamp(36px, 5.5vw, 48px);
    margin: clamp(2px, 0.8vw, 8px) 0;
  }
  .title-subtitle {
    margin: 0;
    font-family: "Gamuth Sans Light", "Gamuth Sans", system-ui, sans-serif;
    font-weight: 300;
    font-size: clamp(0.8rem, 2.2vw, 1.05rem);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.88);
    text-align: center;
    max-width: 90%;
    -webkit-user-select: none;
    user-select: none;
  }
  :global(.subtitle-line) { display: block; }
  .title-subtitle.copy-enter {
    animation-duration: 1s;
    animation-timing-function: linear;
    animation-delay: 350ms;
  }
  .copy-enter { animation: copy-enter 500ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .form {
    width: min(360px, 100%);
    display: grid;
    gap: clamp(14px, 2.2vw, 20px);
    justify-items: start;
    margin-bottom: 0;
    transition: none;
  }
  .field {
    width: 100%;
    display: grid;
    gap: 8px;
    position: relative;
  }
  .field--cool {
    margin-top: clamp(2px, 0.8vw, 4px);
    overflow: hidden;
    max-height: 140px;
    transition: max-height 500ms ease 0ms, opacity 500ms ease 0ms, margin-top 500ms ease 0ms, transform 500ms ease 0ms;
    will-change: max-height, opacity, margin-top, transform;
  }
  .field--cool:focus-within { overflow: visible; }
  .field--cool .field-shell { will-change: transform, opacity; }
  .field--cool .label { will-change: transform, opacity; }
  .field--warm,
  .cta-stack { will-change: transform; }
  .field--warm { transition: none; }
  .cta-stack {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas: "forgot login";
    gap: clamp(10px, 1.5vw, 12px);
    margin-bottom: 20px;
    padding-top: clamp(10px, 1.5vw, 16px);
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .form:not(.is-password-collapsed) .cta-stack { margin-bottom: 25px; }
  .label {
    position: relative;
    z-index: 1;
    margin-left: 0;
    font-family: "Gamuth Sans", system-ui, sans-serif;
    font-size: clamp(0.84rem, 2vw, 1.12rem);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-shadow: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .field-shell { position: relative; width: 100%; height: clamp(50px, 10vw, 58px); }
  .field-shell--password { display: block; }
  .input {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 1px solid rgba(0, 0, 0, 0.32);
    border-radius: 8px;
    padding: 0 clamp(16px, 2.6vw, 26px) 0 clamp(16px, 2.6vw, 26px);
    background: #ffffff;
    color: var(--field-text);
    font-size: clamp(0.98rem, 2.2vw, 1.3rem);
    line-height: 1;
    outline: none;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.28) inset;
  }
  .field-shell--password .input { padding-right: clamp(72px, 12vw, 92px); }
  .password-controls {
    position: absolute;
    top: 50%;
    right: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    transform: translateY(-50%);
    z-index: 2;
  }
  .password-control {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    color: rgba(18, 18, 18, 0.88);
    box-shadow: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease, opacity 160ms ease;
  }
  .password-control:hover,
  .password-control:active {
    background: rgba(0, 0, 0, 0.11);
    border-color: rgba(0, 0, 0, 0.2);
    color: rgba(10, 10, 10, 0.98);
  }
  .password-control:active { transform: translateY(1px) scale(0.98); }
  .password-control:focus-visible {
    outline: 3px solid rgba(255, 255, 255, 0.78);
    outline-offset: 3px;
  }
  .password-control:disabled {
    cursor: default;
    opacity: 0.45;
  }
  .password-control__icon {
    width: 16px;
    height: 16px;
    display: block;
  }
  .password-control--clear[hidden] { display: none; }
  .input::placeholder {
    color: rgba(22, 22, 22, 0.52);
    opacity: 1;
    font-size: clamp(0.86rem, 1.8vw, 0.95rem);
    line-height: 1.1;
  }
  .field-shell:focus-within { outline: 3px solid #ffffff; outline-offset: 4px; border-radius: 8px; }
  .input:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(24, 24, 24, 0.12); }
  .form-message {
    min-height: 24px;
    margin: 1px auto 12px;
    max-width: 28ch;
    color: #fff;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
    white-space: pre-line;
  }
  .form-message:empty { display: none; }
  .form:has(.form-message:not(:empty)) .form-message { margin-bottom: 0; }
  .form:has(.form-message:not(:empty)) .cta-stack { padding-top: 0; }
  .form-message[data-kind="error"] {
    max-width: 22ch;
    color: #fff4f4;
  }
  .form-message[data-kind="success"] { color: #f0fff5; }
  .cta,
  .forgot {
    width: 100%;
    height: clamp(44px, 5vw, 52px);
    padding: 0 clamp(8px, 1.4vw, 15px);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ffffff;
    border-radius: 8px;
    background: #000000;
    color: #ffffff;
    font-family: "Gamuth Sans", system-ui, sans-serif;
    font-size: clamp(13px, 2.4vw, 15px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: transform 160ms ease, background-color 160ms ease, color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    -webkit-user-select: none;
    user-select: none;
  }
  .cta { grid-area: login; margin-top: 5px; }
  .forgot { grid-area: forgot; margin-top: 5px; white-space: nowrap; text-align: center; }
  .cta:hover,
  .cta:active,
  .forgot:hover,
  .forgot:active {
    transform: translateY(-1px);
    background: #ffffff;
    color: #000000;
    border-color: #000000;
    box-shadow: 0 20px 36px rgba(0, 0, 0, 0.08);
  }
  .cta:active,
  .forgot:active { transform: translateY(2px) scale(0.99); box-shadow: 0 6px 12px rgba(0, 0, 0, 0.03); }
  .cta:focus-visible,
  .forgot:focus-visible { outline: 3px solid rgba(255, 255, 255, 0.78); outline-offset: 4px; }
  .password-spacer { display: none; }
  .form.is-password-exiting .field--cool,
  .form.is-password-collapsed .field--cool,
  .form.is-password-returning .field--cool,
  .form.is-password-entering .field--cool { pointer-events: none; }
  .form.is-password-collapsed .field--cool { max-height: 0; margin-top: 0; }
  .form.is-password-collapsed .form-message { transform: translateY(-18px); }
  .form.is-password-exiting .field--cool .field-shell,
  .form.is-password-exiting .field--cool .label { animation: password-slide-out 200ms cubic-bezier(0.22, 0.3, 0.36, 1) forwards; }
  .form.is-password-entering .field--cool .field-shell,
  .form.is-password-entering .field--cool .label { animation: password-slide-in 300ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .form.is-password-collapsed .field--cool .field-shell,
  .form.is-password-collapsed .field--cool .label,
  .form.is-password-returning .field--cool .field-shell,
  .form.is-password-returning .field--cool .label { transform: translateX(112%); opacity: 0; }
  .form.is-password-collapsed .cta-stack { transform: translateY(-20px); }
  .form.is-password-returning .cta-stack { transform: translateY(0); }
  @keyframes rise {
    from { opacity: 0; transform: translateY(12px) scale(0.992); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes password-slide-out {
    0% { transform: translateX(0); opacity: 1; }
    18% { opacity: 1; }
    100% { transform: translateX(112%); opacity: 0; }
  }
  @keyframes password-slide-in {
    0% { transform: translateX(112%); opacity: 0; }
    18% { opacity: 1; }
    100% { transform: translateX(0); opacity: 1; }
  }
  @keyframes copy-enter {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  button:disabled { cursor: wait; opacity: .68; }
  @media (max-width: 1023px) {
    :global(html.mobile-site-menu-open),
    :global(body.mobile-site-menu-open) {
      overflow: hidden !important;
      overscroll-behavior: none !important;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 160;
      padding: 0 12px;
      height: 64px;
      min-height: 64px;
      background: #000;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header[data-mobile-menu-open="true"] {
      background: #000;
    }
    .desktop-menu-slot {
      display: none;
    }
    .mobile-menu-slot {
      position: static;
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      align-self: center;
      display: grid;
      width: 51px;
      height: 51px;
      margin: 0;
      transform: translateX(6px);
      z-index: 3;
    }
    .brand-logo {
      width: 50px;
    }
    .mobile-navigation-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 51px;
      height: 51px;
      padding: 0;
      border: 0;
      outline: 0;
      background: transparent;
      cursor: pointer;
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
      transition: transform 180ms ease, opacity 180ms ease;
    }
    .mobile-navigation-button:active {
      transform: scale(0.92);
    }
    .mobile-navigation-button.is-open .line-top {
      transform: translateY(6px) rotate(45deg);
    }
    .mobile-navigation-button.is-open .line-middle {
      opacity: 0;
      transform: scaleX(0);
    }
    .mobile-navigation-button.is-open .line-bottom {
      transform: translateY(-6px) rotate(-45deg);
    }
    .mobile-navigation-icon {
      width: 35px;
      height: 35px;
      overflow: visible;
      fill: none;
      stroke: url("#mobile-navigation-icon-gradient");
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .mobile-navigation-icon .line {
      transform-box: fill-box;
      transform-origin: center;
      transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 160ms ease;
    }
    .mobile-menu-overlay {
      position: fixed;
