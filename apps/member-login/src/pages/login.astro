---
import backgroundUrl from '../../assets/background-members-login-screen.png';
import spiralLogoUrl from '../../assets/member-login-page-logos/vibrant_gf_spiral_transparent.png';
import spiralUrl from '../../assets/gf-spiral-pattern-transparent.png';
import { env } from 'cloudflare:workers';
import { getPortalUrl, getSession } from '../lib/auth';

const session = await getSession(Astro.request, env);
const portalUrl = session ? getPortalUrl(Astro.request, env) : undefined;
const turnstileSiteKey = String((env as { TURNSTILE_SITE_KEY?: string }).TURNSTILE_SITE_KEY ?? "").trim();
if (portalUrl) return Astro.redirect(portalUrl);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GYMFUSION Members Login" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <title>GYMFUSION Members Login</title>
  </head>
  <body style={`--gf-background: url("${backgroundUrl.src}");`}>
    <header class="site-header" data-site-header>
      <div class="desktop-menu-slot">
        <button class="menu-pill" type="button" data-desktop-menu-button aria-expanded="false" aria-controls="desktop-site-menu">
          <svg class="menu-icon" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
            <path class="line line-top" d="M5 8h18"></path>
            <path class="line line-middle" d="M5 14h18"></path>
            <path class="line line-bottom" d="M5 20h18"></path>
          </svg>
          <span class="menu-label">Menu</span>
        </button>
        <div class="desktop-menu-overlay" data-desktop-menu-overlay hidden>
          <nav class="desktop-site-menu" id="desktop-site-menu" aria-label="Desktop navigation" hidden>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/" rel="noreferrer" target="_blank"><span class="site-menu-link__label">Home</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/our-services" rel="noreferrer" target="_blank"><span class="site-menu-link__label">Our Services</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/privacy-policy" rel="noreferrer" target="_blank"><span class="site-menu-link__label">Privacy Policy</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/accessibility-inclusion-statement" rel="noreferrer" target="_blank"><span class="site-menu-link__label">Accessibility &amp; Inclusion</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/our-policies" rel="noreferrer" target="_blank"><span class="site-menu-link__label">Our Policies</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/terms-and-conditions" rel="noreferrer" target="_blank"><span class="site-menu-link__label">T&amp;Cs</span></a>
          </nav>
        </div>
      </div>
      <div class="brand-slot" aria-hidden="true">
        <img class="brand-logo" src={spiralLogoUrl.src} alt="" loading="eager" decoding="async" />
      </div>
      <div class="mobile-menu-slot">
        <button
          class="mobile-navigation-button"
          id="gfMobileMenuButton"
          type="button"
          aria-label="Open navigation"
          aria-controls="mobile-site-menu"
          aria-expanded="false"
        >
          <svg class="mobile-navigation-icon" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="mobile-navigation-icon-gradient" x1="2" y1="2" x2="26" y2="26" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#9d0aff"></stop>
                <stop offset="31%" stop-color="#de0796"></stop>
                <stop offset="68%" stop-color="#fd1d1d"></stop>
                <stop offset="100%" stop-color="#fc9e19"></stop>
              </linearGradient>
            </defs>
            <path class="line line-top" d="M5 8h18"></path>
            <path class="line line-middle" d="M5 14h18"></path>
            <path class="line line-bottom" d="M5 20h18"></path>
          </svg>
        </button>
      </div>
    </header>
    <div class="mobile-menu-overlay" data-mobile-menu-overlay id="mobile-site-menu-overlay" hidden aria-hidden="true">
      <nav class="mobile-site-menu" id="mobile-site-menu" aria-label="Mobile navigation">
        <a class="mobile-site-menu__button" href="https://www.gymfusion.com.au/" rel="noreferrer" target="_blank" data-mobile-menu-link><span>Home</span></a>
        <a class="mobile-site-menu__button" href="https://www.gymfusion.com.au/our-services" rel="noreferrer" target="_blank" data-mobile-menu-link><span>Our Services</span></a>
        <a class="mobile-site-menu__button" href="https://www.gymfusion.com.au/privacy-policy" rel="noreferrer" target="_blank" data-mobile-menu-link><span>Privacy Policy</span></a>
        <a class="mobile-site-menu__button" href="https://www.gymfusion.com.au/accessibility-inclusion-statement" rel="noreferrer" target="_blank" data-mobile-menu-link><span>Accessibility &amp; Inclusion</span></a>
        <a class="mobile-site-menu__button" href="https://www.gymfusion.com.au/our-policies" rel="noreferrer" target="_blank" data-mobile-menu-link><span>Our Policies</span></a>
        <a class="mobile-site-menu__button" href="https://www.gymfusion.com.au/terms-and-conditions" rel="noreferrer" target="_blank" data-mobile-menu-link><span>T&amp;Cs</span></a>
      </nav>
    </div>

    <main class="login-stage">
      <section class="login-panel" aria-labelledby="login-title">
        <img class="spiral" src={spiralUrl.src} alt="" aria-hidden="true" />
        <div class="artboard">
          <div class="title-wrap">
            <h1 id="login-title" class="title" data-login-title>WELCOME BACK</h1>
          </div>

          <div class="subtitle-wrap">
            <p class="title-subtitle" data-login-subtitle>
              <span class="subtitle-line">Login to access your </span>
              <span class="subtitle-line">GYMFUSION Members Portal</span>
            </p>
          </div>

          <form class="form" data-auth-form novalidate>
            <label class="field field--warm" for="email">
              <span class="label">Email</span>
              <span class="field-shell">
                <input id="email" class="input" name="email" type="email" autocomplete="email" placeholder="Enter your email" required />
              </span>
            </label>

            <div class="field field--cool" id="password-field">
              <label class="label" for="password" data-password-label>Password</label>
              <span class="field-shell field-shell--password">
                <input id="password" class="input" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
                <span class="password-controls" data-password-controls>
                  <button class="password-control" type="button" data-password-toggle aria-pressed="false" aria-label="Show password">
                    <svg class="password-control__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M2.5 12s3.6-6.5 9.5-6.5S21.5 12 21.5 12s-3.6 6.5-9.5 6.5S2.5 12 2.5 12Z" fill="none" stroke="currentColor" stroke-width="1.7" />
                      <circle cx="12" cy="12" r="3.1" fill="none" stroke="currentColor" stroke-width="1.7" />
                    </svg>
                  </button>
                  <button class="password-control password-control--clear" type="button" data-password-clear aria-label="Clear password" hidden>
                    <svg class="password-control__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
                    </svg>
                  </button>
                </span>
              </span>
            </div>

            <div class="password-spacer" aria-hidden="true"></div>

            <p class="form-message" data-message role="alert" aria-live="polite"></p>

            <div data-turnstile-widget data-turnstile-site-key={turnstileSiteKey}></div>

            <div class="cta-stack" data-login-actions data-mode="login">
              <button class="cta" type="submit" data-submit>Login</button>
              <button class="forgot" type="button" aria-controls="password-field" aria-expanded="true" data-forgot>Forgot Password?</button>
            </div>
          </form>
        </div>
      </section>
    </main>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer is:inline></script>
    <script>
      const turnstileSiteKey = document.querySelector<HTMLElement>('[data-turnstile-widget]')?.dataset.turnstileSiteKey || '';
      const form = document.querySelector<HTMLFormElement>('[data-auth-form]')!;
      const email = document.querySelector<HTMLInputElement>('#email')!;
      const password = document.querySelector<HTMLInputElement>('#password')!;
      const passwordField = document.querySelector<HTMLElement>('#password-field')!;
      const passwordControls = document.querySelector<HTMLElement>('[data-password-controls]')!;
      const passwordToggle = document.querySelector<HTMLButtonElement>('[data-password-toggle]')!;
      const passwordClear = document.querySelector<HTMLButtonElement>('[data-password-clear]')!;
      const message = document.querySelector<HTMLElement>('[data-message]')!;
      const title = document.querySelector<HTMLElement>('[data-login-title]')!;
      const titleSubtitle = document.querySelector<HTMLElement>('[data-login-subtitle]')!;
      const artboard = document.querySelector<HTMLElement>('.artboard')!;
      const titleWrap = document.querySelector<HTMLElement>('.title-wrap')!;
      const actions = document.querySelector<HTMLElement>('[data-login-actions]')!;
      const forgot = document.querySelector<HTMLButtonElement>('[data-forgot]')!;
      const submit = document.querySelector<HTMLButtonElement>('[data-submit]')!;
      const passwordInput = document.querySelector<HTMLInputElement>('#password')!;
      const desktopMenuButton = document.querySelector<HTMLButtonElement>('[data-desktop-menu-button]')!;
      const desktopMenuOverlay = document.querySelector<HTMLElement>('[data-desktop-menu-overlay]')!;
      const desktopMenu = document.querySelector<HTMLElement>('#desktop-site-menu')!;
      const mobileMenuButton = document.querySelector<HTMLButtonElement>('#gfMobileMenuButton')!;
      const mobileMenuOverlay = document.querySelector<HTMLElement>('[data-mobile-menu-overlay]')!;
      const mobileMenu = document.querySelector<HTMLElement>('#mobile-site-menu')!;
      const mobileMenuLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-menu-link]'));
      let recoveryMode = false;
      let requestInFlight = false;
      let activeMenuMode = '';
      let mobileMenuRevealFrame: number | null = null;
      let mobileMenuRevealTimer: number | null = null;
      let turnstileWidgetId: string | null = null;
      let turnstileReady: Promise<TurnstileApi> | null = null;
      let turnstileAttempt = 0;
      let activeTurnstileAttempt: { id: number; widgetId: string; resolve: (token: string) => void; reject: (error: Error) => void } | null = null;

      type TurnstileApi = {
        render: (container: HTMLElement, options: Record<string, unknown>) => string;
        execute: (widgetId: string) => void;
        remove?: (widgetId: string) => void;
        reset: (widgetId: string) => void;
      };

      const getTurnstile = (): Promise<TurnstileApi> => {
        if (turnstileReady) return turnstileReady;
        turnstileReady = new Promise((resolve, reject) => {
          const started = Date.now();
          const wait = () => {
            const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
            if (api) return resolve(api);
            if (Date.now() - started >= 8000) return reject(new Error('Turnstile is unavailable.'));
            window.setTimeout(wait, 50);
          };
          wait();
        });
        return turnstileReady;
      };

      const getTurnstileToken = async (): Promise<string> => {
        if (!turnstileSiteKey) throw new Error('Turnstile is unavailable.');
        const api = await getTurnstile();
        const container = document.querySelector<HTMLElement>('[data-turnstile-widget]');
        if (!container) throw new Error('Turnstile is unavailable.');
        if (turnstileWidgetId !== null) {
          api.remove?.(turnstileWidgetId);
          turnstileWidgetId = null;
        }
        const attemptId = ++turnstileAttempt;
        return new Promise((resolve, reject) => {
          const isCurrent = () => activeTurnstileAttempt?.id === attemptId;
          const rejectCurrent = () => {
            if (!isCurrent()) return;
            activeTurnstileAttempt = null;
            reject(new Error('Turnstile verification failed.'));
          };
          const widgetId = api.render(container, {
            appearance: 'interaction-only',
            action: 'member_login',
            callback: (token: string) => {
              if (!isCurrent()) return;
              activeTurnstileAttempt = null;
              resolve(token);
            },
            'error-callback': rejectCurrent,
            'expired-callback': rejectCurrent,
            execution: 'execute',
            sitekey: turnstileSiteKey,
            'unsupported-callback': rejectCurrent,
          });
          activeTurnstileAttempt = { id: attemptId, reject, resolve, widgetId };
          turnstileWidgetId = widgetId;
          try {
            api.execute(widgetId);
          } catch {
            if (activeTurnstileAttempt?.id === attemptId) {
              activeTurnstileAttempt = null;
              reject(new Error('Turnstile verification failed.'));
            }
          }
        });
      };

      const setMessage = (text: string, kind = '') => {
        message.textContent = text;
        message.dataset.kind = kind;
      };
      const clearError = () => {
        if (message.dataset.kind === 'error') setMessage('');
      };

      let transitionTimer: number | null = null;
      let isTransitioning = false;

      const updatePasswordControls = () => {
        const canInteract = !recoveryMode && !requestInFlight;
        const hasPassword = Boolean(password.value);
        const passwordVisible = password.type === 'text';

        passwordField.dataset.revealed = String(passwordVisible);
        passwordControls.dataset.hasValue = String(hasPassword);
        passwordToggle.disabled = !canInteract;
        passwordToggle.setAttribute('aria-pressed', String(passwordVisible));
        passwordToggle.setAttribute('aria-label', passwordVisible ? 'Hide password' : 'Show password');
        passwordClear.hidden = !canInteract || !hasPassword;
        passwordClear.disabled = !canInteract || !hasPassword;
      };

      const syncPasswordVisibility = (visible: boolean) => {
        password.type = visible ? 'text' : 'password';
        updatePasswordControls();
      };

      email.addEventListener('input', clearError);
      password.addEventListener('input', () => {
        clearError();
        updatePasswordControls();
      });

      const syncButtonLabels = (collapsed: boolean, animate = true) => {
        recoveryMode = collapsed;
        artboard.classList.toggle('is-reset-mode', collapsed);
        titleWrap.classList.toggle('is-reset-mode', collapsed);
        title.innerHTML = collapsed
          ? '<span class="title-line">FORGOT</span><span class="title-line">PASS<span class="title-punctuation">?</span></span>'
          : '<span class="title-line">WELCOME</span><span class="title-line">BACK</span>';
        titleSubtitle.innerHTML = collapsed
          ? '<span class="subtitle-line">We will email instructions </span><span class="subtitle-line">to reset your password.</span>'
          : '<span class="subtitle-line">Login to access your </span><span class="subtitle-line">GYMFUSION Members Portal</span>';
        forgot.textContent = collapsed ? 'Return to Login' : 'Forgot Password?';
        forgot.setAttribute('aria-expanded', String(!collapsed));
        submit.textContent = collapsed ? 'Reset Password' : 'Login';
        actions.dataset.mode = collapsed ? 'recovery' : 'login';
        passwordInput.required = !collapsed;
        syncPasswordVisibility(false);

        if (animate) {
          title.classList.remove('copy-enter');
          titleSubtitle.classList.remove('copy-enter');
          void titleWrap.offsetWidth;
          title.classList.add('copy-enter');
          titleSubtitle.classList.add('copy-enter');
        }
      };

      const setRecoveryMode = (next: boolean) => {
        if (transitionTimer !== null) {
          window.clearTimeout(transitionTimer);
          transitionTimer = null;
        }

        if (next) {
          form.classList.remove('is-password-returning', 'is-password-entering');
          syncButtonLabels(true);
          passwordInput.blur();
          form.classList.add('is-password-exiting');

          transitionTimer = window.setTimeout(() => {
            form.classList.add('is-password-collapsed');
            transitionTimer = window.setTimeout(() => {
              form.classList.remove('is-password-exiting');
              transitionTimer = null;
            }, 500);
          }, 55);
          return;
        }

        form.classList.remove('is-password-exiting');
        syncButtonLabels(false);
        form.classList.add('is-password-returning');
        form.classList.remove('is-password-collapsed');

        transitionTimer = window.setTimeout(() => {
          form.classList.add('is-password-entering');
          transitionTimer = window.setTimeout(() => {
            form.classList.remove('is-password-collapsed', 'is-password-returning', 'is-password-entering');
            transitionTimer = null;
          }, 420);
        }, 110);
      };

      const setDesktopMenuOpen = (open: boolean) => {
        desktopMenu.hidden = !open;
        desktopMenuOverlay.hidden = !open;
        desktopMenuButton.classList.toggle('is-open', open);
        desktopMenuButton.setAttribute('aria-expanded', String(open));
        if (!open && activeMenuMode === 'desktop') activeMenuMode = '';
        if (open) activeMenuMode = 'desktop';
      };

      const resetMobileMenuButtons = () => {
        mobileMenuLinks.forEach((button) => {
          button.classList.remove('is-visible');
          button.style.animationDelay = '0ms';
        });
      };

      const playMobileMenuButtons = () => {
        mobileMenuLinks.forEach((button, index) => {
          button.style.animationDelay = `${index * 200}ms`;
          button.classList.add('is-visible');
        });
      };

      const clearMobileMenuReveal = () => {
        if (mobileMenuRevealFrame !== null) {
          cancelAnimationFrame(mobileMenuRevealFrame);
          mobileMenuRevealFrame = null;
        }
        if (mobileMenuRevealTimer !== null) {
          clearTimeout(mobileMenuRevealTimer);
          mobileMenuRevealTimer = null;
        }
      };

      const setMobileMenuScrollLock = (open: boolean) => {
        document.documentElement.classList.toggle('mobile-site-menu-open', open);
        document.body.classList.toggle('mobile-site-menu-open', open);
      };

      const setMobileMenuOpen = (open: boolean) => {
        const header = document.querySelector<HTMLElement>('[data-site-header]');
        if (header) header.dataset.mobileMenuOpen = open ? 'true' : 'false';
        mobileMenuButton.classList.toggle('is-open', open);
        mobileMenuButton.setAttribute('aria-expanded', String(open));
        mobileMenuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        mobileMenuOverlay.hidden = !open;
        mobileMenuOverlay.classList.toggle('is-open', open);
        mobileMenuOverlay.setAttribute('aria-hidden', String(!open));
        setMobileMenuScrollLock(open);
        clearMobileMenuReveal();
        if (!open && activeMenuMode === 'mobile') activeMenuMode = '';
        if (!open) {
          resetMobileMenuButtons();
          return;
        }
        activeMenuMode = 'mobile';
        resetMobileMenuButtons();
        mobileMenuRevealFrame = window.requestAnimationFrame(() => {
          mobileMenuRevealTimer = window.setTimeout(() => {
            playMobileMenuButtons();
            mobileMenuRevealTimer = null;
          }, 180);
          mobileMenuRevealFrame = null;
        });
      };

      const closeMenus = () => {
        setDesktopMenuOpen(false);
        setMobileMenuOpen(false);
      };

      const setBusy = (busy: boolean, label: string) => {
        requestInFlight = busy;
        submit.disabled = busy;
        forgot.disabled = busy;
        submit.textContent = busy ? label : (recoveryMode ? 'Reset Password' : 'Login');
        updatePasswordControls();
      };

      forgot.addEventListener('click', () => {
        if (isTransitioning) return;
        isTransitioning = true;
        setMessage('');
        const isCollapsed = form.classList.contains('is-password-collapsed');
        setRecoveryMode(!isCollapsed);
        window.setTimeout(() => {
          isTransitioning = false;
        }, isCollapsed ? 560 : 610);
      });
      passwordToggle.addEventListener('click', () => {
        if (passwordToggle.disabled) return;
        syncPasswordVisibility(password.type !== 'text');
        password.focus();
        password.setSelectionRange(password.value.length, password.value.length);
      });
      passwordClear.addEventListener('click', () => {
        if (passwordClear.disabled) return;
        password.value = '';
        clearError();
        updatePasswordControls();
        password.focus();
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (requestInFlight) return;
        if (!email.checkValidity() || (!recoveryMode && !password.value)) {
          setMessage(recoveryMode ? 'Enter a valid email address.' : 'Enter a valid email and password.', 'error');
          (email.checkValidity() ? password : email).focus();
          return;
        }
        setBusy(true, recoveryMode ? 'Sending...' : 'Connecting...');
        setMessage(recoveryMode ? 'Sending reset instructions...' : 'Connecting securely...');
        try {
          if (recoveryMode && localResetSuccessTest) {
            window.setTimeout(() => {
              setMessage('If an account matches that email, reset instructions have been sent.', 'success');
              setBusy(false, '');
            }, 0);
            return;
          }
          const turnstileToken = recoveryMode ? undefined : await getTurnstileToken();
          const response = await fetch(recoveryMode ? '/api/auth/recovery' : '/api/auth/login', {
            body: JSON.stringify(recoveryMode ? { email: email.value } : { email: email.value, password: password.value, turnstileToken }),
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            method: 'POST',
          });
          const payload = await response.json() as { error?: string; redirectUrl?: string };
          if (!response.ok) throw new Error(payload.error || 'We could not complete that request. Please try again.');
          if (!recoveryMode && payload.redirectUrl) {
            window.location.assign(payload.redirectUrl);
            return;
          }
          setMessage('If an account matches that email, reset instructions have been sent.', 'success');
          setBusy(false, '');
        } catch (error) {
          const errorText = error instanceof Error ? error.message : '';
          const safeMessage = /we could not reach the member service/i.test(errorText)
            ? 'We could not reach the member service.\nPlease try again.'
            : /failed to fetch|networkerror|network request/i.test(errorText)
              ? 'We could not reach the member service.\nPlease try again.'
              : (errorText || 'We could not complete that request. Please try again.');
          setMessage(safeMessage, 'error');
          setBusy(false, '');
          if (turnstileWidgetId !== null) {
            const api = (window as Window & { turnstile?: TurnstileApi }).turnstile;
            api?.reset(turnstileWidgetId);
            api?.remove?.(turnstileWidgetId);
            turnstileWidgetId = null;
          }
          activeTurnstileAttempt = null;
        }
      });
      updatePasswordControls();

      desktopMenuButton.addEventListener('click', () => {
        const nextOpen = desktopMenu.hidden;
        closeMenus();
        if (nextOpen) setDesktopMenuOpen(true);
      });
      desktopMenu?.addEventListener('mouseleave', () => setDesktopMenuOpen(false));

      mobileMenuButton.addEventListener('click', () => {
        const nextOpen = mobileMenuOverlay.hidden;
        closeMenus();
        if (nextOpen) setMobileMenuOpen(true);
      });
      mobileMenuLinks.forEach((link) => {
        link.addEventListener('click', () => setMobileMenuOpen(false));
      });
      mobileMenuOverlay.addEventListener('click', (event) => {
        if (event.target === mobileMenuOverlay) setMobileMenuOpen(false);
      });

      document.addEventListener('pointerdown', (event) => {
        if (!(event.target instanceof Node) || !activeMenuMode) return;
        if (activeMenuMode === 'desktop') {
          if (desktopMenu.contains(event.target) || desktopMenuButton.contains(event.target)) return;
          closeMenus();
          return;
        }
        if (mobileMenu.contains(event.target) || mobileMenuButton.contains(event.target)) return;
        closeMenus();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenus();
        }
      });
      window.addEventListener('resize', closeMenus);

      syncButtonLabels(false, false);
      const params = new URLSearchParams(window.location.search);
      const localResetSuccessTest = (window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost') && params.get('reset') === 'complete';
      const authError = params.get('auth_error');
      if (authError) setMessage(authError, 'error');
      if (params.get('reset') === 'complete') setMessage('Your password was reset. You can now log in.', 'success');
      fetch('/api/auth/session', { credentials: 'same-origin' }).then(async (response) => {
        if (response.ok) {
          const payload = await response.json() as { redirectUrl?: string };
          window.location.assign(payload.redirectUrl || '/members');
        }
      }).catch(() => {});
    </script>
  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap");
  @font-face { font-family: "Separated"; src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/SEPARATED.ttf") format("truetype"); font-display: swap; }
  @font-face { font-family: "Pacifico"; src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Pacifico-Regular.ttf") format("truetype"); font-display: swap; }
  @font-face { font-family: "Gamuth Sans"; src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Regular.ttf") format("truetype"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "Gamuth Sans"; src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Bold.ttf") format("truetype"); font-weight: 700; font-display: swap; }

  :root { color-scheme: dark; --ink: #fff; --muted: rgba(255,255,255,.78); --field-text: #111; --gradient: linear-gradient(111deg, rgba(255,146,78,.8) 4.821134868421053%, rgba(255,0,6,.8) 23.183936403508774%, rgba(255,0,87,.8) 42.61924342105263%, rgba(160,0,255,.8) 74.0234375%, rgba(133,84,250,.8) 83.62801535087719%); --cta-gradient: linear-gradient(111deg, rgba(157, 10, 255, 1) 0%, rgba(222, 7, 150, 1) 31%, rgba(253, 29, 29, 1) 68%, rgba(252, 158, 25, 1) 100%); }
  * { box-sizing: border-box; }
  html, body { margin: 0; min-width: 320px; min-height: 100%; overflow-x: hidden; overflow-y: auto; }
  body { min-height: 100svh; color: var(--ink); background: #09020f var(--gf-background) center / cover fixed no-repeat; font-family: "Gamuth Sans", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  button, input { font: inherit; }
  button { cursor: pointer; touch-action: manipulation; }
  button:focus-visible, input:focus-visible, a:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    width: 100%;
    min-height: 65px;
    padding: 0 16px;
    background: #000;
    overflow: visible;
  }
  .desktop-menu-slot {
    position: relative;
    grid-column: 1;
