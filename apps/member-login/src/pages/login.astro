      padding: 88px 20px calc(24px + env(safe-area-inset-bottom));
      overflow-y: auto;
      background: rgba(0, 0, 0, 0.68);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 150;
