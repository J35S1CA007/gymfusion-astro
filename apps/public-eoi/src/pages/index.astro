---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const spiralLogoSrc = 'https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@2df01ea/loaders/logos/vibrant_spiral_transparent.png';
const mobileEoiHtml = readFileSync(resolve(process.cwd(), 'public/mobile-eoi-part-1.html'), 'utf8');
const mobileEoiBody = mobileEoiHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
const mobileEoiMarkup = mobileEoiBody
  .replace(/\s*<script[^>]*src=["']\.\/mobile\.js["'][^>]*><\/script>\s*$/i, '')
  .replace(/^\s*<main\b/, '<div')
  .replace(/<\/main>\s*$/, '</div>');
---

<Layout
  title="GYMFUSION Expression of Interest"
  description="Public EOI Part 1 landing page for the GYMFUSION Astro migration."
>
  <link slot="head" rel="stylesheet" href="/mobile.css" media="screen and (max-width: 1023px)" />
  <main class="eoi-landing" aria-label="GYMFUSION Expression of Interest">
    <div class="top-strip" data-site-header>
      <div class="mobile-login-slot">
        <gf-public-member-nav-mobile
          class="gf-member-nav-mobile-host"
          member-state='{"authenticated":false,"displayName":"","loading":false,"ready":true,"dropdownOpen":false,"notice":""}'
          portal-url="https://portal.gymfusion.com.au/members"
          login-url="https://portal.gymfusion.com.au/login"
        ></gf-public-member-nav-mobile>
      </div>
      <div class="brand-slot" aria-hidden="true">
        <img
          class="brand-logo"
          src={spiralLogoSrc}
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="nav-slot">
        <gf-public-member-nav
          class="gf-member-nav-host"
          member-state='{"authenticated":false,"displayName":"","loading":false,"ready":true,"dropdownOpen":false,"notice":""}'
          portal-url="https://portal.gymfusion.com.au/members"
          login-url="https://portal.gymfusion.com.au/login"
          login-lightbox-name="Login"
