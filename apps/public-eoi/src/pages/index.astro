---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const spiralLogoSrc = 'https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@2df01ea/loaders/logos/vibrant_spiral_transparent.png';
const mobileEoiHtml = readFileSync(resolve(process.cwd(), 'public/mobile-eoi-part-1.html'), 'utf8');
const mobileEoiBody = mobileEoiHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
const mobileEoiMarkup = mobileEoiBody
  .replace(/\s*<script[^>]*src=["']\.\/mobile\.js["'][^>]*><\/script>\s*$/i, '')
  .replace(/^\s*<main\b/, '<div')
  .replace(/<\/main>\s*$/, '</div>');
---

<Layout
  title="GYMFUSION Expression of Interest"
  description="Public EOI Part 1 landing page for the GYMFUSION Astro migration."
>
  <link slot="head" rel="stylesheet" href="/mobile.css" media="screen and (max-width: 1023px)" />
  <main class="eoi-landing" aria-label="GYMFUSION Expression of Interest">
    <div class="top-strip" data-site-header>
      <div class="brand-slot" aria-hidden="true">
        <img
          class="brand-logo"
          src={spiralLogoSrc}
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="nav-slot">
        <gf-public-member-nav
          class="gf-member-nav-host"
          member-state='{"authenticated":false,"displayName":"","loading":false,"ready":true,"dropdownOpen":false,"notice":""}'
          portal-url="https://portal.gymfusion.com.au"
          login-lightbox-name="Login"
        ></gf-public-member-nav>
      </div>
      <div class="menu-slot">
        <button class="menu-pill" id="gfMenuButton" type="button" aria-label="Open menu" aria-expanded="false">
          <svg class="menu-icon" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
            <path class="line line-top" d="M5 8h18"></path>
            <path class="line line-middle" d="M5 14h18"></path>
            <path class="line line-bottom" d="M5 20h18"></path>
          </svg>
          <span class="menu-label">Menu</span>
        </button>
        <div class="desktop-menu-overlay" data-desktop-menu-overlay hidden>
          <nav class="desktop-site-menu" id="desktop-site-menu" aria-label="Desktop navigation" hidden>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/"><span class="site-menu-link__label">Home</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/our-services"><span class="site-menu-link__label">Our Services</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/privacy-policy"><span class="site-menu-link__label">Privacy Policy</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/accessibility-inclusion-statement"><span class="site-menu-link__label">Accessibility &amp; Inclusion</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/our-policies/"><span class="site-menu-link__label">Our Policies</span></a>
            <a class="site-menu-link" href="https://www.gymfusion.com.au/terms-and-conditions"><span class="site-menu-link__label">T&amp;Cs</span></a>
          </nav>
        </div>
      </div>
    </div>

    <div class="desktop-chrome desktop-chrome--top" aria-label="Site navigation and promotion">
      <div class="desktop-marquee is-left is-solid" aria-label="GYMFUSION introductory offer marquee">
        <div class="desktop-marquee__track" aria-hidden="true">
          <div class="desktop-marquee__group">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
          </div>
          <div class="desktop-marquee__group" aria-hidden="true">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
          </div>
