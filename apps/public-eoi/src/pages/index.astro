      radial-gradient(circle at 29.015299479166668% 95.16927083333333%, #000000 0%, 17.5%, rgba(0,0,0,0) 35%),
      radial-gradient(circle at 61.865234375% 100%, #000000 0%, 17.5%, rgba(0,0,0,0) 35%),
      radial-gradient(circle at 43.655598958333336% 91.845703125%, #000000 0%, 17.5%, rgba(0,0,0,0) 35%),
      radial-gradient(circle at 6.560872395833334% 97.01171875%, #000000 0%, 17.5%, rgba(0,0,0,0) 35%),
