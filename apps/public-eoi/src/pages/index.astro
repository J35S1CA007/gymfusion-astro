        <div class="desktop-marquee__track" aria-hidden="true">
          <div class="desktop-marquee__group">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
          </div>
          <div class="desktop-marquee__group" aria-hidden="true">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
            <span class="desktop-marquee__text">Intro Offer: 2 visits over 2 weeks • No ongoing commitment • Continue only if you love it! T&amp;Cs apply.</span>
            <img class="desktop-marquee__divider" src="https://static.wixstatic.com/shapes/f190ff_6c507730a3e04f8dab48924ba8e8c8f6.svg" alt="">
          </div>
        </div>
      </div>

      <section class="country-acknowledgement">
        <p>
          <span class="country-acknowledgement__text">
            We respectfully acknowledge the Yorta Yorta Nation as the First Peoples of the land on which we live and<br>
            work. We pay our respects to Elders past, present, and emerging, and honour their continuing culture<br>
            and connection to land and waters.
          </span>
        </p>
      </section>

      <div class="desktop-footer">
        <nav class="desktop-footer__links footer-links" aria-label="Footer links">
          <a href="https://www.gymfusion.com.au/eoi" target="_top">EOI</a>
          <a href="https://www.gymfusion.com.au/our-services" target="_top">Our Services</a>
          <a href="https://www.gymfusion.com.au/privacy-policy" target="_top">Privacy Policy</a>
          <a href="https://www.gymfusion.com.au/accessibility-inclusion-statement" target="_top">Accessibility</a>
          <a href="https://www.gymfusion.com.au/terms-and-conditions" target="_top">T&amp;Cs</a>
          <a href="https://www.gymfusion.com.au/our-policies/" target="_top">Our Policies</a>
        </nav>

        <div class="desktop-footer__identity">
          <img class="desktop-footer__mark" src={spiralLogoSrc} alt="" aria-hidden="true" loading="eager" decoding="async" />
          <strong>GYMFUSION</strong>
          <span><span class="desktop-footer__abbr">ABN</span> 97 143 803 038</span>
          <span>70 New Dookie Rd, Shepparton, VIC, 3629</span>
          <a href="mailto:enquiries@gymfusion.com.au">enquiries@gymfusion.com.au</a>
        </div>

        <p class="desktop-footer__legal">
          Copyright © 2026 GYMFUSION. All rights reserved. Website content, branding, and Expression of Interest materials may not be copied, reproduced, or redistributed without prior written permission.
        </p>
      </div>
    </footer>
  </main>
</Layout>

<script>
  import '../lib/gfPublicMemberNav.js';

  const gfHeader = document.querySelector<HTMLElement>('[data-site-header]');
  const gfMenuButton = document.getElementById('gfMenuButton');
  const gfMenuOverlay = gfHeader?.querySelector<HTMLElement>('[data-desktop-menu-overlay]');
  const gfMenuPanel = gfHeader?.querySelector<HTMLElement>('#desktop-site-menu');
  let isMenuOpen = false;

  function setMenuOpen(nextOpen: boolean) {
    isMenuOpen = nextOpen;
    if (gfHeader) gfHeader.dataset.menuOpen = nextOpen ? 'true' : 'false';
    gfMenuButton?.classList.toggle('is-open', nextOpen);
    gfMenuButton?.setAttribute('aria-expanded', String(nextOpen));
    if (gfMenuOverlay) gfMenuOverlay.hidden = !nextOpen;
    if (gfMenuPanel) gfMenuPanel.hidden = !nextOpen;
  }

  gfMenuButton?.addEventListener('click', () => setMenuOpen(!isMenuOpen));
  gfHeader?.querySelectorAll<HTMLElement>('.site-menu-link').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  gfMenuPanel?.addEventListener('mouseleave', () => setMenuOpen(false));
  document.addEventListener('pointerdown', (event) => {
    if (gfHeader && isMenuOpen && !gfHeader.contains(event.target as Node)) setMenuOpen(false);
  }, true);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });

  const iframe = document.querySelector<HTMLIFrameElement>('[data-eoi-embed]');
  const mobile = window.matchMedia('(max-width: 1023px)').matches;
  if (iframe && !mobile) {
    iframe.src = '/desktop-eoi-part-1.html';
  }
  if (mobile) {
    const mobileScript = document.createElement('script');
    mobileScript.src = '/mobile.js';
    mobileScript.defer = true;
    document.body.appendChild(mobileScript);
  }

</script>

  <style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@400;600;700;800&display=swap');

  @font-face {
    font-family: CASmutFill;
    src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/ca-smut-fill-1782165939-0/CASmut-Fill.otf") format("opentype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "GamuthSans";
    src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Bold.ttf") format("truetype");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "GamuthSansLightMobile";
    src: url("https://raw.githubusercontent.com/J35S1CA007/gymfusion-assets/main/Gamuth%20Font%20Family/mobile/GamuthSans-Light_mobile.ttf") format("truetype");
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "GamuthSansRegularMobile";
    src: url("https://raw.githubusercontent.com/J35S1CA007/gymfusion-assets/main/Gamuth%20Font%20Family/mobile/GamuthSans-Regular_mobile.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :global(body) {
    background:
      radial-gradient(circle at 50% 16%, rgba(157, 10, 255, 0.2), transparent 26%),
      radial-gradient(circle at 82% 68%, rgba(252, 158, 25, 0.12), transparent 22%),
      #000;
  }

  .eoi-landing {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    --cta-gradient: linear-gradient(111deg, rgba(157, 10, 255, 1) 0%, rgba(222, 7, 150, 1) 31%, rgba(253, 29, 29, 1) 68%, rgba(252, 158, 25, 1) 100%);
    background:
      radial-gradient(circle at 50% 12%, rgba(157, 10, 255, 0.24), transparent 28%),
      radial-gradient(circle at 82% 70%, rgba(252, 158, 25, 0.14), transparent 24%),
      #000;
    background-color: #000;
  }

  .top-strip {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    padding: 0 16px;
    flex: none;
    height: 65px;
    min-height: 65px;
    width: 100%;
    background: #000;
    overflow: visible;
  }

  .brand-slot {
    position: static;
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    align-self: center;
    transform: none;
    display: grid;
    place-items: center;
    z-index: 1;
    pointer-events: none;
  }

  .brand-logo {
    display: block;
    width: clamp(34px, 4.4vw, 46px);
    height: auto;
  }

  .nav-slot {
    position: relative;
    grid-column: 3;
    grid-row: 1;
    justify-self: center;
    align-self: center;
    width: 300px;
    height: 65px;
    transform: none;
    display: grid;
    place-items: center;
    z-index: 3;
  }

  .gf-member-nav-host {
    position: absolute;
    top: 10px;
    left: 0;
    width: 300px;
    height: 349px;
    display: block;
    overflow: visible;
  }

  .desktop-chrome {
    display: grid;
    width: 100%;
  }

  .desktop-chrome--top {
    position: relative;
    z-index: 1;
  }

  .desktop-chrome--bottom {
    position: relative;
    z-index: 3;
    margin-top: 0;
    background: #000;
  }

  .desktop-marquee {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    padding: 4px 0;
    position: relative;
    z-index: 1;
  }

  .desktop-marquee.is-solid {
    background: radial-gradient(circle at center, #2e1b4e, #1a0b2e, #05020a);
  }

  .desktop-marquee.is-transparent {
    background: transparent;
  }

  .desktop-marquee__track {
    display: flex;
    width: max-content;
    animation: gymfusionMarquee 52s linear infinite;
    animation-play-state: running !important;
    will-change: transform;
  }

  .desktop-marquee.is-left .desktop-marquee__track {
    animation-direction: normal;
  }

  .desktop-marquee.is-right .desktop-marquee__track {
    animation-direction: reverse;
  }

  .desktop-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .desktop-marquee__text {
    font-family: CASmutFill, Arial, sans-serif;
    font-size: 20px;
    line-height: 1;
    color: #bea9ff;
    letter-spacing: .04em;
    padding: 0 16px;
  }

  .desktop-marquee__divider {
    width: 28px;
    height: auto;
    display: block;
    flex: none;
  }

  .content-shell {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 3rem) 48px;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(circle at 50% 30%, #1f0730 0%, #050308 75%);
  }

  .content-shell::before {
    content: "";
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(circle at 20% 18%, rgba(255, 20, 147, 0.58) 0%, rgba(255, 20, 147, 0) 38%),
      radial-gradient(circle at 80% 24%, rgba(110, 0, 240, 0.6) 0%, rgba(110, 0, 240, 0) 42%),
      radial-gradient(circle at 30% 84%, rgba(255, 110, 0, 0.48) 0%, rgba(230, 80, 0, 0) 40%),
      radial-gradient(circle at 82% 78%, rgba(255, 30, 50, 0.5) 0%, rgba(180, 10, 30, 0) 42%);
    filter: blur(70px);
    opacity: 0.95;
    transform: translate3d(0, 0, 0);
    pointer-events: none;
    z-index: 0;
    animation: contentShellGlow 28s ease-in-out infinite alternate;
  }

  .content-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(5, 3, 8, 0) 35%, rgba(5, 3, 8, 0.8) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .middle-stage {
    position: relative;
    z-index: 1;
    width: min(100%, 1180px);
    height: min(1010px, calc(100svh - 150px));
    padding: 0;
    border: 1px solid transparent;
    border-radius: 34px;
    background:
      linear-gradient(rgba(3, 5, 18, 0.96), rgba(3, 5, 18, 0.96)) padding-box,
      var(--cta-gradient) border-box;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 28px 80px rgba(0, 0, 0, 0.52);
    overflow: hidden;
  }

  .eoi-embed {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
    background: #000;
    box-shadow: none;
  }

  .mobile-form-host {
    display: none;
  }

  @media (max-width: 1023px) {
    :global(html),
    :global(body) {
      width: 100% !important;
      height: auto !important;
      min-width: 0 !important;
      min-height: 100% !important;
      max-width: none !important;
      max-height: none !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      overscroll-behavior-y: auto !important;
      background: #000 !important;
    }

    .content-shell {
      padding: 0.75rem 0.5rem 1rem;
      place-items: center;
      height: calc(100svh - 65px);
      min-height: 0;
    }

    .middle-stage {
      width: min(300px, calc(100vw - 1rem));
      max-width: 300px;
      height: 100%;
      min-height: 0;
      border: 1px solid transparent;
      border-radius: 34px;
      background:
        linear-gradient(rgba(3, 5, 18, 0.96), rgba(3, 5, 18, 0.96)) padding-box,
        var(--cta-gradient) border-box;
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.06) inset,
        0 18px 40px rgba(0, 0, 0, 0.36);
      overflow: hidden;
    }

    .eoi-embed {
      display: none;
    }

    .mobile-form-host {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-height: 0;
      overflow: hidden;
      border-radius: 0;
    }

    :global(.mobile-form-host > div) {
      width: 100%;
      height: 100%;
    }

    :global(.mobile-form-host > div.page) {
      width: 100% !important;
      height: 100% !important;
      min-width: 0 !important;
      min-height: 0 !important;
      max-width: none !important;
      max-height: none !important;
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
      overflow: hidden !important;
    }

    :global(.mobile-form-host > div.page > .deck),
    :global(.mobile-form-host > div.page > .deck[data-deck-state="cover"]) {
      width: 100% !important;
      height: 100% !important;
      min-width: 0 !important;
      min-height: 0 !important;
      max-width: none !important;
      max-height: none !important;
      aspect-ratio: auto !important;
      margin: 0 auto !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      border-radius: inherit !important;
      overflow: hidden !important;
    }

    :global(.mobile-form-host > div.page > .deck > .deck-track) {
      width: calc(var(--slides) * 100%) !important;
      height: 100% !important;
      display: flex !important;
      flex-direction: row !important;
      position: relative !important;
      overflow: hidden !important;
      transform: translate3d(calc(var(--slide-index, 0) * (-100% / var(--slides))), 0, 0) !important;
    }

    :global(.mobile-form-host > div.page > .deck > .deck-track > .deck-page) {
      width: calc(100% / var(--slides)) !important;
      min-width: calc(100% / var(--slides)) !important;
      max-width: calc(100% / var(--slides)) !important;
      flex: 0 0 calc(100% / var(--slides)) !important;
      height: 100% !important;
      min-height: 0 !important;
      max-height: 100% !important;
      position: relative !important;
      overflow: hidden !important;
    }

    :global(.mobile-form-host > div.page > .deck > .deck-track > .deck-page > .content-scroll) {
      height: 100% !important;
      min-height: 0 !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
    }

    :global(.mobile-form-host > div.page > .deck::before) {
      content: none !important;
    }
  }

