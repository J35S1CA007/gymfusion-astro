<script>
  import '../lib/gfPublicMemberNav.js';
  import '../lib/gfPublicMemberNavMobile.js';

  const gfHeader = document.querySelector<HTMLElement>('[data-site-header]');
  const gfMenuButton = document.getElementById('gfMenuButton');
  const gfMenuOverlay = gfHeader?.querySelector<HTMLElement>('[data-desktop-menu-overlay]');
  const gfMenuPanel = gfHeader?.querySelector<HTMLElement>('#desktop-site-menu');
  const gfMobileMenuButton = document.getElementById('gfMobileMenuButton');
  const gfMobileMenuOverlay = document.querySelector<HTMLElement>('[data-mobile-menu-overlay]');
  const gfMobileMenuLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-menu-link]'));
  const gfMobileMemberNav = document.querySelector<HTMLElement>('.gf-member-nav-mobile-host');
  const gfMobileBreakpoint = window.matchMedia('(max-width: 1023px)');
  let isMenuOpen = false;
  let isMobileMenuOpen = false;
  let mobileMenuRevealFrame: number | null = null;
  let mobileMenuRevealTimer: number | null = null;

  function setMenuOpen(nextOpen: boolean) {
    isMenuOpen = nextOpen;
    if (gfHeader) gfHeader.dataset.menuOpen = nextOpen ? 'true' : 'false';
    gfMenuButton?.classList.toggle('is-open', nextOpen);
    gfMenuButton?.setAttribute('aria-expanded', String(nextOpen));
    if (gfMenuOverlay) gfMenuOverlay.hidden = !nextOpen;
    if (gfMenuPanel) gfMenuPanel.hidden = !nextOpen;
  }

  function resetMobileMenuButtons() {
    gfMobileMenuLinks.forEach((button) => {
      button.classList.remove('is-visible');
      button.style.animationDelay = '0ms';
    });
  }

  function playMobileMenuButtons() {
    gfMobileMenuLinks.forEach((button, index) => {
      button.style.animationDelay = `${index * 200}ms`;
      button.classList.add('is-visible');
    });
  }

  function clearMobileMenuReveal() {
    if (mobileMenuRevealFrame !== null) {
      cancelAnimationFrame(mobileMenuRevealFrame);
      mobileMenuRevealFrame = null;
    }

    if (mobileMenuRevealTimer !== null) {
      clearTimeout(mobileMenuRevealTimer);
      mobileMenuRevealTimer = null;
    }
  }

  function setMobileMenuScrollLock(nextOpen: boolean) {
    document.documentElement.classList.toggle('mobile-site-menu-open', nextOpen);
    document.body.classList.toggle('mobile-site-menu-open', nextOpen);
  }

  function closeMobileMemberDropdown() {
    if (!gfMobileMemberNav) {
      return;
    }

    try {
      const rawState = gfMobileMemberNav.getAttribute('member-state');
      const state = rawState ? JSON.parse(rawState) : {};
      gfMobileMemberNav.setAttribute('member-state', JSON.stringify({
        ...state,
        dropdownOpen: false,
      }));
    } catch {
      gfMobileMemberNav.setAttribute('member-state', '{"authenticated":false,"displayName":"","loading":false,"ready":true,"dropdownOpen":false,"notice":""}');
    }
  }

  function setMobileMenuOpen(nextOpen: boolean) {
    const shouldOpen = nextOpen && gfMobileBreakpoint.matches;
    isMobileMenuOpen = shouldOpen;
    if (gfHeader) gfHeader.dataset.mobileMenuOpen = shouldOpen ? 'true' : 'false';
    gfMobileMenuButton?.classList.toggle('is-open', shouldOpen);
    gfMobileMenuButton?.setAttribute('aria-expanded', String(shouldOpen));
    gfMobileMenuButton?.setAttribute('aria-label', shouldOpen ? 'Close navigation' : 'Open navigation');
    if (gfMobileMenuOverlay) {
      gfMobileMenuOverlay.hidden = !shouldOpen;
      gfMobileMenuOverlay.classList.toggle('is-open', shouldOpen);
      gfMobileMenuOverlay.setAttribute('aria-hidden', String(!shouldOpen));
    }

    setMobileMenuScrollLock(shouldOpen);
    clearMobileMenuReveal();

    if (!shouldOpen) {
      resetMobileMenuButtons();
      return;
    }

    closeMobileMemberDropdown();
    resetMobileMenuButtons();
    mobileMenuRevealFrame = requestAnimationFrame(() => {
      mobileMenuRevealTimer = window.setTimeout(() => {
        playMobileMenuButtons();
        mobileMenuRevealTimer = null;
      }, 180);
      mobileMenuRevealFrame = null;
    });
  }

  gfMenuButton?.addEventListener('click', () => setMenuOpen(!isMenuOpen));
  gfHeader?.querySelectorAll<HTMLElement>('.site-menu-link').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  gfMenuPanel?.addEventListener('mouseleave', () => setMenuOpen(false));
  gfMobileMenuButton?.addEventListener('click', () => setMobileMenuOpen(!isMobileMenuOpen));
  gfMobileMenuLinks.forEach((link) => {
    link.addEventListener('click', () => setMobileMenuOpen(false));
  });
  gfMobileMenuOverlay?.addEventListener('click', (event) => {
    if (event.target === gfMobileMenuOverlay) {
      setMobileMenuOpen(false);
    }
  });
  document.addEventListener('pointerdown', (event) => {
    if (gfHeader && isMenuOpen && !gfHeader.contains(event.target as Node)) setMenuOpen(false);
  }, true);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
      setMobileMenuOpen(false);
    }
  });
  const handleMobileBreakpointChange = () => {
    if (!gfMobileBreakpoint.matches) {
      setMobileMenuOpen(false);
    }
  };
  window.addEventListener('resize', handleMobileBreakpointChange);
  document.addEventListener('gf-member-nav-intent', (event) => {
    const host = event.target;
    if (!(host instanceof HTMLElement)) {
      return;
    }

    const detail = (event as CustomEvent<{ action?: string }>).detail;
    const action = detail?.action;
    const loginUrl = host.getAttribute('login-url') || 'https://portal.gymfusion.com.au/login';
    const portalUrl = host.getAttribute('portal-url') || 'https://portal.gymfusion.com.au/members';
    if (action === 'login') {
      window.location.assign(loginUrl);
      return;
    }

    if (action === 'portal') {
      window.location.assign(portalUrl);
      return;
    }

    if (action === 'logout') {
      window.location.assign(loginUrl);
    }
  });

  const iframe = document.querySelector<HTMLIFrameElement>('[data-eoi-embed]');
  const gfEoiLanding = document.querySelector<HTMLElement>('.eoi-landing');
  window.addEventListener('message', (event) => {
    if (!iframe?.contentWindow || event.source !== iframe.contentWindow || event.origin !== window.location.origin) {
      return;
    }

    const message = event.data as { type?: string; motionReduced?: boolean };
    if (message?.type !== 'gf-eoi-accessibility' || typeof message.motionReduced !== 'boolean') {
      return;
    }

    if (gfEoiLanding) {
      gfEoiLanding.dataset.reducedMotion = String(message.motionReduced);
    }
  });
  const mobile = window.matchMedia('(max-width: 1023px)').matches;
  if (iframe && !mobile) {
    iframe.src = '/desktop-eoi-part-1.html';
  }
  if (mobile) {
    const mobileScript = document.createElement('script');
    mobileScript.src = '/mobile.js';
    mobileScript.defer = true;
    document.body.appendChild(mobileScript);
  }

</script>

  <style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@100;300;400;500;600;700;800&display=swap');

  @font-face {
    font-family: CASmutFill;
    src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/ca-smut-fill-1782165939-0/CASmut-Fill.otf") format("opentype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "GamuthSans";
    src: url("https://cdn.jsdelivr.net/gh/J35S1CA007/gymfusion-assets@main/Gamuth%20Font%20Family/GamuthSans-Bold.ttf") format("truetype");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "GamuthSansLightMobile";
    src: url("https://raw.githubusercontent.com/J35S1CA007/gymfusion-assets/main/Gamuth%20Font%20Family/mobile/GamuthSans-Light_mobile.ttf") format("truetype");
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "GamuthSansRegularMobile";
    src: url("https://raw.githubusercontent.com/J35S1CA007/gymfusion-assets/main/Gamuth%20Font%20Family/mobile/GamuthSans-Regular_mobile.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :global(body) {
    background:
      radial-gradient(circle at 50% 16%, rgba(157, 10, 255, 0.2), transparent 26%),
      radial-gradient(circle at 82% 68%, rgba(252, 158, 25, 0.12), transparent 22%),
      #000;
  }

  .eoi-landing {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    --cta-gradient: linear-gradient(111deg, rgba(157, 10, 255, 1) 0%, rgba(222, 7, 150, 1) 31%, rgba(253, 29, 29, 1) 68%, rgba(252, 158, 25, 1) 100%);
    background:
      radial-gradient(circle at 50% 12%, rgba(157, 10, 255, 0.24), transparent 28%),
      radial-gradient(circle at 82% 70%, rgba(252, 158, 25, 0.14), transparent 24%),
      #000;
    background-color: #000;
  }

  .top-strip {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    padding: 0 16px;
    flex: none;
    height: 65px;
    min-height: 65px;
    width: 100%;
    background: #000;
    overflow: visible;
  }

  .brand-slot {
    position: static;
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    align-self: center;
    transform: none;
    display: grid;
    place-items: center;
    z-index: 1;
    pointer-events: none;
  }

  .brand-logo {
    display: block;
    width: clamp(34px, 4.4vw, 46px);
    height: auto;
  }

  .mobile-login-slot,
  .mobile-menu-slot,
  .mobile-menu-overlay {
    display: none;
  }

  .mobile-login-slot {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    align-self: center;
    z-index: 3;
  }

  .mobile-menu-slot {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    align-self: center;
    z-index: 3;
  }

  .gf-member-nav-mobile-host {
    display: block;
    overflow: visible;
  }

  .mobile-navigation-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .mobile-navigation-button:active {
    transform: scale(0.92);
  }

  .mobile-navigation-icon {
    width: 28px;
    height: 28px;
    overflow: visible;
    fill: none;
    stroke: url("#mobile-navigation-icon-gradient");
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mobile-navigation-icon .line {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 160ms ease;
  }

  .mobile-navigation-button.is-open .line-top {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-navigation-button.is-open .line-middle {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-navigation-button.is-open .line-bottom {
